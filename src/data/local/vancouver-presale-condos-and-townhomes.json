  "faq": [
    {
      "q": "How many presale projects are completing in Vancouver between 2027 and 2029?",
      "a": "22 projects are on my list as of November 2026: 14 completing in 2027, 7 completing in 2028, 1 completing in 2029. The list covers projects marketed publicly. Projects sold only through private channels may be missing."
    },
    {
      "q": "What kinds of presale homes are being built in Vancouver?",
      "a": "The mix is 14 condo projects, 4 mixed condo and townhome projects, 4 townhome projects."
    },
    {
      "q": "What do strata fees cover on a condo in Vancouver Presale?",
      "a": "Strata fees pay for upkeep and insurance of the common property and the contingency reserve fund, and in some buildings heat, hot water or other services. The Form B Information Certificate lists exactly what a unit's fee covers.",
      "gen": "bank-faq"
    },
    {
      "q": "What should I read before buying a condo in Vancouver Presale?",
      "a": "The Form B, the bylaws, the last two years of strata minutes, the depreciation report and the contingency reserve fund balance. They show planned repairs, special levies and rules on pets and rentals.",
      "gen": "bank-faq"
    }
