  "faq": [
    {
      "q": "Where is Riverdale in Richmond?",
      "a": "In north-west Richmond's Thompson area — the Riverdale Drive pocket west of No. 2 Road and south of Westminster Highway; the City locates McCallan Neighbourhood Park, 6360 Coltsfoot Drive, \"off Riverdale Drive and Larkspur Avenue\" in that pocket.",
      "gen": "muse"
    },
    {
      "q": "Is Riverdale an official City of Richmond neighbourhood name?",
      "a": "No City OCP area or sub-area plan by that name was confirmed — the City plans and serves this ground as part of Thompson; \"Riverdale RI\" is the board-style sub-area name used for this page, and no official boundary for it is published.",
      "gen": "muse"
    },
    {
      "q": "Is there a Riverdale Elementary School in Richmond?",
      "a": "No SD38 school by that name in Richmond was confirmed; Riverdale Elementary is in Surrey under Surrey Schools (SD36), so Richmond families should check the SD38 locator for their exact address.",
      "gen": "muse"
    },
    {
      "q": "What recreation serves the Riverdale pocket?",
      "a": "McCallan Neighbourhood Park (3.514 acres; sports field, basketball half-court, playground, off-leash area) inside the pocket, the McCallan Road Trail connecting to the West Dyke and Middle Arm Dyke Trails, and Thompson Community Centre at 5151 Granville Avenue.",
      "gen": "muse"
    }
  ]
