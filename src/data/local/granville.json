  "faq": [
    {
      "q": "Does the site's \"Granville\" area mean downtown Granville Street?",
      "a": "No — for this page the ground is South Granville, the west-side corridor from the Granville Bridge to West 16th Avenue; the City lists \"South Granville\" as a recognised smaller area and places its Gallery Row shopping district inside Fairview.",
      "gen": "muse"
    },
    {
      "q": "Is South Granville part of the Broadway Plan?",
      "a": "Yes — the Broadway Plan covers Clark Drive to Vine Street and 1st to 16th Avenues and was approved June 22, 2022; it provides for a South Granville Station area with buildings up to 30–40 storeys near the station.",
      "gen": "muse"
    },
    {
      "q": "When does the Broadway Subway reach South Granville?",
      "a": "The 5.7 km Millennium Line extension, with six underground stations including South Granville Station, is scheduled to enter service in fall 2027.",
      "gen": "muse"
    },
    {
      "q": "Can a side-street house lot be redeveloped as a multiplex?",
      "a": "Generally yes where the R1-1 schedule is met — By-law No. 13817 allows up to 6 strata units (or 8 secured rental units) on former single-family lots, subject to the district schedule; heritage-designated properties carry additional rules.",
      "gen": "muse"
    },
    {
      "q": "What is the corridor's landmark?",
      "a": "The Stanley Theatre, 2750 Granville Street at West 12th Avenue — a 650-seat venue in a 1931 art deco building whose restoration received a 1999 City of Vancouver Heritage Award.",
      "gen": "muse"
    }
  ]
