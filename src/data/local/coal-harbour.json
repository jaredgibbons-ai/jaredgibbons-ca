  "faq": [
    {
      "q": "Is Coal Harbour an official City of Vancouver local area?",
      "a": "No — Downtown is the official local area, one of the City's 22 distinct areas, and Coal Harbour is a neighbourhood inside it with its own Official Development Plan; \"Coal Harbour\" is the Paragon sub-area name.",
      "gen": "muse"
    },
    {
      "q": "What plan governs Coal Harbour?",
      "a": "The Coal Harbour Official Development Plan (By-law 6754), covering the continuous waterfront walkway, public open space connections from the downtown core to the shoreline, and street-end views to the water and mountains at Burrard, Thurlow, Bute, Jervis, Broughton, Nicola and Cardero Streets.",
      "gen": "muse"
    },
    {
      "q": "Which recreation facilities are in Coal Harbour?",
      "a": "Coal Harbour Community Centre, 480 Broughton Street, with multi-purpose rooms and a gymnasium, plus Harbour Green Park on the waterfront and Devonian Harbour Park, 1929 West Georgia Street, at the Stanley Park gateway.",
      "gen": "muse"
    },
    {
      "q": "What zoning applies in Coal Harbour?",
      "a": "The Downtown District (DD) Schedule in By-law 3575, applied together with the Coal Harbour Official Development Plan — the DD schedule permits commercial, residential, institutional and light industrial uses, parks and open spaces, and public uses in conformity with an Official Development Plan.",
      "gen": "muse"
    }
  ]
