  "faq": [
    {
      "q": "Is Fraserview VE in Vancouver or New Westminster?",
      "a": "Vancouver — this file covers the Fraserview district on Vancouver's south slope, inside the Victoria-Fraserview local area between the Knight Street Bridge corridor and Killarney. New Westminster has a separate sub-area also named Fraserview; the two are different places in different municipalities.",
      "gen": "muse"
    },
    {
      "q": "What is Fraserview known for?",
      "a": "The municipal Fraserview Golf Course lands at its centre and its south-slope position above the Fraser River, inside a local area the City calls a destination for fresh produce, sarees, fabrics, imported goods and international cuisine.",
      "gen": "muse"
    },
    {
      "q": "Which library branches serve Fraserview?",
      "a": "The Fraserview Branch and the South Hill Branch of Vancouver Public Library are the branches the City lists for the Victoria-Fraserview local area.",
      "gen": "muse"
    },
    {
      "q": "Is the Fraser River floodplain a factor in Fraserview?",
      "a": "At the lowest streets, yes — the City's designated floodplain includes the Fraser River coastal floodplain in South Vancouver, with by-law setback and flood construction level requirements for parcels in it; a specific parcel's status must be checked in the City dataset.",
      "gen": "muse"
    }
  ]
