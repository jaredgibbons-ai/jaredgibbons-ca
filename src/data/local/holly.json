  "faq": [
    {
      "q": "Which elementary school is in Holly?",
      "a": "Holly Elementary (K–7), at 4625 62 St, Delta, on the BC Ministry of Education's SD37 school list. Whether a specific Holly address is in its catchment must be checked in the SD37 locator — catchments are address-based.",
      "gen": "muse"
    },
    {
      "q": "Is Holly an official City of Delta planning area?",
      "a": "This file does not treat it as one. Holly is the MLS sub-area name on the live page; the governing plan is the Delta Official Community Plan 2024, Bylaw No. 8400 — a single consolidated plan with land-use designations in its Land Use Plan (s. 1.5) and no area-plan schedule for this part of Ladner.",
      "gen": "muse"
    },
    {
      "q": "How do Holly residents reach the Canada Line?",
      "a": "By TransLink route 601 from Ladner Exchange to Bridgeport Station, via Ladner Trunk Road, Highway 17A and Highway 99.",
      "gen": "muse"
    },
    {
      "q": "Can Jared show me homes in Holly?",
      "a": "Yes. Jared Gibbons, REALTOR® with Royal LePage Little Oak Realty, books private showings across the Fraser Valley and Metro Vancouver. Call or text 604-928-1361, or use the contact form on this site.",
      "gen": "muse-generic"
    }
