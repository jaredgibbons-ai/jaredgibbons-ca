  "faq": [
    {
      "q": "What is the official name of this area?",
      "a": "Grandview-Woodland, with a hyphen — the City of Vancouver lists it among its 22 distinct local areas, centred on Commercial Drive and East Hastings Street.",
      "gen": "muse"
    },
    {
      "q": "Which schools are located in Grandview-Woodland?",
      "a": "Three VSB elementaries — Lord Nelson (1355 Garden Drive), χpey̓ (1950 East Hastings Street) and Britannia (1110 Cotton Drive) — and Britannia Secondary, 1001 Cotton Drive; catchments are address-based, so check the exact address in the VSB locator.",
      "gen": "muse"
    },
    {
      "q": "What is Britannia?",
      "a": "The Britannia Community Services Centre site inside the area — library branch, elementary school, skating rink, fitness facility and swimming pool — which the City and its partners are renewing through the Britannia Renewal project.",
      "gen": "muse"
    },
    {
      "q": "How is the area served by transit?",
      "a": "The R5 Hastings St RapidBus runs from Burrard Station to SFU with a stop at Hastings and Commercial, route 20 runs on Commercial Drive itself, and Commercial-Broadway Station at the south-west edge provides Expo and Millennium Line service.",
      "gen": "muse"
    },
    {
      "q": "What community plan applies?",
      "a": "The Grandview-Woodland Community Plan, with the citywide Vancouver Plan over it; the plan's study area runs from Clark Drive to Kamloops Street and from East 12th Avenue / Grandview Highway to Burrard Inlet.",
      "gen": "muse"
    }
  ]
