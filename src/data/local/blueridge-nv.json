  "faq": [
    {
      "q": "Which municipality is Blueridge in?",
      "a": "The District of North Vancouver, in the District's Seymour community east of the Seymour River; the Seymour Local Plan protects Blueridge's predominantly single-family character.",
      "gen": "muse"
    },
    {
      "q": "Which schools are in Blueridge?",
      "a": "Blueridge Elementary (2650 Bronte Drive) and Seymour Heights Elementary (2640 Carnation Street) are in the pocket, with Windsor Secondary (931 Broadview Drive) the Seymour secondary school beside it; SD44 has no middle tier and catchments are address-based — check the exact address with SD44.",
      "gen": "muse"
    },
    {
      "q": "What bus serves Blueridge?",
      "a": "Route 214 runs from Sechelt Drive at Hyannis Drive via Berkley Road, Carnation Street and Mount Seymour Parkway to Phibbs Exchange, with some trips continuing to Burrard Station.",
      "gen": "muse"
    },
    {
      "q": "What hazard check matters most on the Berkley side?",
      "a": "Landslide. District work names the Berkley escarpment for landslide risk, and District Schedule B sets slope, creek, streamside and wildfire hazard permit areas — a lot on or near the escarpment or a creek may need a development permit and a professional report.",
      "gen": "muse"
    },
    {
      "q": "Can a Blueridge house lot hold a suite or a coach house?",
      "a": "Yes. Under District Zoning Bylaw 3210, Section 525, an R2 lot allows a principal dwelling plus a secondary suite and a coach house — three units total since June 2024 within the Urban Containment Boundary — and provincial SSMUH rules also apply by lot size and bus-stop distance.",
      "gen": "muse"
    }
  ]
}
