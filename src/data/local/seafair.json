  "faq": [
    {
      "q": "Which schools serve a Seafair address?",
      "a": "For the sample address 9200 No. 1 Road, the SD38 locator gives Diefenbaker Elementary and Boyd Secondary — Hugh Boyd Secondary School itself is at 9200 No. 1 Road; catchments are address-based and SD38 has no middle tier, so check the exact address.",
      "gen": "muse"
    },
    {
      "q": "What transit serves Seafair?",
      "a": "TransLink route 401 runs on No. 1 Road through Seafair between Richmond–Brighouse Station and Steveston Exchange, stopping beside Hugh Boyd Park and Hugh Boyd Secondary School; there is no SkyTrain station in the area.",
      "gen": "muse"
    },
    {
      "q": "What is the flood position in Seafair?",
      "a": "Richmond is a low-lying island city in the Fraser River floodplain, protected by a perimeter dike system with drainage pump stations including the west dike beside Seafair, designed for a 1:500 flood event with dike raising from 3.5 metres to 4.7 metres under way.",
      "gen": "muse"
    },
    {
      "q": "What recreation is in Seafair?",
      "a": "Hugh Boyd Community Park (pitch and putt, artificial turf fields, tennis courts, playground) with West Richmond Community Centre on site, plus the West Dyke Trail along the west dike from Terra Nova Rural Park to Garry Point Park.",
      "gen": "muse"
    }
  ]
