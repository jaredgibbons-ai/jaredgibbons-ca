  "faq": [
    {
      "q": "How many schools are in Surrey, BC?",
      "a": "The BC Ministry of Education and Child Care list shows 168 schools with a Surrey street address: 137 public schools and 31 independent schools. The count includes alternate programs and online schools that have a street address."
    },
    {
      "q": "Which school district covers Surrey?",
      "a": "Public schools with a Surrey address are run by School District 36 (Surrey) and School District 93 (Conseil scolaire francophone)."
    },
    {
      "q": "How do I find which school a home is zoned for?",
      "a": "Ask the school district to confirm the catchment school for the exact street address. Catchments change, and living near a school does not guarantee a place at it."
    }
  ]
