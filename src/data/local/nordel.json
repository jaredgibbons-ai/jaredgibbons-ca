  "faq": [
    {
      "q": "What is the Nordel Social Heart?",
      "a": "It is the ND12 development permit area in Delta's 2024 OCP, centred on 84 Avenue and 112 Street, whose stated purpose is to revitalize Nordel as the community focus for North Delta; the library, recreation centre and community park all sit in that core.",
      "gen": "muse"
    },
    {
      "q": "Which buses serve Nordel?",
      "a": "Route 312 on 112 Street and route 391 on 116 Street, both between Scottsdale Exchange and Scott Road Station (Expo Line), with stops at Nordel Way.",
      "gen": "muse"
    },
    {
      "q": "What natural area borders Nordel?",
      "a": "The Delta Nature Reserve, the publicly accessible part of Burns Bog, accessed at 10388 Nordel Court; Burns Bog is protected as an Ecological Conservancy Area.",
      "gen": "muse"
    },
    {
      "q": "How many homes are for sale in Nordel?",
      "a": "At the end of October 2026 the Fraser Valley Real Estate Board figures showed 57 houses listed with 10 sold in the month and 16 condos and townhomes listed with 2 sold in the month in Nordel. Those are month-end counts and move daily; ask Jared what is on the market today.",
      "gen": "snap-faq"
    },
    {
      "q": "Is Nordel a buyers’ or sellers’ market?",
      "a": "In October 2026, houses had a sales ratio of 18%, a balanced market; condos and townhomes had a sales ratio of 13%, a balanced market. On the reports’ scale under 12% favours buyers, 12% to 20% is balanced and over 20% favours sellers.",
      "gen": "snap-faq"
    }
