  "faq": [
    {
      "q": "Which municipality is Chelsea Park in?",
      "a": "The District of West Vancouver, at the south edge of the British Properties; District-wide land use is guided by the Official Community Plan, Bylaw No. 4985, 2018.",
      "gen": "muse"
    },
    {
      "q": "Which public schools are beside Chelsea Park?",
      "a": "SD45 describes Westcot Elementary (K–7) as situated at the foot of the British Properties, and Irwin Park Elementary (K–7), 2455 Haywood Avenue, as situated in Dundarave; no SD45 school physically inside Chelsea Park is confirmed.",
      "gen": "muse"
    },
    {
      "q": "What buses serve the Chelsea Park area?",
      "a": "The 256 community shuttle runs via Skilift Road, Folkestone Way and Chippendale Road between Westhill and Park Royal, at the west edge of the area, and route 251 runs on Queens Avenue below the area between Marine Drive at 25th Street and Park Royal.",
      "gen": "muse"
    },
    {
      "q": "What park is in Chelsea Park?",
      "a": "Chairlift Park, on the Chelsea Close streets, listed in the District Parks Master Plan as RS7 and Dedicated.",
      "gen": "muse"
    }
  ]
