  "faq": [
    {
      "q": "Is Fraser an official City of Vancouver neighbourhood?",
      "a": "Not one of the 22 distinct local areas — the City's areas page lists a smaller area named Fraser, and the Fraser Street corridor runs through four official local areas: Kensington-Cedar Cottage, Riley Park, Sunset and Victoria-Fraserview; \"Fraser VE\" is the board / site name for the Vancouver East sub-area.",
      "gen": "muse"
    },
    {
      "q": "Which bus runs the length of Fraser Street?",
      "a": "Route 8 Fraser, between Waterfront Station and SE Marine Drive via Fraser Street, Broadway, Kingsway, Main Street and Hastings Street, ending beside Marine Drive Station; the N8 is the night service on the same corridor.",
      "gen": "muse"
    },
    {
      "q": "Which schools are near the corridor?",
      "a": "John Oliver Secondary, 530 East 41st Avenue, is on the corridor, and the VSB directory lists McBride, Mackenzie, Henderson, Moberly and Trudeau elementaries in the adjoining local areas — but catchments are address-based, so check the exact address in the VSB locator.",
      "gen": "muse"
    },
    {
      "q": "When are Vancouver property taxes due in 2026?",
      "a": "Advance taxes February 3, 2026 and main taxes July 3, 2026, with a 5% penalty on the unpaid balance after each date; the home owner grant was also due July 3, 2026.",
      "gen": "muse"
    }
  ]
