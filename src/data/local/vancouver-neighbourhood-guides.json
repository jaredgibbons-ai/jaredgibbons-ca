 "faq": [
  {
   "q": "How many neighbourhoods does Vancouver have?",
   "a": "The MLS® splits Vancouver into 41 sub-areas: Arbutus, Cambie, Coal Harbour, Downtown, Dunbar, Fairview and 35 more. 41 have a page on this site.",
   "gen": "gvr"
  },
  {
   "q": "Which Vancouver neighbourhood sold the most homes?",
   "a": "Downtown had the most closed sales, 467 between November 1, 2025 to October 22, 2026, followed by Kitsilano (425) and Yaletown (335).",
   "gen": "gvr"
  },
  {
   "q": "Where are Vancouver houses the most and least expensive?",
   "a": "Among areas with 10 or more house sales, the median was highest in Shaughnessy at $4,817,500 and lowest in Collingwood at $1,510,000, for sales November 1, 2025 to October 22, 2026.",
   "gen": "gvr"
  },
  {
   "q": "Which Vancouver neighbourhoods are best value for a condo?",
   "a": "Median condo prices ran from $520,000 in Collingwood to $1,228,000 in Coal Harbour among areas with 10 or more condo sales. Price is one measure only; compare strata fees, age and building condition too.",
   "gen": "gvr"
  },
  {
   "q": "Do I need a home inspection when buying in Vancouver?",
