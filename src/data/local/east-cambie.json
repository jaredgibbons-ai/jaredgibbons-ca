  "faq": [
    {
      "q": "Which schools are in East Cambie?",
      "a": "Mitchell Elementary at 3800 No. 5 Road, Kathleen McNeely Elementary at 12440 Woodhead Road and H.J. Cambie Secondary at 4151 Jacombs Road are physically in the area; for the sample address used (11671 Cambie Road), the SD38 locator gives Mitchell Elementary and Cambie Secondary — catchments for other addresses must be checked in the locator.",
      "gen": "muse"
    },
    {
      "q": "Are suites and added units allowed on single detached lots here?",
      "a": "The RS1/RS2 zone lists a secondary suite as a secondary use, and the City states it allows at least one secondary suite and/or accessory dwelling unit per lot, with Bill 44 small-scale multi-unit minimums of 3 units on lots of 280 m² or less and 4 units on larger lots.",
      "gen": "muse"
    },
    {
      "q": "Does the Agricultural Land Reserve touch East Cambie?",
      "a": "Yes — the Area Plan states the planning area abuts the ALR along No. 6 Road and Westminster Highway, and the Richmond Nature Park is within the ALR.",
      "gen": "muse"
    }
  ]
