 "faq": [
  {
   "q": "How many neighbourhoods does Burnaby have?",
   "a": "The MLS® splits Burnaby into 35 sub-areas: Brentwood Park, Capitol Hill, Cariboo, Central Burnaby, Forest Hills, Government Road and 29 more. 35 have a page on this site.",
   "gen": "gvr"
  },
  {
   "q": "Which Burnaby neighbourhood sold the most homes?",
   "a": "Brentwood Park had the most closed sales, 528 between November 1, 2025 to October 22, 2026, followed by Metrotown (468) and Highgate (140).",
   "gen": "gvr"
  },
  {
   "q": "Where are Burnaby houses the most and least expensive?",
   "a": "Among areas with 10 or more house sales, the median was highest in Government Road at $2,380,000 and lowest in Highgate at $1,500,000, for sales November 1, 2025 to October 22, 2026.",
   "gen": "gvr"
  },
  {
   "q": "Which Burnaby neighbourhoods are best value for a condo?",
   "a": "Median condo prices ran from $440,900 in Cariboo to $693,750 in Brentwood Park among areas with 10 or more condo sales. Price is one measure only; compare strata fees, age and building condition too.",
   "gen": "gvr"
  },
  {
   "q": "Do I need a home inspection when buying in Burnaby?",
   "a": "It is strongly recommended. Make the offer subject to an inspection so a qualified inspector can look at the roof, structure, drainage, electrical and heating before you remove conditions.",
   "gen": "bank-faq"
  }
 ],
