 "blocks": [
  {
   "t": "notice",
   "text": "Draft for Jared's approval. Collected word for word from the city-wide rules paragraphs of the neighbourhood guides listed at the bottom (D-202); nothing new was added. Each guide keeps what is specific to it and links here.",
   "gen": "cityrules"
  },
  {
   "t": "p",
   "text": "The rules below apply across Maple Ridge, not just one neighbourhood: zoning and small-scale housing, strata rules, servicing, land rules and taxes, grouped by topic. Each neighbourhood guide keeps what is specific to that area and links back here. Rules change, so confirm anything that matters for a purchase with the City and your lawyer before you remove subjects.",
   "gen": "cityrules"
  },
  {
   "t": "h",
   "level": 2,
   "text": "Property taxes, transfer tax and GST in Maple Ridge",
   "id": "taxes",
   "gen": "cityrules"
  },
  {
   "items": [
    [
     {
      "t": "Property taxes — City of Maple Ridge: 2026 property taxes were due July 2, 2026; a 5% penalty applies to any outstanding balance on July 3, 2026 and an additional 5% on September 2, 2026."
     }
    ]
   ],
   "t": "list",
   "gen": "cityrules-item",
   "topic": "taxes"
  },
  {
   "t": "h",
   "level": 2,
   "text": "Floodplain, farmland and environmental rules in Maple Ridge",
   "id": "flood",
   "gen": "cityrules"
  },
  {
   "items": [
    [
     {
      "t": "Secondary suites (Maple Ridge's own rule, never borrowed): One secondary suite per lot inside the single detached building, maximum 40% of gross floor area, not within the floodplain area."
     }
    ]
   ],
   "t": "list",
   "gen": "cityrules-item",
   "topic": "flood"
  },
  {
   "t": "h",
   "level": 2,
   "text": "Zoning, suites and small-scale housing in Maple Ridge",
   "id": "zoning",
   "gen": "cityrules"
  },
  {
   "items": [
    [
     {
      "t": "Plan and zoning (Maple Ridge): Zoning Bylaw No. 7600-2019 governs. Urban-fringe houses sit under RS-1 (Single Detached Residential), s.605 — minimum lot area 668.0 m², minimum lot width 18.0 m, minimum lot depth 27.0 m, maximum lot coverage 40%; the rural and agricultural zones carry much larger minimums in the same bylaw's schedule — A-1 2.0 ha, A-2 4.0 ha, A-3 8.0 ha, RS-2 0.4 ha, RS-3 0.8 ha or 2.0 ha depending on the zone text."
     }
    ]
   ],
   "t": "list",
   "gen": "cityrules-item",
   "topic": "zoning"
  },
  {
   "items": [
    [
     {
      "t": "SSMUH (Maple Ridge's own position): Eligible single-detached and duplex lots may have up to three, four or six units under the City's SSMUH bylaws, subject to eligibility and servicing — duplexes are the baseline form where it applies."
     }
    ]
   ],
   "t": "list",
   "gen": "cityrules-item",
   "topic": "zoning"
  },
  {
   "items": [
    [
     {
      "t": "City zoning: A specific parcel's zone is confirmed with the City per parcel."
     }
    ]
   ],
   "t": "list",
   "gen": "cityrules-item",
   "topic": "zoning"
  },
  {
   "t": "h",
   "level": 2,
   "text": "Water, sewer and servicing in Maple Ridge",
   "id": "servicing",
   "gen": "cityrules"
  },
  {
   "items": [
    [
     {
      "t": "Planned transit — price on today's service: TransLink's Langley–Haney Place BRT is in detailed planning — 22 km between Willowbrook and Haney Place with peak service every 10 minutes; designs, costs and timelines are not yet determined."
     }
    ]
   ],
   "t": "list",
   "gen": "cityrules-item",
   "topic": "servicing"
  },
