  "faq": [
    {
      "q": "Which municipality is Altamont in?",
      "a": "The District of West Vancouver; District-wide land use is guided by the Official Community Plan, Bylaw No. 4985, 2018.",
      "gen": "muse"
    },
    {
      "q": "How do I find the catchment school for an Altamont address?",
      "a": "West Vancouver Schools (SD45) directs families to the school locator tool on its admissions page; catchments are address-based, and no Altamont catchment is confirmed here — check the exact address in the locator. SD45 has no middle schools: elementary is K–7 and secondary is 8–12.",
      "gen": "muse"
    },
    {
      "q": "Which buses serve the Altamont area?",
      "a": "Route 251 (Queens / Park Royal) on Queens Avenue below the hillside, and route 250 on Marine Drive between Horseshoe Bay, Dundarave, Park Royal and downtown Vancouver via the Lions Gate Bridge.",
      "gen": "muse"
    },
    {
      "q": "What zoning covers houses in Altamont?",
      "a": "The RS single-family dwelling zones in Section 200 of Zoning Bylaw No. 4662, 2010, with minimum site areas from 488 m² (RS5) to 8,094 m² (RS1), and secondary suites and detached secondary suites among the permitted uses.",
      "gen": "muse"
    },
    {
      "q": "Are there hazard rules that can affect an Altamont lot?",
      "a": "Yes. The District requires a Wildfire Hazard Development Permit for work within 100 metres of an undisturbed forest interface and an Environmental Development Permit for work within 15 metres of the top of a watercourse bank.",
      "gen": "muse"
    }
  ]
