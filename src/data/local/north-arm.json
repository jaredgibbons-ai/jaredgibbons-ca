  "faq": [
    {
      "q": "What is North Arm in New Westminster?",
      "a": "On the board taxonomy it is a GVR MLS® sub-area named for the North Arm of the Fraser River — the river's northern branch and its foreshore along the south side of mainland New Westminster, carrying the Waterfront Esplanade (North Arm) trail named in the City's OCP Green Zone. The City does not list North Arm among its OCP residential neighbourhoods.",
      "gen": "muse"
    },
    {
      "q": "Is there a SkyTrain station in North Arm?",
      "a": "No; 22nd Street Station and New Westminster Station, both on the Expo Line, are the nearest, and TransLink route 100 serves the Marine Way corridor above the foreshore.",
      "gen": "muse"
    },
    {
      "q": "Which bridge crosses the North Arm here?",
      "a": "The Queensborough Bridge, carrying Highway 91A over the North Arm of the Fraser River between mainland New Westminster and Queensborough.",
      "gen": "muse"
    }
