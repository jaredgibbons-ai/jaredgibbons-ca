 "faq": [
  {
   "q": "How fast does Jared reply?",
   "a": "The same day, often within a couple of hours during business hours. A call or text is fastest; email is a little slower."
  },
  {
   "q": "Can I text instead of calling?",
   "a": "Yes. Text or WhatsApp 604-928-1361 any time. Include the address or area you are asking about."
  },
  {
   "q": "What if I am buying or selling outside the Fraser Valley?",
   "a": "Jared can introduce you to an agent he trusts in that area, so you are not starting from a cold search."
  }
