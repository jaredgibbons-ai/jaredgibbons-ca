  "faq": [
    {
      "q": "Is Calverhall in the City or the District of North Vancouver?",
      "a": "The City of North Vancouver. The City's Integrated Stormwater Management Plan names \"the Calverhall – Cloverly neighbourhoods\" as City neighbourhoods, and City zoning (Bylaw No. 6700) and City tax rates apply — not the District's.",
      "gen": "muse"
    },
    {
      "q": "What buses serve Calverhall?",
      "a": "Route 232 runs via Brooksbank Avenue and Keith Road between Grouse Mountain and Phibbs Exchange, and route 255 runs via Grand Boulevard East and Keith Road toward Capilano University.",
      "gen": "muse"
    },
    {
      "q": "How many units can a Calverhall house lot hold?",
      "a": "Under the City's GO Zone (adopted December 8, 2025): up to 3 units on a lot of 280 m² or less, up to 4 units on a larger lot in Low Rise Neighbourhood 1, and up to 6 units in Low Rise Neighbourhood 2 or Residential Level 4 designations; a secondary suite may also combine with a coach house where the lot qualifies.",
      "gen": "muse"
    },
    {
      "q": "What were City of North Vancouver property taxes for 2026?",
      "a": "Taxes were due July 2, 2026; the residential municipal-general rate is 1.89202 and the total residential rate is 3.34028 per $1,000 of assessed value, plus a separate storm drainage rate of 0.10697 per $1,000.",
      "gen": "muse"
    }
  ]
