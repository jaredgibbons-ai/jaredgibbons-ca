  "blocks": [
    {
      "gen": "uq",
      "level": 2,
      "pos": "end",
      "t": "h",
      "text": "Ladner Houses: streets and boundaries"
    },
    {
      "gen": "uq",
      "items": [
        [
          {
            "t": "Ladner is one of Delta's three communities, on the Fraser River's south bank; Ladner and Tsawwassen together are South Delta."
          }
        ],
        [
          {
            "t": "Ladner Village, the historic core, sits west of Chilukthan Slough."
          }
        ]
      ],
      "pos": "end",
      "t": "list"
    },
    {
      "gen": "uq",
      "level": 2,
      "pos": "end",
      "t": "h",
      "text": "Ladner Houses: the housing stock"
    },
    {
      "gen": "uq",
      "items": [
        [
          {
            "t": "Detached zones set minimum subdivision lot areas from 335 square metres (m²) in RS7 to 550 m² in RS5."
          }
        ],
        [
          {
            "t": "Duplex zones need more land: RD1 requires 836 m², RD4 requires 504 m²."
          }
        ]
      ],
      "pos": "end",
      "t": "list"
    },
    {
      "gen": "uq",
      "level": 2,
      "pos": "end",
      "t": "h",
      "text": "Ladner Houses: rules that affect buyers"
    },
    {
      "gen": "uq",
      "items": [
        [
          {
            "t": "Ladner Village is in the Fraser River floodplain behind dikes, so building work must address flood risk despite the dikes."
          }
        ]
      ],
      "pos": "end",
      "t": "list"
    },
    {
      "gen": "uq",
      "level": 2,
      "pos": "end",
      "t": "h",
      "text": "Ladner Houses: local details a buyer would not know"
    },
    {
      "gen": "uq",
      "items": [
        [
          {
            "t": "Delta Hospital, 5800 Mountain View Boulevard, gives Ladner a 24/7 emergency department."
          }
        ],
        [
          {
            "t": "Ladner Elementary is dual-track English and French Immersion, Kindergarten to Grade 7."
          }
        ],
        [
          {
            "t": "Hawthorne Park is at 5151 56 Street."
          }
        ],
        [
          {
            "t": "Ladner Leisure Centre, 4600 Clarence Taylor Crescent, is Ladner's main indoor recreation facility."
          }
        ]
      ],
      "pos": "end",
      "t": "list"
    },
    {
      "gen": "uq",
      "level": 2,
      "pos": "end",
      "t": "h",
      "text": "Ladner Houses: development and new projects"
    },
    {
      "gen": "uq",
      "items": [
        [
          {
            "t": "6073 44A Avenue: Bylaw No. 8373 would split a 1,726 m² lot into three single detached lots, flood-proofing covenant required. STATUS: readings stage, January 2024 (check current)."
          }
        ],
        [
          {
            "t": "Ladner Village Revitalization includes the Chisholm Street Wharf; feedback on Chisholm Street Upgrades was sought in February 2026. STATUS: engagement summarized, read 2026-11-03."
          }
        ]
      ],
      "pos": "end",
      "t": "list"
    },
    {
      "gen": "uq",
      "level": 2,
      "pos": "end",
      "t": "h",
      "text": "Ladner Houses: costs and taxes"
    },
    {
      "gen": "uq",
      "items": [
        [
          {
            "t": "Heritage houses: the Heritage Conservation Fund policy (November 2025) ties help to the heritage levy in Bylaw No. 8386, 2024, and heritage work must follow Schedule 7493-1 of Bylaw No. 7493, 2017."
          }
        ]
      ],
      "pos": "end",
      "t": "list"
    },
    {
      "gen": "uq",
      "level": 2,
      "pos": "end",
      "t": "h",
      "text": "Ladner Houses: getting around"
    },
    {
      "gen": "uq",
      "items": [
        [
          {
            "t": "Route 601 is Ladner's main bus: South Delta to Bridgeport Station (Canada Line), stopping at Ladner Exchange, via Ladner Trunk Road, Highway 17A and Highway 99."
          }
        ]
      ],
      "pos": "end",
      "t": "list"
    },
