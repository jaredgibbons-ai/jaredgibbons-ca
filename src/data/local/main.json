  "faq": [
    {
      "q": "Is \"Main\" an official City of Vancouver neighbourhood?",
      "a": "Not one of the 22 distinct local areas — the City lists \"Main\" as a recognised smaller area; the Main Street corridor runs through the Mount Pleasant, Riley Park and Sunset local areas, and Main Street is also the line that splits the board's Mount Pleasant VE and VW sub-areas.",
      "gen": "muse"
    },
    {
      "q": "Where is the Main Street SkyTrain station, and when does it open?",
      "a": "Mount Pleasant Station, at Main Street and Broadway, is one of six underground stations on the 5.7 km Broadway Subway, scheduled to enter service in fall 2027.",
      "gen": "muse"
    },
    {
      "q": "What anchors the corridor for daily life?",
      "a": "At the north end, the Mount Pleasant Community Centre and library at 1 Kingsway where Kingsway meets Main, and at the south end the Sunset Community Centre on Main Street near East 49th Avenue.",
      "gen": "muse"
    },
    {
      "q": "Can a Main corridor side-street lot hold more than one home?",
      "a": "Yes, where the R1-1 schedule is met — a house may include a secondary suite and a laneway house, and a multiplex may have up to 6 units or up to 8 rental units, with minimum site areas from 306 m² to 557 m² by form; Main Street frontage parcels sit under commercial / mixed-use districts instead.",
      "gen": "muse"
    }
  ]
