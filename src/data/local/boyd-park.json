  "faq": [
    {
      "q": "Is Boyd Park an official Richmond neighbourhood?",
      "a": "No — the City's own area list uses Seafair and West Richmond here; \"Boyd Park\" on this page means the neighbourhood around Hugh Boyd Community Park at No. 1 Road and Francis Road, and no City boundary for a Boyd Park neighbourhood is published.",
      "gen": "muse"
    },
    {
      "q": "What is in Hugh Boyd Community Park?",
      "a": "A pitch and putt course, artificial turf fields, turf sports fields, basketball courts, tennis courts, a playground and paved walking paths — with West Richmond Community Centre (fitness centre, gymnasium, squash and badminton courts) on the same site.",
      "gen": "muse"
    },
    {
      "q": "What zoning and suite rules apply to houses near the park?",
      "a": "Houses sit in Richmond Zoning Bylaw 8500 Single Detached RS1 and RS2 zones, with minimum lot sizes by subzone in Section 8.1.8 and secondary suite rules in Section 5.4 (33.0 m² minimum; maximum the lesser of 40% of the dwelling or 110 m²).",
      "gen": "muse"
    },
    {
      "q": "What transit serves the Boyd Park area?",
      "a": "TransLink route 401 runs on No. 1 Road past the park and the secondary school, between Richmond–Brighouse Station (Canada Line) and Steveston Exchange; there is no SkyTrain station in the area.",
      "gen": "muse"
    }
  ]
