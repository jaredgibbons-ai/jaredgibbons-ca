  "faq": [
    {
      "q": "Which school district covers South Surrey and White Rock?",
      "a": "Both are in School District 36 (Surrey)."
    },
    {
      "q": "Which secondary schools serve South Surrey and White Rock?",
      "a": "Earl Marriott, Elgin Park, Grandview Heights and Semiahmoo Secondary each have a group of feeder elementary schools. Which one applies depends on the exact street address."
    },
    {
      "q": "Does all of White Rock go to the same secondary school?",
      "a": "No. White Rock Elementary feeds Semiahmoo Secondary, while Peace Arch Elementary feeds Earl Marriott Secondary."
    },
