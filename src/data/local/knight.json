  "faq": [
    {
      "q": "Is \"Knight\" an official City of Vancouver neighbourhood?",
      "a": "Not one of the 22 distinct local areas — the City lists \"Knight\" as a recognised smaller area; the Knight Street corridor runs through the Kensington-Cedar Cottage, Sunset and Victoria-Fraserview local areas.",
      "gen": "muse"
    },
    {
      "q": "What is at the south end of Knight Street?",
      "a": "The Knight Street Bridge over the Fraser River's north arm to Richmond — the City frames Victoria-Fraserview as lying between the Knight Street Bridge and Killarney.",
      "gen": "muse"
    },
    {
      "q": "Which health facility is actually on Knight Street?",
      "a": "The South Community Health Centre, 6405 Knight Street at East 49th Avenue, which provides public and community health services for South Vancouver.",
      "gen": "muse"
    },
    {
      "q": "Is there a SkyTrain station on the Knight corridor?",
      "a": "No station sits on the corridor in the sources read — the corridor is bus-served and crossed by the R4 RapidBus at 41st Avenue and the 49 at 49th Avenue, with the bridge carrying traffic to Richmond.",
      "gen": "muse"
    }
  ]
