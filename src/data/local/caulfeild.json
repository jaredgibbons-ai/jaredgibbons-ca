  "faq": [
    {
      "q": "Which public schools are in Caulfeild?",
      "a": "Caulfeild Elementary (iDEC), 4685 Keith Road, Kindergarten to Grade 7, and Rockridge Secondary, 5350 Headland Drive, Grade 8 to Grade 12, across from Caulfeild Village; SD45 has no middle tier.",
      "gen": "muse"
    },
    {
      "q": "What zoning replaced the Caulfeild Land Use Contract?",
      "a": "CD86 (Caulfeild Zone) in Zoning Bylaw No. 4662, 2010, set by Amendment Bylaw No. 5321, 2024, with Residential Area A, Residential Area B, a Commercial Area and a Parks and Greenspaces Area; Residential Area A allows a maximum of three dwelling units per lot and prohibits stratification.",
      "gen": "muse"
    },
    {
      "q": "Is Lower Caulfeild a heritage area?",
      "a": "Yes. Lower Caulfeild is a designated Heritage Conservation Area, planned by Francis Caulfeild from 1899, and owners within its boundaries need a Heritage Alteration Permit for any work.",
      "gen": "muse"
    },
    {
      "q": "What bus service links Caulfeild to Park Royal and Vancouver?",
      "a": "Route 253 runs from Caulfeild Village to Park Royal via Caulfeild Drive, Cherbourg Drive, Keith Road and Marine Drive, with select trips continuing to Vancouver over the Lions Gate Bridge; route 262 links Caulfeild Village to Horseshoe Bay, Lions Bay and Brunswick Beach.",
      "gen": "muse"
    },
    {
      "q": "What parks serve Caulfeild?",
      "a": "Caulfeild Park, with the Caulfeild Trail, rocky foreshore, sandy beaches and swimming, and Lighthouse Park at the west edge, with trails through old-growth forest to the historic lighthouse.",
      "gen": "muse"
    }
  ]
