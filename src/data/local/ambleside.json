  "faq": [
    {
      "q": "What is Ambleside?",
      "a": "West Vancouver's Municipal Town Centre and waterfront — the Marine Drive core, Ambleside Park and the Argyle waterfront, the Community Centre and Memorial Library, with Park Royal immediately east as a separate neighbouring area.",
      "gen": "muse"
    },
    {
      "q": "Which schools are located in Ambleside?",
      "a": "Hollyburn Elementary (K–7), 1329 Duchess Avenue, and West Vancouver Secondary (8–12), 1750 Mathers Avenue, plus West Vancouver Inglewood Secondary, 1735 Inglewood Avenue; catchments are address-based, so check the exact address in the SD45 locator.",
      "gen": "muse"
    },
    {
      "q": "What is happening with the Ambleside waterfront?",
      "a": "The District has acquired waterfront lots since 1975 to complete a continuous public waterfront; the last of 32 lots, 1444 Argyle Avenue, was announced acquired on March 31, 2025, forming part of Brissenden Waterfront Park and connecting Ambleside Park to John Lawson Park under the 2016 Ambleside Waterfront Concept Plan.",
      "gen": "muse"
    },
    {
      "q": "Is Ambleside densifying?",
      "a": "Yes, by plan and now by provincial order: the Province directed adoption of the Ambleside Centre Local Area Plan by December 31, 2025, and when the District missed the deadline a provincial order implemented the plan effective April 7, 2026.",
      "gen": "muse"
    }
  ]
