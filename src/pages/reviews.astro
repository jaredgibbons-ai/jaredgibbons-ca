---
import Base from '../layouts/Base.astro';
import reviews from '../data/reviews.json';
// Text is parsed verbatim from the archive record (docs/archive-extracts/reviews.html.md) by tools/import step; do not retype.
// Star ratings are NOT in the archived text for this page (OI-15). When confirmed, pass rating to <Stars/> (always gold, D-19).
const explore = [
  ['South Surrey & WR', 'South Surrey Homes for Sale', 'View listings →', '/south-surrey-homes-for-sale.html'],
  ['Local Guide', 'South Surrey Real Estate Agent', 'View page →', '/south-surrey-real-estate-agent-jared-gibbons-realtor.html'],
  ['Langley', 'Langley Homes for Sale', 'View listings →', '/langley-homes-for-sale.html'],
  ['Acreages & Farms', 'Langley Acreages for Sale', 'View listings →', '/langley-acreages-for-sale.html'],
  ['Cloverdale', 'Cloverdale Real Estate & MLS®', 'View listings →', '/cloverdale-bc.html'],
  ['Delta', 'Delta, Ladner & Tsawwassen', 'View listings →', '/delta-homes-for-sale.html'],
  ['Selling', 'Free Home Evaluation', 'Request value →', '/home-evaluation.html'],
  ['About', 'About Jared Gibbons, REALTOR®', 'Read bio →', '/jared.html'],
];
---
<Base
  title="Client Reviews & Testimonials | Jared Gibbons"
  canonical="https://jaredgibbons.ca/reviews.html"
  description="Read client reviews and testimonials from buyers and sellers across South Surrey, Langley, White Rock and the Fraser Valley, plus the latest Google reviews."
  ogTitle="Jared Gibbons Reviews | South Surrey & Langley Realtor"
  ogImage="https://jaredgibbons.ca/_media/quick-uploads/zxxkqvoxwgmo.jpg"
  footerTagline="South Surrey Realtor | Homes for Sale, Condos & MLS Listings"
  footerCell={true}
  brandHref="/"
  current="/reviews.html"
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Reviews', href: '/reviews.html' }]}
>
<main id="main">
  <section class="section rv-hero" aria-labelledby="h1">
    <div class="wrap">
      <h1 id="h1" class="rv-h1">Jared Gibbons Client Reviews</h1>
      <p class="rv-intro">Read real client reviews and testimonials from buyers and sellers who worked with Jared Gibbons across South Surrey, Langley, White Rock, and the Fraser Valley. See why local homeowners trust Jared for expert guidance, strong negotiation, and smooth real estate results.</p>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="h-comments">
    <div class="wrap">
      <h2 id="h-comments" class="h2 caps">Client comments</h2>
      <ul class="rv-list">
        {reviews.map((r) => (
          <li class="rv">
            <blockquote class="rv__body">
              {r.title && <p class="rv__title">{r.title}</p>}
              {r.paragraphs.map((p) => <p>{p}</p>)}
            </blockquote>
            <p class="rv__who"><strong>{r.name}</strong><br /><span class="muted">{r.source || r.date}</span></p>
          </li>
        ))}
      </ul>
      <p class="rv-note">A selection of client comments.<span id="rv-more" hidden> More reviews are shown below.</span></p>
      {import.meta.env.PUBLIC_PREVIEW !== 'false' && <p class="preview-flag">Open items OI-15/OI-16: the archive text has no star ratings for these six reviews, and says "More reviews are shown below" but no further reviews were captured (they were likely loaded by the Trustindex script). Plan: Google Business Profile API feed (BL-03); until then only the six archived reviews are shown.</p>}
    </div>
  </section>

  <section class="section" id="google-live" aria-labelledby="h-google" hidden>
    <div class="wrap">
      <h2 id="h-google" class="h2 caps">Latest Google reviews</h2>
      <p class="rv-note" id="google-summary"></p>
      <ul class="rv-list" id="google-list"></ul>
      <p class="rv-note" id="google-links"></p>
    </div>
  </section>

  <section class="section" aria-labelledby="h-explore">
    <div class="wrap">
      <p class="eyebrow">Explore More</p>
      <h2 id="h-explore" class="h2">Communities, MLS® Searches &amp; Client Services</h2>
      <ul class="explore">
        {explore.map(([k, t, v, h], i) => (
          <li><a href={h} class="explore__a"><span class="explore__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="explore__k">{k}</span><span class="explore__t">{t}</span><span class="explore__v">{v}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--ink on-dark cta" aria-labelledby="h-ready">
    <div class="wrap">
      <h2 id="h-ready" class="h2 caps">Ready to get started?</h2>
      <p class="lede">Call <a href="tel:604-928-1361">604-928-1361</a> or <a href="mailto:jaredgibbons@royallepage.ca">Email me</a> today and let's discuss your next home sale or purchase.</p>
    </div>
  </section>
</main>

<script is:inline>
// Progressive enhancement: the six archived reviews above are the page. When the daily Google feed has data, show it too.
// Reviews are shown as Google returns them (unedited), attributed to Google. No star-rating structured data (self-serving, D-19).
(function () {
  var sec = document.getElementById('google-live');
  if (!sec || !window.fetch) return;
  fetch('/api/reviews.json', { headers: { accept: 'application/json' } }).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
    if (!d || !d.reviews || !d.reviews.length) return;
    var el = function (t, c, x) { var n = document.createElement(t); if (c) n.className = c; if (x != null) n.textContent = x; return n; };
    var list = document.getElementById('google-list');
    var more = document.getElementById('rv-more'); if (more) more.hidden = false; // only promised once there are more to show (D-246)
    d.reviews.slice(0, 24).forEach(function (r) {
      var li = el('li', 'rv'), q = el('blockquote', 'rv__body');
      q.appendChild(el('p', 'rv__title', '\u2605'.repeat(r.rating) + ' ' + r.rating + ' out of 5'));
      if (r.text) r.text.split(/\n{2,}/).forEach(function (p) { q.appendChild(el('p', '', p)); });
      if (r.reply) { var rep = el('p', '', 'Reply from Jared: ' + r.reply.text); rep.style.fontStyle = 'italic'; q.appendChild(rep); }
      var who = el('p', 'rv__who'), b = el('strong', '', r.name); who.appendChild(b);
      if (r.date) { who.appendChild(document.createElement('br')); who.appendChild(el('span', 'muted', new Date(r.date).toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' }) + ' \u00b7 Google review')); }
      li.appendChild(q); li.appendChild(who); list.appendChild(li);
    });
    var sum = document.getElementById('google-summary');
    if (d.totalReviewCount) sum.textContent = (d.averageRating ? d.averageRating.toFixed(1) + ' average from ' : '') + d.totalReviewCount + ' Google reviews';
    var links = document.getElementById('google-links');
    if (d.profileUrl) { var a = el('a', '', 'See all reviews on Google'); a.href = d.profileUrl; a.rel = 'noopener'; links.appendChild(a); }
    if (d.profileUrl && d.reviewUrl) links.appendChild(document.createTextNode(' \u00b7 '));
    if (d.reviewUrl) { var w = el('a', '', 'Leave a review'); w.href = d.reviewUrl; w.rel = 'noopener'; links.appendChild(w); }
    sec.hidden = false;
  }).catch(function () {});
})();
</script>
</Base>

<style>
  .rv-hero{padding-bottom:clamp(1.5rem,3vw,2.5rem)}
  .rv-h1{text-transform:uppercase;font-size:clamp(2.5rem,7vw,5.5rem);line-height:.98;letter-spacing:-.035em;margin:0 0 1.5rem}
  .rv-intro{font:400 clamp(1.0625rem,1.8vw,1.3125rem)/1.55 var(--f-body);max-width:52rem;margin:0}
  .rv-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,22rem),1fr));gap:var(--s5);margin:var(--s6) 0 var(--s5)}
  .rv{background:#fff;border:1px solid var(--ink);padding:1.4rem 1.5rem;display:flex;flex-direction:column}
  .rv__body{margin:0 0 1.25rem;flex:1}
  .rv__body p{margin:0 0 .85rem}
  .rv__body p:last-child{margin-bottom:0}
  .rv__title{font:700 1.0625rem/1.35 var(--f-head)}
  .rv__who{margin:0;font-size:.875rem;line-height:1.4}
  .rv-note{font:600 .875rem var(--f-head);letter-spacing:.04em;margin:var(--s4) 0}
  .explore{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,17rem),1fr));gap:0;border-top:1px solid var(--ink);margin-top:var(--s5)}
  .explore li{border-bottom:1px solid var(--ink)}
  .explore__a{display:grid;grid-template-columns:2.5rem 1fr;grid-template-rows:auto auto auto;column-gap:.5rem;padding:1.1rem .75rem 1.25rem 0;text-decoration:none}
  .explore__a:hover{background:var(--ink);color:#fff}
  .explore__a:hover .explore__v{text-decoration:underline}
  .explore__n{grid-row:1/4;font:700 .75rem var(--f-head);letter-spacing:.08em;padding-top:.25rem;padding-left:.5rem}
  .explore__k{font:600 .75rem var(--f-head);letter-spacing:.14em;text-transform:uppercase}
  .explore__t{font:700 1.25rem/1.2 var(--f-head);margin:.2rem 0 .35rem}
  .explore__v{font:700 .75rem var(--f-head);letter-spacing:.1em;text-transform:uppercase}
</style>
