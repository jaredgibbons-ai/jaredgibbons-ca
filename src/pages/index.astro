---
import { isPreview } from '../lib/preview';
import Base from '../layouts/Base.astro';
import PropertyCard from '../components/PropertyCard.astro';
import Stars from '../components/Stars.astro';
import AwardsMarquee from '../components/AwardsMarquee.astro';
import SearchQuiz from '../components/SearchQuiz.astro';
import MarketTicker from '../components/MarketTicker.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import { quickSearchAreas, quickSearchGroups } from '../lib/quicksearch';
import { reviews, awards, listings, areas, southSurreyLinks, langleyLinks, langleyHoods, quick, resources } from '../data/home';
// As Seen In logos: [name, image height, file number]. Add more by dropping a webp in public/img and adding a row.
// Hero search (D-261): area and home type straight to that live-listings page on this site.
const hsAreas = quickSearchAreas(); const hsGroups = quickSearchGroups(hsAreas);
// Search by Area (D-261): each community name opens that community's all-homes page.
const areaHome: Record<string, string> = Object.fromEntries(hsAreas.map((a) => [a.label, a.opts[0][1]]));
const seenLogos: [string, number, number][] = [['Craigslist',164,1],['REW.ca',147,2],['Realtylink',122,3],['LoopNet',150,4],['Spacelist',99,5],['REALTOR.ca',225,6],['Royal LePage',206,7],['Kijiji',338,8]];
---
<Base
  title="South Surrey Realtor | White Rock & Langley | Jared Gibbons"
  canonical="https://jaredgibbons.ca/"
  current="/"
  description="South Surrey Realtor Jared Gibbons, #1 in South Surrey / White Rock by FVREB Medallion Club points. Search homes in South Surrey, White Rock and Langley."
  ogTitle="South Surrey Realtor | White Rock & Langley | Jared Gibbons"
  ogImage="https://jaredgibbons.ca/_media/quick-uploads/fwueizblbkjk.jpg"
>
<main id="main">

  <!-- ░░ HERO — "JARED GIBBONS" ░░ -->
  <section class="hero section" aria-labelledby="h-hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <h1 id="h-hero" class="hero__h1"><span class="hero__name">JARED GIBBONS</span> <span class="hero__role">South Surrey Realtor</span></h1>
        <p class="hero__tag">Top 1% of Fraser Valley REALTORS®</p>
        <p class="hero__proof"><a href="/reviews.html"><span class="hero__stars" aria-hidden="true">★</span> 5.0 · 95 Google reviews</a><span class="hero__asof"> (as of 1 Nov 2026)</span><span aria-hidden="true"> · </span><span>#1 in South Surrey / White Rock by FVREB Medallion Club points (2025 and 2026 YTD)</span></p>
        <form class="hs" action="/map-search.html" data-hs={JSON.stringify(Object.fromEntries(hsAreas.map((a) => [a.key, a.opts])))} role="search" aria-label="Search homes for sale">
          <label class="hs__f"><span>Area</span>
            <select name="area">{hsGroups.map((g) => <optgroup label={g}>{hsAreas.filter((a) => a.group === g).map((a) => <option value={a.key}>{a.label}</option>)}</optgroup>)}</select>
          </label>
          <label class="hs__f"><span>Home type</span>
            <select name="type">{hsAreas[0]?.opts.map(([t, h]) => <option value={h}>{t}</option>)}</select>
          </label>
          <button type="submit" class="btn hs__go">Search homes</button>
        </form>
        <p class="hero__actions">
          <a class="btn btn--ghost" href="/map-search.html">Map search</a>
          <a class="btn btn--ghost" href="tel:604-928-1361">Call 604-928-1361</a>
          <a class="btn btn--ghost hero__mail" href="mailto:jaredgibbons@royallepage.ca">Email Jared</a>
        </p>
      </div>
      <div class="hero__media">
        <img src="/img/Jared.webp" srcset="/img/Jared-480.webp 480w, /img/Jared.webp 900w" sizes="(max-width:820px) 100vw, 40vw" width="900" height="1151" alt="Jared Gibbons – South Surrey Realtor" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <!-- ░░ This month's market (D-236) ░░ -->
  <MarketTicker />

  <!-- ░░ Where are you starting? (quiz) ░░ -->
  <SearchQuiz />

  <!-- ░░ What clients say ░░ -->
  <section class="section section--cream" aria-labelledby="h-reviews">
    <div class="wrap">
      <h2 id="h-reviews" class="h2 caps">What clients say</h2>
      <ul class="reviews row-swipe">
        {reviews.slice(0, Math.floor(reviews.length / 3) * 3).map((r) => (
          <li class="review">
            <Stars rating={5} />
            <blockquote class="review__text">{r.text}</blockquote>
            <p class="review__who"><strong>{r.name}</strong><br /><span class="muted">{r.date}</span></p>
          </li>
        ))}
      </ul>
      <p><a class="btn" href="/reviews.html">Read more client comments</a></p>
    </div>
  </section>

  <!-- ░░ WHY WORK WITH US ░░ -->
  <section class="section" aria-labelledby="h-why">
    <div class="wrap">
      <h2 id="h-why" class="h2 caps">Why work with us</h2>
      <h3 class="subhead">Our proven performance</h3>
      {import.meta.env.PUBLIC_PREVIEW !== 'false' && <p class="preview-flag">Open item OI-07: performance figures under this heading were not captured as text in the archive (likely image/script-rendered). Will be filled from the baseline zips.</p>}
    </div>
    <div class="awards-rows">
      <AwardsMarquee size={90} flush />
      <AwardsMarquee seed="home-row-2" reverse size={72} flush label="More awards" />
    </div>
  </section>

  <!-- ░░ OUR LISTINGS ░░ -->
  <section class="section section--cream" aria-labelledby="h-listings">
    <div class="wrap">
      <h2 id="h-listings" class="h2 caps">Our listings</h2>
      {isPreview && <p class="notice">Listings are not connected in this preview. Cards below are the archived 31 Oct 2026 snapshot of Jared's own listings.</p>}
      <ul class="cards row-swipe">
        {listings.map((l) => (
          <PropertyCard
            href={`/our-listings.html/listing.${l.slug}`}
            photoSlug={`listing.${l.slug}`}
            street={l.street} city={l.city} price={l.price}
            beds={l.beds} baths={l.baths} area_sqft={l.sqft}
            brokerage={l.brokerage}
            moreLabel="More Info" as="p"
          />
        ))}
      </ul>
      <p class="center"><a class="btn" href="/our-listings.html">See all my listings</a></p>
      {import.meta.env.PUBLIC_PREVIEW !== 'false' && <p class="preview-flag">Archive note B-07: the carousel repeats “6469 Meadow Place” as slide 11; shown once here. Card for 116 Calgary Avenue shows one numeric value in the archive (beds vs baths unknown) — not rendered.</p>}
    </div>
  </section>

  <!-- ░░ Ranking (approved wording, audit 2026-11-13) ░░ -->
  <section class="section section--ink rank on-dark" aria-labelledby="h-rank">
    <div class="wrap rank__grid">
      <div>
        <p class="eyebrow">South Surrey Real Estate</p>
        <h2 id="h-rank" class="h2 rank__h">#1 REALTOR® in South Surrey / White Rock by FVREB Medallion Club points (2025 and 2026 YTD)</h2>
        <p class="lede">#1 of the Top 25 individuals at Royal LePage Little Oak Realty (2025). Top 1% of Fraser Valley REALTORS®.</p>
        <p><a class="btn" href="/south-surrey-real-estate-agent-jared-gibbons-realtor.html">Explore South Surrey →</a></p>
      </div>
      <ul class="rank__stats">
        <li><strong>Top 1%</strong><span>of Fraser Valley REALTORS®</span></li>
        <!-- $500M+ is not part of the approved ranking sentence; kept because Jared confirmed it earlier (flagged in the audit PR). -->
        <li><strong>$500M+</strong><span>Career sales</span></li>
                <li><strong>95</strong><span>Google reviews, 5.0 rating (as of 1 Nov 2026)</span></li>
        <li><strong>2015</strong><span>REALTOR® since 2015</span></li>
      </ul>
    </div>
  </section>

  <!-- ░░ As Seen In ░░ -->
  <section class="section" aria-labelledby="h-seen">
    <div class="wrap">
      <h2 id="h-seen" class="h2 caps">As Seen In</h2>
      <div class="seen" role="group" aria-label="Sites and brands Jared's listings appear on">
        <ul class="seen__track">
          {[...seenLogos, ...seenLogos].map(([name, h, n], k) => <li class="seen__tile" aria-hidden={k >= seenLogos.length ? 'true' : undefined}><img src={`/img/as-seen-in-${n}.webp`} alt={name} width="640" height={h} loading="lazy" decoding="async" /></li>)}
        </ul>
      </div>
      {import.meta.env.PUBLIC_PREVIEW !== 'false' && <p class="preview-flag">Archive note B-08: these 8 logo slides are image links to “/” with empty alt text (no accessible name). Rendered unlinked pending your decision D-08. Logo order follows the supplied file numbering; confirm against the live carousel (OI-12).</p>}
    </div>
  </section>

  <!-- ░░ Search by Area ░░ -->
  <section class="section section--cream" aria-labelledby="h-area">
    <div class="wrap">
      <p class="eyebrow">Fraser Valley · Metro Vancouver · BC</p>
      <h2 id="h-area" class="h2 caps">Search by Area</h2>
      <p class="lede"><strong>Every community.</strong> <strong>Every property type.</strong></p>
      <p class="prose">Jared Gibbons serves buyers and sellers across 11 communities in the Fraser Valley and Metro Vancouver. Select a community to search attached homes, detached homes, townhomes, or acreages.</p>
      <p class="eyebrow">11 Communities · Updated Daily from MLS®</p>
      <ol class="areas">
        {areas.map((a) => (
          <li class="area">
            <span class="area__n" aria-hidden="true">{a.n}</span>
            <div>
              {areaHome[a.name] ? <p class="area__name"><a href={areaHome[a.name]}>{a.name}<span class="sr-only"> homes for sale</span></a></p> : <p class="area__name">{a.name}</p>}
              <p class="area__hoods">{a.hoods}</p>
              <ul class="area__types">
                {a.types.map(([label, href]) => <li><a href={href}>{label}<span class="sr-only"> in {a.name}</span></a></li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
      <div class="cant">
        <p>Can't find what you're looking for? Jared can search the full MLS® for you.</p>
        <p><a class="btn" href="/contact.html">Talk to Jared →</a></p>
      </div>
    </div>
  </section>

  <!-- ░░ Search homes by area and type ░░ -->
  <section class="section" aria-labelledby="h-type">
    <div class="wrap">
      <h2 id="h-type" class="h2 caps">Search homes by area and type</h2>
      <p class="lede">Live MLS® listings, updated daily. Pick a home type, price range or area.</p>
      <div class="twocol">
        <div>
          <h3 class="subhead">South Surrey and White Rock</h3>
          <p>Start with all <a href="/south-surrey-homes-for-sale.html">South Surrey homes for sale</a>, or narrow it down below.</p>
          <ul class="linklist">{southSurreyLinks.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
        </div>
        <div>
          <h3 class="subhead">Langley</h3>
          <ul class="linklist">{langleyLinks.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
          <h3 class="subhead subhead--sm">Langley neighbourhoods</h3>
          <ul class="linklist">{langleyHoods.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
        </div>
      </div>

      <ul class="tiles">
        {quick.map((q) => (
          <li class="tile">
            <a href={q.href} class="tile__a">
              <span class="tile__n" aria-hidden="true">{q.n} ↗</span>
              <span class="tile__kick">{q.kicker}</span>
              <h3 class="tile__h">{q.title.join(' ')}</h3>
              <span class="tile__t">{q.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ░░ Resources ░░ -->
  <section class="section section--cream" aria-labelledby="h-res">
    <div class="wrap">
      <p class="eyebrow">Tools &amp; Resources</p>
      <h2 id="h-res" class="h2 caps">Resources</h2>
      <p class="lede">Everything you need to buy, sell, or stay informed in the South Surrey and Fraser Valley market.</p>
      <ul class="tiles">
        {resources.map((q) => (
          <li class="tile tile--white">
            <a href={q.href} class="tile__a">
              <span class="tile__n" aria-hidden="true">{q.n} ↗</span>
              <span class="tile__kick">{q.kicker}</span>
              <h3 class="tile__h">{q.title.join(' ')}</h3>
              <span class="tile__t">{q.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ░░ Instagram (D-237; shows once the feed is connected) ░░ -->
  <InstagramFeed />

  <!-- ░░ Ready to get started? ░░ -->
  <section class="section section--ink on-dark cta" aria-labelledby="h-ready">
    <div class="wrap">
      <h2 id="h-ready" class="h2 caps">Ready to get started?</h2>
      <p class="lede">Call <a href="tel:604-928-1361">604-928-1361</a> or <a href="mailto:jaredgibbons@royallepage.ca">email me</a> today and let's discuss your next home sale or purchase.</p>
    </div>
  </section>
</main>
</Base>

<script>
  // Hero search (D-261): the home-type list follows the chosen area; Search homes opens that live-listings page. Without JS the form
  // goes to the map search page.
  const hs = document.querySelector<HTMLFormElement>('form.hs[data-hs]');
  if (hs) {
    const data = JSON.parse(hs.dataset.hs || '{}') as Record<string, [string, string][]>;
    const area = hs.elements.namedItem('area') as HTMLSelectElement, type = hs.elements.namedItem('type') as HTMLSelectElement;
    const fill = () => { type.replaceChildren(...(data[area.value] || []).map(([t, h]) => { const o = document.createElement('option'); o.value = h; o.textContent = t; return o; })); };
    area.addEventListener('change', fill); fill();
    hs.addEventListener('submit', (e) => { e.preventDefault(); location.href = /^\/[a-z0-9-]+\.html$/.test(type.value) ? type.value : '/map-search.html'; });
  }
</script>

<style>
  .hs{display:grid;grid-template-columns:1fr 1fr auto;gap:.6rem;align-items:end;margin:0 0 1rem;padding:1rem;border:1px solid var(--ink);background:#fff;max-width:44rem}
  .hs__f{display:block;min-width:0}
  .hs__f span{display:block;margin:0 0 .3rem;font:700 .6875rem/1.2 var(--f-head);letter-spacing:.1em;text-transform:uppercase;color:var(--grey)}
  .hs__f select{width:100%;min-height:3.25rem;padding:.4rem .5rem;border:1px solid var(--ink);border-radius:0;background:#fff;color:var(--ink);font:400 1rem var(--f-body)}
  .hs__go{min-height:3.25rem;justify-content:center}
  @media (max-width:520px){.hs{grid-template-columns:1fr 1fr}.hs__go{grid-column:1/-1}.hero__mail{display:none}}
  /* Home-only sizing; the shared heading style (800, tight, .caps) is in global.css */
  .hero__h1{margin:0;font-size:1rem;line-height:1;font-weight:400;letter-spacing:0}
  .hero__name{display:block;font-weight:800;letter-spacing:-.05em}
  .hero__role{display:block;margin-top:clamp(.5rem,1.2vw,1rem);font-size:clamp(.95rem,1.9vw,1.5rem);font-weight:600;letter-spacing:.24em;text-transform:uppercase;line-height:1.2}
  .hero__tag{font-weight:600;letter-spacing:.24em}
  .rank__h{font-weight:800;text-transform:uppercase;letter-spacing:-.045em;line-height:.96}
  .area__name{font-weight:800;text-transform:uppercase;letter-spacing:-.02em}
  .tile__h{font-weight:800;letter-spacing:-.015em}
  .subhead{font-weight:800}
  .rank__stats strong{font-weight:800;letter-spacing:-.03em}
  .hero{padding-block:clamp(1.5rem,3.5vw,3rem) clamp(1.75rem,4vw,3rem)}
  .hero__grid{display:grid;grid-template-columns:1.4fr 1fr;gap:clamp(1.5rem,5vw,4.5rem);align-items:center}
  .hero__name{font-size:clamp(2.75rem,8.2vw,7.5rem);line-height:.92;letter-spacing:-.035em}
  .hero__tag{font:600 clamp(.9rem,1.6vw,1.125rem)/1.3 var(--f-head);letter-spacing:.18em;text-transform:uppercase;margin:1.75rem 0 2rem}
  .hero__proof{margin:-1rem 0 1.75rem;font:700 clamp(.875rem,1.3vw,1rem)/1.4 var(--f-head);letter-spacing:.04em}
  .hero__proof a{color:var(--ink);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
  .hero__stars{color:var(--star)}
  .hero__actions{display:flex;flex-wrap:wrap;gap:1rem;margin:0}
  .hero__actions .btn{min-height:3.25rem;padding:.9rem 1.35rem;font-size:.9375rem;letter-spacing:.08em;flex:0 1 auto}
  @media (max-width:520px){.hero__actions .btn{flex:1 1 100%;justify-content:center}}
  .hero__media{aspect-ratio:6/7;background:#000;border:1px solid var(--ink);overflow:hidden}
  .hero__media img{width:100%;height:100%;object-fit:cover;object-position:50% 20%;display:block}
  @media (max-width:820px){.hero__grid{grid-template-columns:1fr}.hero__media{aspect-ratio:4/3;order:-1}}
  /* Phones (D-261): a shorter photo so the home search is on the first screen */
  @media (max-width:520px){.hero__media{aspect-ratio:2/1}.hero__media img{object-position:50% 22%}.hero__tag{margin:1rem 0 1.25rem}.hero__proof{margin:-.5rem 0 1rem}}

  .reviews{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,19rem),1fr));gap:var(--s5);margin:var(--s6) 0}
  .review{background:#fff;border:1px solid var(--ink);padding:1.25rem 1.4rem;display:flex;flex-direction:column}
  .review__text{margin:0 0 1rem;font-size:1rem;flex:1}
  .review__who{margin:0;font-size:.875rem;line-height:1.4}
  .subhead{font:700 clamp(1.125rem,2vw,1.5rem)/1.2 var(--f-head);letter-spacing:.04em;text-transform:uppercase;margin:1.5rem 0 1rem}
  .subhead--sm{font-size:1rem;margin-top:2rem}
  .awards-rows{margin:var(--s4) 0 0;display:grid;gap:0}
  .awards-rows :global(.awm:first-child){padding-bottom:.5rem}
  .awards-rows :global(.awm + .awm){padding-top:.5rem}

  .rank__grid{display:grid;grid-template-columns:1.5fr 1fr;gap:var(--s7);align-items:center}
  .rank__h{font-size:clamp(2.25rem,6vw,5rem);line-height:1;letter-spacing:-.03em}
  .rank__stats{display:grid;grid-template-columns:1fr 1fr;gap:var(--s5) var(--s6)}
  .rank__stats li:first-child{grid-column:1/-1}
  .rank__stats li{border-top:1px solid #fff;padding-top:var(--s3);display:flex;flex-direction:column}
  .rank__stats strong{font:700 clamp(1.75rem,4vw,3rem)/1 var(--f-head)}
  .rank__stats span{font:600 .75rem var(--f-head);letter-spacing:.16em;text-transform:uppercase;margin-top:.4rem}
  @media (max-width:820px){.rank__grid{grid-template-columns:1fr}}

  .seen{margin-top:var(--s5);overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
  .seen__track{display:flex;gap:var(--s4);width:max-content;margin:0;padding:0;list-style:none;animation:seen-scroll 45s linear infinite}
  .seen:hover .seen__track,.seen:focus-within .seen__track{animation-play-state:paused}
  @keyframes seen-scroll{to{transform:translateX(calc(-50% - var(--s4) / 2))}}
  .seen__tile{flex:0 0 13rem;aspect-ratio:3/2;border:1px solid var(--rule);display:grid;place-items:center;padding:1.1rem 1.25rem;background:#fff}
  .seen__tile img{max-width:100%;max-height:100%;width:auto;height:auto;display:block}
  @media (prefers-reduced-motion:reduce){.seen{overflow-x:auto;-webkit-mask-image:none;mask-image:none}.seen__track{animation:none}.seen__tile[aria-hidden="true"]{display:none}}

  .areas{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,22rem),1fr));gap:0;border-top:1px solid var(--ink);margin:var(--s5) 0 var(--s6)}
  .area{display:grid;grid-template-columns:3rem 1fr;gap:var(--s3);padding:1.25rem 1rem 1.5rem 0;border-bottom:1px solid var(--ink)}
  .area__n{font:700 .8125rem var(--f-head);letter-spacing:.08em;padding-top:.3rem}
  .area__name{font:700 1.5rem/1.15 var(--f-head);margin:0}
  .area__hoods{color:var(--grey);font-size:.9375rem;margin:.25rem 0 .75rem}
  .area__types{display:flex;flex-wrap:wrap;gap:.5rem}
  .area__types a{font:700 .75rem var(--f-head);letter-spacing:.1em;text-transform:uppercase}
  .area__name a{color:inherit;text-decoration:none;display:inline-flex;align-items:center;min-height:2.75rem}
  .area__name a::after{content:' →';margin-left:.35em;font-weight:400}
  .area__name a:hover{text-decoration:underline}
  .area__types a{display:inline-flex;align-items:center;min-height:2.75rem;padding:0 .9rem;border:1px solid var(--ink);text-decoration:none}
  .area__types a:hover{background:var(--ink);color:#fff}
  .cant{display:flex;flex-wrap:wrap;gap:var(--s4);align-items:center;justify-content:space-between;border:1px solid var(--ink);background:#fff;padding:1.25rem 1.5rem}
  .cant p{margin:0;font:600 1rem var(--f-head)}

  .twocol{display:grid;grid-template-columns:1fr 1fr;gap:var(--s7);margin-block:var(--s5) var(--s7)}
  @media (max-width:820px){.twocol{grid-template-columns:1fr}}
  .linklist{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,13rem),1fr));gap:.6rem;margin:0 0 1.25rem}
  .linklist li{border:1px solid var(--ink);background:#fff;transition:background .15s,color .15s}
  .linklist li :global(a){display:flex;align-items:center;justify-content:space-between;gap:.75rem;min-height:2.75rem;padding:.55rem .9rem;font:700 .875rem/1.3 var(--f-head);text-decoration:none}
  .linklist li :global(a)::after{content:'→';font-weight:400}
  .linklist li:hover{background:var(--ink)}
  .linklist li:hover :global(a){color:#fff}

  .tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,17rem),1fr));gap:var(--s4);margin-top:var(--s6)}
  .tile{background:var(--cream);border:1px solid var(--ink)}
  .tile--white{background:#fff}
  .tile__a{display:flex;flex-direction:column;gap:.35rem;height:100%;padding:1.25rem 1.4rem 1.5rem;text-decoration:none;transition:background .15s,color .15s}
  .tile__a:hover{background:var(--ink);color:#fff;text-decoration:none}
  .tile__n{font:700 .75rem var(--f-head);letter-spacing:.1em}
  .tile__kick{font:600 .75rem var(--f-head);letter-spacing:.14em;text-transform:uppercase;opacity:.85}
  .tile__h{font-size:1.5rem;margin:.25rem 0}
  .tile__t{font-size:.9375rem}

  .cta .lede{max-width:none;font-size:clamp(1.125rem,2vw,1.5rem)}
