---
// Site search (D-238): Pagefind runs in the browser on the static index built by tools/build_search.mjs. ?q= pre-fills
// the search (the header icon and the 404 page link here). Not in the sitemap; noindex (search result pages are thin).
import Base from '../layouts/Base.astro';
---
<Base robots="noindex, follow" title="Search the Site | Jared Gibbons" description="Search every page on jaredgibbons.ca: neighbourhood guides, homes for sale by area and type, market stats, buyer and seller guides, and blog posts." canonical="https://jaredgibbons.ca/search.html" crumbs={[{ name: 'Home', href: '/' }, { name: 'Search', href: '/search.html' }]}>
<main id="main">
  <section class="section">
    <div class="wrap srch">
      <h1 class="h2 caps srch__h">Search the site</h1>
      <p class="lede">Areas, home types, price ranges, schools, market stats and guides. Try “Langley townhomes”, “pad rent” or “A1 zoning”.</p>
      <div id="search" class="srch__ui"></div>
      <noscript><p>Search needs JavaScript. Use the menu, or call <a href="tel:604-928-1361">604-928-1361</a>.</p></noscript>
      <p class="srch__alt">Looking for homes for sale right now? <a href="/recip.html">Search MLS® listings</a>.</p>
    </div>
  </section>
</main>
</Base>
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  (function () {
    var start = function () {
      if (!window.PagefindUI) return;
      var ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false, pageSize: 10, excerptLength: 22, ranking: { pageLength: 0.1, termFrequency: 0.6, termSaturation: 1.6 },
        translations: { placeholder: 'Search areas, home types, guides…', zero_results: 'No pages match “[SEARCH_TERM]”. Try a shorter search, or call Jared at 604-928-1361.' } });
      var q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
      var input = document.querySelector('#search input'); if (input) { input.setAttribute('aria-label', 'Search the site'); if (!q) input.focus(); }
      // keep the address bar in step with the search, so a result page can be shared or come back to
      document.querySelector('#search').addEventListener('input', function (e) { if (e.target.tagName === 'INPUT') { var u = new URL(location.href); if (e.target.value) u.searchParams.set('q', e.target.value); else u.searchParams.delete('q'); history.replaceState(null, '', u); } });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
  })();
</script>
<style is:global>
  .srch{max-width:52rem}
  .srch__h{margin:0 0 .75rem}
  .srch__alt{margin-top:var(--s6);font-weight:600}
  .srch__ui{--pagefind-ui-scale:1;--pagefind-ui-primary:#0a0a0a;--pagefind-ui-text:#0a0a0a;--pagefind-ui-background:#fff;--pagefind-ui-border:#0a0a0a;--pagefind-ui-tag:#f0ece4;--pagefind-ui-border-width:1px;--pagefind-ui-border-radius:0;--pagefind-ui-font:inherit;margin-top:var(--s5)}
  .srch__ui .pagefind-ui__search-input{font-weight:600}
  .srch__ui .pagefind-ui__result-link{color:#0a0a0a;font-weight:700}
  .srch__ui mark{background:#f0ece4;color:#0a0a0a;padding:0 .1em}
</style>
