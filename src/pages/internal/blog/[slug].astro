---
// Blog posts. Public URL is /blog.html/<slug>; emitted under /internal/blog/ because blog.html is
// itself a page (a file cannot also be a directory). The Worker maps the public URL here and
// never serves /internal/* directly.
import GenericPage from '../../../components/GenericPage.astro';
import PLS from '../../../data/post-listing-seo.json';
import RELATED from '../../../data/post-related.json';
import CONTEXT from '../../../data/post-context.json';
import REWRITES from '../../../data/post-rewrites.json';
export function getStaticPaths() {
  const mods = import.meta.glob('../../../data/posts/*.json', { eager: true }) as Record<string, any>;
  const titleOf: Record<string, string> = {};
  for (const m of Object.values(mods)) titleOf[m.default.slug] = String((PLS as Record<string, any>)[m.default.slug]?.title || m.default.title || '').split(' | ')[0].trim();
  return Object.values(mods).map((m0) => { let m = m0;
    // Related posts (tools/build_post_related.py, D-221): every post links to up to six others on the same area or topic.
    const rel = ((RELATED as Record<string, string[]>)[m.default.slug] || []).filter((s) => titleOf[s]);
    // Rewritten posts (D-271, tools/build_post_rewrites.py): their own current body replaces the archived one and the generic area section.
    const rw = (REWRITES as Record<string, any>)[m.default.slug];
    if (rw) {
      const B0: any[] = m.default.blocks || [];
      const h1 = B0.find((b: any) => b.t === 'h' && b.level === 1) || { t: 'h', level: 1, text: rw.h1 };
      const by = B0.find((b: any) => b.cls === 'byline');
      const upd = new Date(rw.updated + 'T12:00:00Z').toLocaleDateString('en-US', { timeZone: 'America/Vancouver', month: 'long', day: 'numeric', year: 'numeric' });
      const byline = by ? { ...by, parts: [...by.parts, { t: `· Updated ${upd}` }] } : { t: 'p', cls: 'byline', parts: [{ t: `Updated ${upd} by` }, { t: 'Jared Gibbons', h: '/jared.html' }] };
      m = { ...m, default: { ...m.default, seo: { ...(m.default.seo || {}), Modified: rw.updated + 'T12:00:00+00:00' }, blocks: [{ ...h1, text: rw.h1 }, byline, ...rw.blocks] } };
    }
    const author = [...((rw ? [] : (CONTEXT as Record<string, any>)[m.default.slug]?.blocks) || []), { t: 'authorbox' }];   // D-267: local context on short posts, then   // D-266: every post ends with who wrote it and how to reach him
    const relBlocks0 = rel.length ? [{ t: 'h', level: 2, text: 'Related posts' }, { t: 'list', items: rel.map((s) => [{ t: titleOf[s], h: `/blog.html/${s}` }]) }] : [];
    const relBlocks = [...author, ...relBlocks0];
    // Reviewed search title, description and (where the archive's was wrong) H1, from tools/build_post_listing_seo.py (D-221). Applied last.
    const f = (PLS as Record<string, any>)[m.default.slug] || (rw ? {} : undefined);
    if (!f) return { params: { slug: m.default.slug }, props: { page: { ...m.default, blocks: [...(m.default.blocks || []), ...relBlocks] } } };
    const pg = { ...m.default, seo: { ...(m.default.seo || {}) }, blocks: [...(m.default.blocks || []), ...relBlocks] };
    if (f.title) { pg.title = f.title; pg.seo.Title = f.title; pg.seo['OG title'] = f.title; }
    if (f.description) { pg.seo['Meta description'] = f.description; pg.seo['OG description'] = f.description; }
    if (f.h1) { pg.seo.H1 = f.h1; const i = pg.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1); if (i >= 0) pg.blocks[i] = { ...pg.blocks[i], text: f.h1 }; }
    if (rw) { pg.title = rw.title; pg.seo.Title = rw.title; pg.seo['OG title'] = rw.title; pg.seo['Meta description'] = rw.description; pg.seo['OG description'] = rw.description; pg.seo.H1 = rw.h1; const i = pg.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1); if (i >= 0) pg.blocks[i] = { ...pg.blocks[i], text: rw.h1 }; }
    return { params: { slug: pg.slug }, props: { page: pg } };
  });
}
const { page } = Astro.props as { page: any };
---
<GenericPage page={page} />
