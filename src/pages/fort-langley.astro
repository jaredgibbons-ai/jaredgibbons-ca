  .faq details[open] summary::after{content:"–"}
  .faq summary:hover{text-decoration:underline;text-decoration-thickness:2px}
  .faq details p{padding-bottom:1.1rem;margin:0}
  .faq-h{margin-bottom:var(--s5)}
