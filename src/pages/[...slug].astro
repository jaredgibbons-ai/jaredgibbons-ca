---
// Generic archive-driven pages. Bespoke pages (index, fort-langley, reviews) are explicit files and win.
import GenericPage from '../components/GenericPage.astro';
import DesignedPage from '../components/DesignedPage.astro';
import ZoningPage from '../components/ZoningPage.astro';   // the zoning directory has its own layout (D-268)
import ZLOCAL from '../data/local/zonings.json';
import SEO_OVERRIDES from '../data/seo-overrides.json';
import SEO_FINAL from '../data/seo-final.json';
import PLS from '../data/post-listing-seo.json';
import { postImage } from '../lib/post-images';
export function getStaticPaths() {
  const mods = import.meta.glob('../data/pages/*.json', { eager: true }) as Record<string, any>;
  const out = Object.values(mods).map((m) => ({ params: { slug: m.default.slug }, props: { page: m.default } }));
  // Approved keyword titles (src/data/seo-overrides.json, tools/build_seo_overrides.py): applied over the archive record, which stays untouched.
  for (const o of out) {
    const ov = (SEO_OVERRIDES as Record<string, any>)[o.params.slug];
    if (!ov) continue;
    const pg = o.props.page; pg.seo = { ...(pg.seo || {}) };
    if (ov.title) { pg.title = ov.title; pg.seo.Title = ov.title; pg.seo['OG title'] = ov.title; }
    if (ov.description) { pg.seo['Meta description'] = ov.description; pg.seo['OG description'] = ov.description; }
    if (ov.h1) { pg.seo.H1 = ov.h1; const h = pg.blocks.find((b: any) => b.t === 'h' && b.level === 1); if (h) h.text = ov.h1; else pg.blocks.unshift({ t: 'h', level: 1, text: ov.h1 }); }
  }
  // The archive's blog index carries the full text of the newest posts one after another (about 280,000 px tall on a phone), and an earlier
  // rebuild still stacked 50 of them one per band with no dates (29,000 px). It is now a real index (D-258): the latest market update up top,
  // the 24 newest posts as dated cards, then every post listed by year. Titles and summaries are the reviewed ones (post-listing-seo.json).
  const blog = out.find((o) => o.params.slug === 'blog');
  if (blog) {
    const B: any[] = blog.props.page.blocks;
    const fmt = (iso: string, o: Intl.DateTimeFormatOptions) => new Date(iso).toLocaleDateString('en-US', { timeZone: 'America/Vancouver', ...o });
    const posts = Object.values(import.meta.glob('../data/posts/*.json', { eager: true, import: 'default' }) as Record<string, any>)
      .filter((q: any) => q.canonical && q.title && q.slug)
      .sort((a: any, b: any) => String(b.seo?.Published || '').localeCompare(String(a.seo?.Published || '')))
      .map((q: any) => { const f = (PLS as Record<string, any>)[q.slug] || {}; const iso = String(q.seo?.Published || '');
        return { title: String(f.title || q.title).replace(/ \| Jared Gibbons.*$/, '').trim(), href: `/blog.html/${q.slug}`, iso: iso.slice(0, 10),
          date: iso ? fmt(iso, { month: 'short', day: 'numeric', year: 'numeric' }) : '', short: iso ? fmt(iso, { month: 'short', day: 'numeric' }) : '', year: iso ? fmt(iso, { year: 'numeric' }) : 'Earlier',
          excerpt: String(f.description || q.seo?.['Meta description'] || '').trim() }; });
    // The newest monthly market update (a page written by tools/build_market_update.py; it carries `market_update: "YYYY-MM"`).
    const locals0 = import.meta.glob('../data/local/*.json', { eager: true, import: 'default' }) as Record<string, any>;
    const mk = Object.values(locals0).filter((l: any) => l.market_update && l.new_page).sort((a: any, b: any) => String(b.market_update).localeCompare(String(a.market_update)))[0] as any;
    const prevLink = B.flatMap((x: any) => x.parts || []).find((x: any) => /market-update/.test(String(x.h || '')));
    const feature = mk ? [{ t: 'mktfeature', eyebrow: 'Latest market update', title: mk.new_page.h1, href: `/${mk.slug}.html`, summary: mk.new_page.description,
      stats: (mk.blocks.find((x: any) => x.t === 'stats')?.items || []).map((it: any) => ({ label: it.label, value: it.value })),
      prev: prevLink ? { t: String(prevLink.t).replace(/:.*$/, ''), h: String(prevLink.h).replace(/^https:\/\/jaredgibbons\.ca/, '') } : null }]
      : (prevLink ? [{ t: 'p', parts: [{ t: 'Latest market update:' }, prevLink] }] : []);
    const h1 = B.find((x: any) => x.t === 'h' && x.level === 1) || { t: 'h', level: 1, text: 'Blog' };
    const lede = B.find((x: any) => x.t === 'h' && x.level === 2 && !x.href);   // "Read the Latest Real Estate News, Market Updates, and Helpful Tips"
    const years = [...new Set(posts.map((q) => q.year))];
    blog.props.page = { ...blog.props.page, blocks: [
      h1, ...(lede ? [{ t: 'p', cls: 'lede', parts: [{ t: lede.text.charAt(0) + lede.text.slice(1).toLowerCase() + '.' }] }] : []), ...feature,
      { t: 'h', level: 2, text: 'Latest posts' }, { t: 'postgrid', items: posts.slice(0, 24).map((q) => ({ ...q, img: postImage(q.href.split('/').pop()!) })) },   // each card carries its post's lead photo (D-259)
      { t: 'h', level: 2, text: 'All blog posts by year' }, { t: 'postyears', years: years.map((y) => ({ year: y, posts: posts.filter((q) => q.year === y) })) },
    ] };
  }
  // /our-listings.html and /sold-properties.html showed only the MyRealPage widget, so 192 of Jared's 203 listing pages had no link from the site. Both now carry a
  // static card list built from src/data/listings (photos, price, facts), which also works when the widget does not load.
  const own = out.find((o) => o.params.slug === 'our-listings');
  if (own) { const B = own.props.page.blocks; const at = Math.max(1, B.findIndex((b: any) => b.t === 'p') + 1); own.props.page = { ...own.props.page, blocks: [...B.slice(0, at), { t: 'lcards', mode: 'active' }, ...B.slice(at)] }; }
  const sold = out.find((o) => o.params.slug === 'sold-properties');
  if (sold) { const B = sold.props.page.blocks; const at = B.findIndex((b: any) => b.t === 'grid'); sold.props.page = { ...sold.props.page, blocks: [...B.slice(0, at < 0 ? B.length : at), { t: 'lcards', mode: 'sold' }, ...B.slice(at < 0 ? B.length : at)] }; }
  // New pages (no archive counterpart) are authored as src/data/local/<slug>.json with a `new_page` header.
  const taken = new Set(out.map((o) => o.params.slug));
  const locals = import.meta.glob('../data/local/*.json', { eager: true, import: 'default' }) as Record<string, any>;
  for (const [f, l] of Object.entries(locals)) {
    const slug = f.split('/').pop()!.replace(/\.json$/, '');
    if (!l.new_page || taken.has(slug)) continue;
    const n = l.new_page; const canonical = `https://jaredgibbons.ca/${slug}.html`;
    out.push({ params: { slug }, props: { page: { slug, path: `/${slug}.html`, url: canonical, kind: 'page', title: n.title, canonical,
      seo: { Title: n.title, 'Meta description': n.description, H1: n.h1, Canonical: canonical, 'Meta robots': 'index, follow', 'OG title': n.title, 'OG description': n.description },
      blocks: [{ t: 'h', level: 1, text: n.h1 }], forms: [], iframes: [] } } });
  }
  // Final SEO pass (D-144, tools/build_seo_final.py): one reviewed title, H1 and meta description per page, applied last so it wins over the archive,
  // the older overrides and every generator's own wording. Delete an entry to fall back to the layer underneath.
  for (const o of out) {
    const f = (SEO_FINAL as Record<string, any>)[o.params.slug];
    if (!f) continue;
    const pg = o.props.page; pg.seo = { ...(pg.seo || {}) };
    if (f.title) { pg.title = f.title; pg.seo.Title = f.title; pg.seo['OG title'] = f.title; }
    if (f.description) { pg.seo['Meta description'] = f.description; pg.seo['OG description'] = f.description; }
    if (f.h1) { pg.seo.H1 = f.h1; pg.blocks = [...pg.blocks]; const i = pg.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1); if (i >= 0) pg.blocks[i] = { ...pg.blocks[i], text: f.h1 }; else pg.blocks.unshift({ t: 'h', level: 1, text: f.h1 }); }
  }
  return out;
}
const { page } = Astro.props as { page: any };
// Long editorial pages (Buying, Selling) are rebuilt as designed pages from src/data/designed/<slug>.json (same wording as the archive/live page).
const designedMods = import.meta.glob('../data/designed/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const designed = Object.entries(designedMods).find(([f]) => f.endsWith(`/${page.slug}.json`))?.[1];
---
{page.slug === 'zonings' ? <ZoningPage page={page} faq={(ZLOCAL as any).faq.filter((f: any) => f.gen === 'muse')} /> : designed ? <DesignedPage page={page} d={designed} /> : <GenericPage page={page} />}
