---
// Generic archive-driven pages. Bespoke pages (index, fort-langley, reviews) are explicit files and win.
import GenericPage from '../components/GenericPage.astro';
export function getStaticPaths() {
  const mods = import.meta.glob('../data/pages/*.json', { eager: true }) as Record<string, any>;
  return Object.values(mods).map((m) => ({ params: { slug: m.default.slug }, props: { page: m.default } }));
}
const { page } = Astro.props as { page: any };
---
<GenericPage page={page} />
