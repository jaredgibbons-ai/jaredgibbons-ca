---
import SellerNudge from '../components/SellerNudge.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { fitTitle, fitMeta } from '../lib/seo';
const { title: rawTitle, description: rawDescription, canonical, footerTagline, footerCell = false, current = '', brandHref = '/', ogTitle, ogDescription, ogImage, jsonld = [], robots = '', crumbs = [] } = Astro.props;
const title = fitTitle(rawTitle);
const description = fitMeta(rawDescription);
const ogDesc = fitMeta(ogDescription) ?? description;
const crumbLd = crumbs.length > 1 ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c: any, i: number) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: 'https://jaredgibbons.ca' + c.href })) }] : [];
// PUBLIC_PREVIEW defaults to true: the whole preview is closed. Launch (needs Jared's approval) builds with PUBLIC_PREVIEW=false, which then emits each page's own robots value.
const preview = import.meta.env.PUBLIC_PREVIEW !== 'false';
// Pages with no image of their own (search and market-stat pages) share a default card, not a text-only one.
// Share images on MyRealPage's /_media/ path are not part of the new site and stop loading at the switch (D-236): use the default card.
const shareImage = ogImage && !/\/_media\//.test(ogImage) ? ogImage : 'https://jaredgibbons.ca/img/og-default.jpg';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const site = 'https://jaredgibbons.ca';
// Home-only entity markup (facts as published in the footer and profile; no ratings). sameAs, image, logo, geo and hasMap carry over
// from the old site's own markup (MyRealPage custom head, D-233), so Google keeps tying these profiles to the site.
const entity = isHome ? [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'Jared Gibbons', inLanguage: 'en-CA', publisher: { '@id': `${site}/#agent` } },
  { '@context': 'https://schema.org', '@type': 'RealEstateAgent', '@id': `${site}/#agent`, name: 'Jared Gibbons', url: `${site}/`, telephone: '+1-604-928-1361', email: 'jaredgibbons@royallepage.ca',
    description: 'Jared Gibbons is a REALTOR® with Royal LePage Little Oak Realty serving South Surrey, White Rock, Langley and the Fraser Valley.',
    parentOrganization: { '@type': 'Organization', name: 'Royal LePage Little Oak Realty' },
    address: { '@type': 'PostalAddress', streetAddress: '#201, 15272 Croydon Drive', addressLocality: 'Surrey', addressRegion: 'BC', postalCode: 'V3Z 0Z5', addressCountry: 'CA' },
    areaServed: ['South Surrey', 'White Rock', 'Langley', 'Surrey', 'Abbotsford', 'Chilliwack', 'Fraser Valley'].map((n) => ({ '@type': 'Place', name: n })),
    image: `${site}/img/Jared.webp`, logo: `${site}/img/site-logo.webp`,
    geo: { '@type': 'GeoCoordinates', latitude: 49.0598, longitude: -122.79918 },
    hasMap: 'https://maps.app.goo.gl/zvYBAj6rf2cKyjsZ9',
    employee: { '@id': `${site}/#jared` },
    sameAs: ['https://www.facebook.com/jaredgibbonsrealestate/', 'https://www.instagram.com/jaredgibbonsrealestate/', 'https://www.youtube.com/@JaredGibbonsRealtor',
      'https://www.tiktok.com/@jaredgibbonsrealtor', 'https://www.pinterest.com/jaredgibbonsrealtor/', 'https://ca.linkedin.com/in/jared-gibbons-96814591',
      'https://www.rate-my-agent.com/jared-gibbons-ratings-surrey-15968', 'https://www.yelp.ca/biz/jared-gibbons-surrey'] },
  { '@context': 'https://schema.org', '@type': 'Person', '@id': `${site}/#jared`, name: 'Jared Gibbons', jobTitle: 'REALTOR®', url: `${site}/about.html`,
    image: `${site}/img/Jared.webp`, worksFor: { '@type': 'Organization', name: 'Royal LePage Little Oak Realty' }, sameAs: ['https://ca.linkedin.com/in/jared-gibbons-96814591'] },
] : [];
const ogUrl = canonical;
const robotsContent = preview ? 'noindex, nofollow' : robots;
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Ownership checks carried over from the old site (D-233): Google Search Console and Pinterest. Public values, not secrets. -->
  <meta name="google-site-verification" content="CgqE26qFOHc49FhbnJO-qA0qac4IaeOquD3xgEIxnP8" />
  <meta name="p:domain_verify" content="91c3edc90807457f5f64250c3b56c1c0" />
  {!preview && <script async src="https://www.googletagmanager.com/gtag/js?id=G-7YQYX2KPBR"></script>}
  {!preview && <script is:inline>
    // Google Analytics 4 and Google Ads, the same accounts as the old site (D-234). Only on the launch build, never on the preview.
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-7YQYX2KPBR');
    gtag('config', 'AW-10817976788');
  </script>}
  <script is:inline>
    // Every form calls this after the lead is accepted. 'contact_us' is the event the old site sent (Google Ads conversion);
    // 'generate_lead' is GA4's own lead event. On the preview gtag is not loaded, so nothing is sent.
    window.jgLead = function (kind) { try { if (typeof gtag === 'function') { gtag('event', 'contact_us', { form: kind }); gtag('event', 'generate_lead', { form: kind }); } } catch (e) {} };
  </script>
  <title>{title}</title>
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {robotsContent && <meta name="robots" content={robotsContent} />}
  <link rel="preload" href="/fonts/montserrat-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  {description && <meta name="description" content={description} />}
  {ogTitle && <meta property="og:title" content={ogTitle} />}
  {ogDesc && <meta property="og:description" content={ogDesc} />}
  <meta property="og:image" content={shareImage} />
  {shareImage.endsWith('/img/og-default.jpg') && <meta property="og:image:width" content="1200" />}{shareImage.endsWith('/img/og-default.jpg') && <meta property="og:image:height" content="630" />}
  {shareImage.endsWith('/img/og-default.jpg') && <meta property="og:image:alt" content="Jared Gibbons, REALTOR® with Royal LePage Little Oak Realty, South Surrey, White Rock and Langley" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Jared Gibbons" />
  <meta property="og:locale" content="en_CA" />
  {ogUrl && <meta property="og:url" content={ogUrl} />}
  <meta name="twitter:card" content="summary_large_image" />
  {(ogTitle ?? title) && <meta name="twitter:title" content={ogTitle ?? title} />}
  {(ogDescription ?? description) && <meta name="twitter:description" content={ogDescription ?? description} />}
  <meta name="twitter:image" content={shareImage} />
  {[...entity, ...jsonld, ...crumbLd].map((j: any) => <script type="application/ld+json" set:html={JSON.stringify(j).replace(/</g, '\\u003c')} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {preview && <aside class="preview-banner" aria-label="Preview notice">Private working preview — pages are being rebuilt in stages, so a link may point to a page that is not built yet. Not indexed.</aside>}
  <Header current={current} brandHref={brandHref} />
  {crumbs.length > 1 && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol class="wrap">
        {crumbs.map((c: any, i: number) => i < crumbs.length - 1 ? <li><a href={c.href}>{c.name}</a></li> : <li aria-current="page">{c.name}</li>)}
      </ol>
    </nav>
  )}
  <slot />
  <Footer tagline={footerTagline} cell={footerCell} />
  <nav class="action-bar" aria-label="Quick actions">
    <a href="/map-search.html">Find a Home</a>
    <a href="/home-evaluation.html">Home Value</a>
    <a href="tel:604-928-1361" data-ev="call_jared">Call</a>
    <a href="sms:+16049281361" data-ev="text_jared" class="action-bar__text">Text</a>
  </nav>
  <script is:inline>
    // D-238: "Text" opens the phone's messages with the page in the first line, so Jared knows what they were reading.
    (function () {
      var t = document.querySelector('.action-bar__text'); if (!t) return;
      var page = (document.querySelector('h1') || {}).textContent || document.title.split('|')[0];
      page = String(page).replace(/\s+/g, ' ').trim().slice(0, 90);
      var body = 'Hi Jared, I\'m on your website about ' + page + '. ';
      t.href = 'sms:+16049281361' + (/iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent) ? '&' : '?') + 'body=' + encodeURIComponent(body);
      document.querySelectorAll('.action-bar [data-ev]').forEach(function (a) { a.addEventListener('click', function () { try { if (typeof gtag === 'function') gtag('event', a.dataset.ev, { page: location.pathname }); } catch (e) {} }); });
    })();
    // D-245: the bar is fixed over the whole page, so on short pages (and on first load, before
    // scrolling) it was covering buttons and fields that happened to land in its bottom strip.
    // Keep it off-screen until the visitor has scrolled a little, so nothing on the first screen
    // is ever hidden under it, and it never shows at all on a page too short to scroll.
    (function () {
      var bar = document.querySelector('.action-bar'); if (!bar) return;
      var shown = false;
      var onScroll = function () {
        var past = window.scrollY > 72;
        if (past !== shown) { shown = past; bar.classList.toggle('is-shown', shown); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
  {Astro.url.pathname.startsWith('/internal/blog/') && <SellerNudge />}
  <div class="read-progress" aria-hidden="true"><span></span></div>
  <a class="to-top" href="#main" aria-label="Back to top" hidden>↑</a>
  <script is:inline>
    // D-235: numbers count up as they scroll into view (stat cards, home rank stats, [data-count]); a reading bar and a
    // back-to-top button on long pages. The final figures are in the HTML (search engines and no-JS readers see them);
    // nothing moves for visitors who ask for reduced motion.
    (function () {
      var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      var els = document.querySelectorAll('.statcard__v, .rank__stats strong, [data-count]');
      if (!still && 'IntersectionObserver' in window && els.length) {
        var re = /^(\D*?)(\d{1,3}(?:,\d{3})+|\d+)(\.\d+)?(.*)$/;
        var jobs = [];
        els.forEach(function (el) {
          if (el.children.length) return;
          var txt = el.textContent.trim(); var m = txt.match(re);
          if (!m) return;
          var whole = +m[2].replace(/,/g, ''); var dec = m[3] ? m[3].length - 1 : 0; var val = whole + (m[3] ? +m[3] : 0);
          if (!m[1] && !m[4] && whole >= 1900 && whole <= 2100) return;   // a year, not a count
          if (val < 2) return;
          var fmt = function (v) { var s = dec ? v.toFixed(dec) : Math.round(v).toString(); if (m[2].indexOf(',') >= 0 || whole >= 10000) { var p = s.split('.'); p[0] = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ','); s = p.join('.'); } return m[1] + s + m[4]; };
          jobs.push({ el: el, val: val, fmt: fmt, txt: txt });
        });
        var run = function (j) {
          var t0 = performance.now(), dur = 1300;
          var step = function (t) { var k = Math.min(1, (t - t0) / dur); var e = 1 - Math.pow(1 - k, 3); j.el.textContent = k < 1 ? j.fmt(j.val * e) : j.txt; if (k < 1) requestAnimationFrame(step); };
          requestAnimationFrame(step);
        };
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); var j = e.target.__count; if (j) run(j); } }); }, { threshold: 0.4 });
        jobs.forEach(function (j) {
          var r = j.el.getBoundingClientRect();
          if (r.top < innerHeight && r.bottom > 0) return;   // already on screen at load: leave it
          j.el.__count = j; j.el.textContent = j.fmt(0); io.observe(j.el);
        });
      }
      var bar = document.querySelector('.read-progress span'), top = document.querySelector('.to-top');
      var long = function () { return document.documentElement.scrollHeight > innerHeight * 3; };
      var tick = false;
      var upd = function () {
        tick = false; var h = document.documentElement.scrollHeight - innerHeight; var y = scrollY;
        var on = long();
        if (bar) { bar.parentNode.style.display = on ? '' : 'none'; bar.style.transform = 'scaleX(' + (h > 0 ? Math.min(1, y / h) : 0) + ')'; }
        if (top) top.hidden = !(on && y > innerHeight * 1.5);
      };
      addEventListener('scroll', function () { if (!tick) { tick = true; requestAnimationFrame(upd); } }, { passive: true });
      addEventListener('resize', upd); upd();
    })();
  </script>
</body>
</html>
