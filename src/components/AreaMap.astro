---
// Neighbourhood map: every area filled, outlined and labelled; press an area for a popup that links to its page.
// Google Maps JavaScript API, loaded only when the map scrolls into view (keeps LCP and INP clean and keeps map loads, which are billed after 10,000 a month, to people who see it).
// Needs PUBLIC_GOOGLE_MAPS_KEY at build time (a browser key restricted to our domains; D-102). Without it the map says so and the link list still works.
// mode 'hub': all of the region's areas. mode 'area': only the current area, in a strong outline (neighbours are not drawn).
// Hub extras (D-103): areas that name a sold-12m sub-area are shaded by our own closed-sales figures (median price, price per sq ft, days on market; 5 sales minimum),
// with the same figures in a text table, and a click-to-load 3D flyover when the region has one.
import { validateRegion, flyoverFor, draftsBlockLaunch } from '../lib/areamap.js';
import { figures, TYPES, METRICS, MIN_SALES, fmt } from '../lib/choropleth.js';
import sold from '../data/sold/sold-12m.json';
const FILES = import.meta.glob('../data/maps/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const { region: slug, mode = 'hub', current = '' } = Astro.props as { region: string; mode?: 'hub' | 'area'; current?: string };
const region = FILES[`../data/maps/${slug}.json`];
if (!region) throw new Error(`AreaMap: no map data for ${slug}`);
const errs = validateRegion(region);
if (errs.length) throw new Error(`AreaMap ${slug}: ${errs.join('; ')}`);
const drafts = draftsBlockLaunch(region, import.meta.env.PUBLIC_PREVIEW, process.env.TEST_ALLOW_DRAFT_OUTLINES);
if (drafts.length) throw new Error(`AreaMap ${slug}: outlines still marked draft cannot ship at launch: ${drafts.join(', ')}`);
const areas = mode === 'area' ? region.areas.filter((a: any) => a.id === current) : region.areas;
if (mode === 'area' && !areas.length) throw new Error(`AreaMap ${slug}: no area ${current}`);
const figs: Record<string, any> = {};
if (mode === 'hub') for (const a of areas) {
  if (!a.sold) continue;
  const sub = (sold as any).sub[a.sold];
  if (!sub) throw new Error(`AreaMap ${slug}: ${a.id} points at "${a.sold}", which is not in sold-12m.json`);
  figs[a.id] = figures(sub);
}
const shaded = Object.values(figs).some((f: any) => Object.values(f).some(Boolean));
const rows = shaded ? areas.flatMap((a: any) => TYPES.filter(([g]) => figs[a.id]?.[g]).map(([g, label]) => ({ a, label, f: figs[a.id][g] }))) : [];
const noFig = shaded ? areas.filter((a: any) => !a.sold || !Object.values(figs[a.id] || {}).some(Boolean)) : [];
const key = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY || '';
const payload = JSON.stringify({ name: region.name, center: region.center, mode, areas: areas.map((a: any) => ({ id: a.id, name: a.name, href: a.href, group: !!a.group, rings: a.rings })), figs, types: TYPES, metrics: METRICS, minSales: MIN_SALES, flyover: mode === 'hub' ? flyoverFor(region) : null });
const window_ = (sold as any).meta.window;
---
<section class="areamap" aria-label={mode === 'area' ? `${areas[0].name} neighbourhood map` : `${region.name} neighbourhood map`}>
  {shaded && (
    <div class="areamap__ctrl" id="areamap-ctrl" hidden>
      <div><label for="areamap-type">Property type</label>
        <select id="areamap-type">{TYPES.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
      <div><label for="areamap-metric">Shade areas by</label>
        <select id="areamap-metric">{METRICS.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
    </div>
  )}
  <div class="areamap__map" data-key={key} data-map={payload} role="region" aria-label="Interactive map. The same areas are listed as links below the map.">
    <p class="areamap__note notice">{key ? 'The map loads when you scroll to it.' : 'The interactive map is not connected in the preview yet. The areas are listed below.'}</p>
  </div>
  {shaded && <ul class="areamap__legend" id="areamap-legend" aria-label="Map shading key" hidden></ul>}
  <p class="areamap__hint">Drag to move the map. Press an area to open its page.{shaded ? ` Shading uses our closed-sales figures for ${window_}; areas with fewer than ${MIN_SALES} sales of a type are left grey.` : ''}</p>
  <button type="button" class="btn areamap__fly" id="areamap-fly" hidden>View 3D flyover</button>
  {mode === 'hub' && (
    <nav aria-label={`${region.name} neighbourhoods`}>
      <ul class="areamap__list">{areas.map((a: any) => <li><a href={a.href}>{a.name}</a></li>)}</ul>
    </nav>
  )}
  {shaded && (
    <details class="areamap__data">
      <summary>Closed-sales figures behind the shading</summary>
      <table class="tbl">
        <caption>Closed sales, {window_}. Figures are medians for the area and property type; types with fewer than {MIN_SALES} sales are left out.</caption>
        <thead><tr><th scope="col">Area</th><th scope="col">Type</th><th scope="col">Sales</th><th scope="col">Median sold price</th><th scope="col">Median price per sq ft</th><th scope="col">Median days on market</th></tr></thead>
        <tbody>{rows.map(({ a, label, f }: any) => <tr><th scope="row"><a href={a.href}>{a.name}</a></th><td>{label}</td><td>{f.n}</td><td>{fmt('price', f.price)}</td><td>{fmt('ppsf', f.ppsf)}</td><td>{fmt('dom', f.dom)}</td></tr>)}</tbody>
      </table>
      {noFig.length > 0 && <p class="areamap__fine">Not enough closed sales for a figure: {noFig.map((a: any) => a.name).join(', ')}.</p>}
    </details>
  )}
</section>
<script>
  import { popupSpec, centroid, boundsOf } from '../lib/areamap.js';
  import { loadGoogle, onAuthFailure } from '../lib/gmaps.js';
  import { classify, rampColor, textOn, legend, fmt, fmtShort } from '../lib/choropleth.js';
  const host = document.querySelector('.areamap__map') as HTMLElement | null;
  if (host && host.dataset.key) {
    const key = host.dataset.key, data = JSON.parse(host.dataset.map || '{}');
    const shaded = Object.keys(data.figs || {}).length > 0;
    let started = false, map: any = null, g: any = null;
    const fail = (m: string) => { host.innerHTML = `<p class="areamap__note notice">${m}</p>`; };
    onAuthFailure(() => fail('The map could not load. The areas are listed below.'));
    const polys: { poly: any; a: any }[] = [];
    const labels = new Map<string, any>();
    const typeSel = document.getElementById('areamap-type') as HTMLSelectElement | null, metricSel = document.getElementById('areamap-metric') as HTMLSelectElement | null;
    const legendEl = document.getElementById('areamap-legend') as HTMLElement | null, ctrl = document.getElementById('areamap-ctrl') as HTMLElement | null;
    const only = data.mode === 'area';
    const valueOf = (a: any) => { const f = data.figs?.[a.id]?.[typeSel!.value]; return f ? f[metricSel!.value] : null; };

    const recolour = () => {
      if (!shaded || !typeSel || !metricSel) return;
      const m = metricSel.value;
      const vals = data.areas.map(valueOf).filter((v: any) => Number.isFinite(v));
      if (!vals.length) { legendEl!.replaceChildren(); const li = document.createElement('li'); li.textContent = `No area has ${data.minSales} or more closed sales of this type.`; legendEl!.appendChild(li); }
      const cls = vals.length ? classify(vals) : null;
      for (const { poly, a } of polys) {
        const v = valueOf(a);
        if (cls && Number.isFinite(v)) { const c = rampColor(cls.classOf(v), cls.k); poly.setOptions({ fillColor: c, fillOpacity: 0.88 }); poly.__fill = 0.88; }
        else { poly.setOptions({ fillColor: '#e3e3e3', fillOpacity: 0.5 }); poly.__fill = 0.5; }
      }
      for (const [id, lab] of labels) {
        const a = data.areas.find((x: any) => x.id === id), v = valueOf(a);
        const fill = cls && Number.isFinite(v) ? rampColor(cls.classOf(v), cls.k) : 'rgb(240,240,240)';
        lab.setStyle(textOn(fill), Number.isFinite(v) ? `${a.name}\n${fmtShort(m, v)}` : a.name);
      }
      if (cls) {
        legendEl!.replaceChildren();
        for (const row of legend(m, cls)) { const li = document.createElement('li'); const sw = document.createElement('span'); sw.className = 'areamap__sw'; sw.style.background = row.color; sw.setAttribute('aria-hidden', 'true'); li.append(sw, document.createTextNode(row.label)); legendEl!.appendChild(li); }
      }
      const li = document.createElement('li'); const sw = document.createElement('span'); sw.className = 'areamap__sw'; sw.style.background = '#e3e3e3'; sw.setAttribute('aria-hidden', 'true'); li.append(sw, document.createTextNode(`Fewer than ${data.minSales} sales`)); legendEl!.appendChild(li);
    };

    const start = async () => {
      if (started) return; started = true;
      try {
        g = await loadGoogle(key);
        const { Map, Polygon, InfoWindow } = await g.maps.importLibrary('maps');
        host.innerHTML = '';
        map = new Map(host, { center: data.center, zoom: 12, gestureHandling: 'cooperative', mapTypeControl: true, streetViewControl: true, fullscreenControl: true });
        const b = boundsOf(data.areas);
        map.fitBounds({ south: b.south, west: b.west, north: b.north, east: b.east }, 24);
        class Label extends g.maps.OverlayView {
          pos: any; text: string; div: HTMLElement | null = null;
          constructor(pos: any, text: string) { super(); this.pos = pos; this.text = text; }
          onAdd() { this.div = document.createElement('div'); this.div.className = 'areamap__label'; this.div.textContent = this.text; this.getPanes().floatPane.appendChild(this.div); }
          draw() { const p = this.getProjection().fromLatLngToDivPixel(this.pos); if (p && this.div) { this.div.style.left = p.x + 'px'; this.div.style.top = p.y + 'px'; } }
          onRemove() { this.div?.remove(); }
          setStyle(color: string, text: string) { this.text = text; if (this.div) { this.div.textContent = text; this.div.style.color = color; this.div.style.textShadow = color === '#ffffff' ? '0 0 3px #000,0 0 3px #000' : '0 0 3px #fff,0 0 3px #fff'; } }
        }
        const info = new InfoWindow();
        for (const a of data.areas) {
          const base = only ? { fillColor: '#ffffff', fillOpacity: 0.05, strokeColor: '#000000', strokeWeight: 4 } : { fillColor: '#d8cdb4', fillOpacity: 0.55, strokeColor: '#1a1a1a', strokeWeight: 2 };
          for (const ring of a.rings) {
            const poly = new Polygon({ map, paths: ring.map(([lat, lng]: number[]) => ({ lat, lng })), ...base, clickable: !only });
            (poly as any).__fill = base.fillOpacity;
            polys.push({ poly, a });
            if (only) continue;
            poly.addListener('mouseover', () => poly.setOptions({ fillOpacity: Math.min(1, ((poly as any).__fill || 0.55) + 0.12) }));
            poly.addListener('mouseout', () => poly.setOptions({ fillOpacity: (poly as any).__fill || 0.55 }));
            poly.addListener('click', (e: any) => {
              const sp = popupSpec(a, data.name), box = document.createElement('div');
              const h = document.createElement('strong'); h.textContent = sp.title; h.style.display = 'block';
              box.appendChild(h);
              if (shaded && typeSel && metricSel) {
                const f = data.figs?.[a.id]?.[typeSel.value], tl = data.types.find((t: any) => t[0] === typeSel.value)[1].toLowerCase();
                const p = document.createElement('p'); p.style.margin = '.35rem 0';
                p.textContent = f ? `${data.metrics.find((m: any) => m[0] === metricSel.value)[1]}, ${tl}: ${fmt(metricSel.value, f[metricSel.value])} (${f.n} closed sales)` : `Fewer than ${data.minSales} closed sales of ${tl} in the past 12 months.`;
                box.appendChild(p);
              }
              const l = document.createElement('a'); l.href = sp.href; l.textContent = sp.linkText; box.appendChild(l);
              info.setContent(box); info.setPosition(e.latLng); info.open({ map });
            });
          }
          const c = centroid(a.rings);
          if (c && !only) { const lab = new Label(new g.maps.LatLng(c[0], c[1]), a.name); lab.setMap(map); labels.set(a.id, lab); }
        }
        if (shaded && typeSel && metricSel) {
          // Start on the property type with the most shaded areas.
          let best = typeSel.value, bestN = -1;
          for (const [t] of data.types) { const n = data.areas.filter((a: any) => data.figs?.[a.id]?.[t]).length; if (n > bestN) { bestN = n; best = t; } }
          typeSel.value = best;
          ctrl!.hidden = false; legendEl!.hidden = false;
          typeSel.addEventListener('change', recolour); metricSel.addEventListener('change', recolour);
          recolour();
        }
        setupFlyover();
      } catch (e) { fail('The map could not load. The areas are listed below.'); }
    };

    // Click-to-load 3D flyover (photorealistic 3D, Maps JavaScript API "maps3d" library). Nothing 3D loads until the button is pressed.
    const setupFlyover = () => {
      const btn = document.getElementById('areamap-fly') as HTMLButtonElement | null;
      if (!btn || !data.flyover) return;
      btn.hidden = false;
      let el: any = null, showing3d = false, mapNodes: Node[] = [];
      btn.addEventListener('click', async () => {
        if (showing3d) { el?.remove(); mapNodes.forEach((n) => host.appendChild(n)); showing3d = false; btn.textContent = 'View 3D flyover'; if (map) g.maps.event.trigger(map, 'resize'); return; }
        btn.disabled = true; btn.textContent = 'Loading 3D…';
        try {
          const { Map3DElement } = await g.maps.importLibrary('maps3d');
          const f = data.flyover;
          el = new Map3DElement({ center: { lat: f.lat, lng: f.lng, altitude: f.altitude || 0 }, range: f.range, tilt: f.tilt ?? 55, heading: f.heading ?? 0, mode: 'HYBRID' });
          el.style.cssText = 'display:block;width:100%;height:100%';
          mapNodes = [...host.childNodes]; mapNodes.forEach((n) => host.removeChild(n)); host.appendChild(el);
          showing3d = true; btn.textContent = 'Back to the map';
        } catch { btn.textContent = 'View 3D flyover'; const p = document.createElement('p'); p.className = 'areamap__fine'; p.textContent = '3D view is not available right now.'; btn.insertAdjacentElement('afterend', p); }
        btn.disabled = false;
      });
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((x) => x.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '300px' });
      io.observe(host);
    } else start();
  }
</script>
<style is:global>
  .areamap{margin:var(--s5) 0}
  .areamap__ctrl{display:flex;flex-wrap:wrap;gap:var(--s4);margin-bottom:var(--s3)}
  .areamap__ctrl>div{display:grid;gap:.3rem}
  .areamap__ctrl label{font:700 .8125rem var(--f-head);letter-spacing:.04em}
  .areamap__ctrl select{min-height:2.75rem;border:1px solid var(--ink);border-radius:0;background:#fff;padding:.5rem .8rem;font:inherit}
  .areamap__map{height:min(70vh,36rem);min-height:20rem;background:var(--cream);border:1px solid var(--ink);position:relative}
  .areamap__note{margin:1rem}
  .areamap__hint,.areamap__fine{font-size:.8125rem;color:#444;margin:.5rem 0 0}
  .areamap__legend{list-style:none;display:flex;flex-wrap:wrap;gap:.35rem 1.25rem;padding:0;margin:var(--s3) 0 0;font-size:.8125rem}
  .areamap__legend li{display:flex;align-items:center;gap:.4rem}
  .areamap__sw{display:inline-block;width:1.1rem;height:1.1rem;border:1px solid #1a1a1a}
  .areamap__fly{margin-top:var(--s3)}
  .areamap__list{list-style:none;padding:0;margin:var(--s4) 0 0;display:grid;gap:.25rem 1.5rem;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr))}
  .areamap__data{margin-top:var(--s4)}
  .areamap__data summary{cursor:pointer;font-weight:700;min-height:2.75rem;display:flex;align-items:center}
  .areamap__label{position:absolute;transform:translate(-50%,-50%);pointer-events:none;font:800 .75rem/1.15 var(--f-head);text-transform:uppercase;letter-spacing:.04em;text-align:center;color:#111;text-shadow:0 0 3px #fff,0 0 3px #fff;white-space:pre}
</style>
