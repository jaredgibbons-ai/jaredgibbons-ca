---
import { isPreview } from '../lib/preview';
// Neighbourhood map: every area filled, outlined and labelled; press an area for a popup that links to its page.
// Google Maps JavaScript API, loaded only when the map scrolls into view (keeps LCP and INP clean and keeps map loads, which are billed after 10,000 a month, to people who see it).
// Needs PUBLIC_GOOGLE_MAPS_KEY at build time (a browser key restricted to our domains; D-102). Without it the map says so and the link list still works.
// mode 'hub': all of the region's areas. mode 'area': only the current area, in a strong outline (neighbours are not drawn).
// Hub extras (D-103): areas that name a sold-12m sub-area are shaded by our own closed-sales figures (median price, price per sq ft, days on market; 5 sales minimum),
// with the same figures in a text table, and a click-to-load 3D flyover when the region has one.
import { validateRegion, flyoverFor, draftsBlockLaunch } from '../lib/areamap.js';
import { NEARBY } from '../lib/nearby-places.js';
import { isHeldHref } from '../lib/launch';
import { figures, TYPES, METRICS, MIN_SALES, fmt } from '../lib/choropleth.js';
import sold from '../data/sold/sold-12m.json';
const FILES = import.meta.glob('../data/maps/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const { region: slug, mode = 'hub', current = '' } = Astro.props as { region: string; mode?: 'hub' | 'area'; current?: string };
const region = FILES[`../data/maps/${slug}.json`];
if (!region) throw new Error(`AreaMap: no map data for ${slug}`);
const errs = validateRegion(region);
if (errs.length) throw new Error(`AreaMap ${slug}: ${errs.join('; ')}`);
const drafts = draftsBlockLaunch(region, import.meta.env.PUBLIC_PREVIEW, process.env.TEST_ALLOW_DRAFT_OUTLINES);
if (drafts.length) throw new Error(`AreaMap ${slug}: outlines still marked draft cannot ship at launch: ${drafts.join(', ')}`);
const areas = mode === 'area' ? region.areas.filter((a: any) => current.split(',').includes(a.id)) : region.areas;
if (mode === 'area' && !areas.length) throw new Error(`AreaMap ${slug}: no area ${current}`);
const figs: Record<string, any> = {};
if (mode === 'hub') for (const a of areas) {
  if (!a.sold) continue;
  const sub = (sold as any).sub[a.sold];
  if (!sub) throw new Error(`AreaMap ${slug}: ${a.id} points at "${a.sold}", which is not in sold-12m.json`);
  figs[a.id] = figures(sub);
}
const shaded = Object.values(figs).some((f: any) => Object.values(f).some(Boolean));
const rows = shaded ? areas.flatMap((a: any) => TYPES.filter(([g]) => figs[a.id]?.[g]).map(([g, label]) => ({ a, label, f: figs[a.id][g] }))) : [];
const noFig = shaded ? areas.filter((a: any) => !a.sold || !Object.values(figs[a.id] || {}).some(Boolean)) : [];
const key = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY || '';
// Without the key the launch build shows no map box (and no "not connected" note); the area links below still work.
const showMap = !!key || isPreview;
const payload = JSON.stringify({ name: region.name, center: region.center, mode, areas: areas.map((a: any) => ({ id: a.id, name: a.name, href: isHeldHref(a.href) ? '' : a.href, group: !!a.group, rings: a.rings })), figs, types: TYPES, metrics: METRICS, minSales: MIN_SALES, flyover: mode === 'hub' ? flyoverFor(region) : null });
const window_ = (sold as any).meta.window;
---
{(showMap || mode === 'hub') && (
<section class="areamap" aria-label={mode === 'area' ? `${areas[0].name} neighbourhood map` : `${region.name} neighbourhood map`}>
  {showMap && <Fragment>
  {shaded && (
    <div class="areamap__ctrl" id="areamap-ctrl" hidden>
      <div><label for="areamap-type">Property type</label>
        <select id="areamap-type">{TYPES.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
      <div><label for="areamap-metric">Shade areas by</label>
        <select id="areamap-metric">{METRICS.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
    </div>
  )}
  <div class="areamap__map" data-key={key} data-map={payload} role="region" aria-label="Interactive map. The same areas are listed as links below the map.">
    <p class="areamap__note notice">{key ? 'The map loads when you scroll to it.' : 'The interactive map is not connected in the preview yet. The areas are listed below.'}</p>
  </div>
  {shaded && <ul class="areamap__legend" id="areamap-legend" aria-label="Map shading key" hidden></ul>}
  <p class="areamap__hint">Drag to move the map. Zoom in to show the names of smaller areas. Press an area to open its page.{shaded ? ` Shading uses our closed-sales figures for ${window_}; areas with fewer than ${MIN_SALES} sales of a type are left grey.` : ''}</p>
  <div class="areamap__near" id="areamap-near" role="group" aria-labelledby="areamap-near-h" hidden>
    <p class="areamap__nearh" id="areamap-near-h">Show nearby places</p>
    {NEARBY.map((c) => <button type="button" class="btn btn--ghost areamap__nb" data-cat={c.id} aria-pressed="false">{c.label}</button>)}
  </div>
  <p class="areamap__fine" id="areamap-near-note" aria-live="polite" hidden></p>
  <ul class="areamap__nearlist" id="areamap-near-list" aria-label="Nearby places shown on the map" hidden></ul>
  <button type="button" class="btn areamap__fly" id="areamap-fly" hidden>View 3D flyover</button>
  </Fragment>}
  {mode === 'hub' && (
    <nav aria-label={`${region.name} neighbourhoods`}>
      <ul class="areamap__list">{areas.map((a: any) => <li>{isHeldHref(a.href) ? a.name : <a href={a.href}>{a.name}</a>}</li>)}</ul>
    </nav>
  )}
  {shaded && (
    <details class="areamap__data">
      <summary>Closed-sales figures behind the shading</summary>
      <div class="areamap__tbl" tabindex="0" role="region" aria-label={`Closed-sales figures, ${region.name}`}>
      <table class="tbl">
        <caption>Closed sales, {window_}. Figures are medians for the area and property type; types with fewer than {MIN_SALES} sales are left out.</caption>
        <thead><tr><th scope="col">Area</th><th scope="col">Type</th><th scope="col">Sales</th><th scope="col">Median sold price</th><th scope="col">Median price per sq ft</th><th scope="col">Median days on market</th></tr></thead>
        <tbody>{rows.map(({ a, label, f }: any) => <tr><th scope="row">{isHeldHref(a.href) ? a.name : <a href={a.href}>{a.name}</a>}</th><td>{label}</td><td>{f.n}</td><td>{fmt('price', f.price)}</td><td>{fmt('ppsf', f.ppsf)}</td><td>{fmt('dom', f.dom)}</td></tr>)}</tbody>
      </table>
      </div>
      {noFig.length > 0 && <p class="areamap__fine">Not enough closed sales for a figure: {noFig.map((a: any) => a.name).join(', ')}.</p>}
    </details>
  )}
</section>
)}
<script>
  import { popupSpec, centroid, boundsOf } from '../lib/areamap.js';
  import { loadGoogle, onAuthFailure } from '../lib/gmaps.js';
  import { classify, rampColor, textOn, legend, fmt, fmtShort } from '../lib/choropleth.js';
  import { MAP_STYLE } from '../lib/map-style.js';
  import { NEARBY, nearbyRequest, radiusFor, distanceM, describePlaces, kmLabel } from '../lib/nearby-places.js';
  const host = document.querySelector('.areamap__map') as HTMLElement | null;
  if (host && host.dataset.key) {
    const key = host.dataset.key, data = JSON.parse(host.dataset.map || '{}');
    const shaded = Object.keys(data.figs || {}).length > 0;
    let started = false, map: any = null, g: any = null, relayout: () => void = () => {};
    const fail = (m: string) => { host.innerHTML = `<p class="areamap__note notice">${m}</p>`; };
    onAuthFailure(() => fail('The map could not load. The areas are listed below.'));
    const polys: { poly: any; a: any }[] = [];
    const labels = new Map<string, any>();
    const typeSel = document.getElementById('areamap-type') as HTMLSelectElement | null, metricSel = document.getElementById('areamap-metric') as HTMLSelectElement | null;
    const legendEl = document.getElementById('areamap-legend') as HTMLElement | null, ctrl = document.getElementById('areamap-ctrl') as HTMLElement | null;
    const only = data.mode === 'area';
    const valueOf = (a: any) => { const f = data.figs?.[a.id]?.[typeSel!.value]; return f ? f[metricSel!.value] : null; };

    const recolour = () => {
      if (!shaded || !typeSel || !metricSel) return;
      const m = metricSel.value;
      const vals = data.areas.map(valueOf).filter((v: any) => Number.isFinite(v));
      if (!vals.length) { legendEl!.replaceChildren(); const li = document.createElement('li'); li.textContent = `No area has ${data.minSales} or more closed sales of this type.`; legendEl!.appendChild(li); }
      const cls = vals.length ? classify(vals) : null;
      for (const { poly, a } of polys) {
        const v = valueOf(a);
        if (cls && Number.isFinite(v)) { const c = rampColor(cls.classOf(v), cls.k); poly.setOptions({ fillColor: c, fillOpacity: 0.88 }); poly.__fill = 0.88; }
        else { poly.setOptions({ fillColor: '#e3e3e3', fillOpacity: 0.5 }); poly.__fill = 0.5; }
      }
      for (const [id, lab] of labels) {
        const a = data.areas.find((x: any) => x.id === id), v = valueOf(a);
        const fill = cls && Number.isFinite(v) ? rampColor(cls.classOf(v), cls.k) : 'rgb(240,240,240)';
        lab.setStyle(textOn(fill), Number.isFinite(v) ? fmtShort(m, v) : '');
      }
      if (cls) {
        legendEl!.replaceChildren();
        for (const row of legend(m, cls)) { const li = document.createElement('li'); const sw = document.createElement('span'); sw.className = 'areamap__sw'; sw.style.background = row.color; sw.setAttribute('aria-hidden', 'true'); li.append(sw, document.createTextNode(row.label)); legendEl!.appendChild(li); }
      }
      const li = document.createElement('li'); const sw = document.createElement('span'); sw.className = 'areamap__sw'; sw.style.background = '#e3e3e3'; sw.setAttribute('aria-hidden', 'true'); li.append(sw, document.createTextNode(`Fewer than ${data.minSales} sales`)); legendEl!.appendChild(li);
      relayout();
    };

    const start = async () => {
      if (started) return; started = true;
      try {
        g = await loadGoogle(key);
        const { Map, Polygon, InfoWindow } = await g.maps.importLibrary('maps');
        host.innerHTML = '';
        map = new Map(host, { center: data.center, zoom: 12, styles: MAP_STYLE, gestureHandling: 'cooperative', mapTypeControl: true, streetViewControl: true, fullscreenControl: true });
        const b = boundsOf(data.areas);
        map.fitBounds({ south: b.south, west: b.west, north: b.north, east: b.east }, 24);
        // Area name labels: sized and wrapped to fit inside each area's outline at the current zoom, so every name sits in its own area.
        class Label extends g.maps.OverlayView {
          pos: any; name: string; sub: string; box: any; div: HTMLElement | null = null; color = '#111111'; fits = true; size = 0;
          constructor(pos: any, name: string, box: any) { super(); this.pos = pos; this.name = name; this.sub = ''; this.box = box; }
          onAdd() { this.div = document.createElement('div'); this.div.className = 'areamap__label'; this.getPanes().floatPane.appendChild(this.div); }
          wrap(max: number): string[] {
            const out: string[] = []; let line = '';
            for (const w of this.name.split(/\s+/)) { if (line && (line + ' ' + w).length > max) { out.push(line); line = w; } else line = line ? line + ' ' + w : w; }
            if (line) out.push(line); return out;
          }
          draw() {
            const pr = this.getProjection(); if (!pr || !this.div) return;
            const p = pr.fromLatLngToDivPixel(this.pos); if (!p) return;
            const sw = pr.fromLatLngToDivPixel(new g.maps.LatLng(this.box.south, this.box.west)), ne = pr.fromLatLngToDivPixel(new g.maps.LatLng(this.box.north, this.box.east));
            const w = Math.abs(ne.x - sw.x) * 0.9, h = Math.abs(sw.y - ne.y) * 0.85;
            // 13px down to 10px (smaller is unreadable): a name that does not fit its area at this zoom is hidden until the reader zooms in, instead of piling over its neighbours.
            let fs = 13, lines: string[] = [this.name]; this.fits = false;
            for (; fs >= 10; fs -= 1) {
              const per = Math.max(7, Math.floor(w / (fs * 0.68)));
              lines = this.wrap(per);
              const lw = Math.max(...lines.map((l) => l.length)) * fs * 0.68, lh = (lines.length + (this.sub ? 1 : 0)) * fs * 1.2;
              if (lw <= w && lh <= h) { this.fits = true; break; }
            }
            this.size = w * h;
            this.div.style.display = this.fits ? '' : 'none';
            this.div.style.fontSize = Math.max(fs, 10) + 'px';
            this.div.textContent = lines.join('\n') + (this.sub ? '\n' + this.sub : '');
            this.div.style.left = p.x + 'px'; this.div.style.top = p.y + 'px';
          }
          onRemove() { this.div?.remove(); }
          setStyle(color: string, sub: string) {
            this.sub = sub; this.color = color;
            if (this.div) { this.div.style.color = color; this.div.style.textShadow = color === '#ffffff' ? '0 0 3px #000,0 0 3px #000,0 0 6px #000' : '0 0 3px #fff,0 0 3px #fff,0 0 6px #fff'; this.draw(); }
          }
        }
        const info = new InfoWindow();
        for (const a of data.areas) {
          const base = only ? { fillColor: '#ffffff', fillOpacity: 0.05, strokeColor: '#000000', strokeWeight: 4 } : { fillColor: '#d8cdb4', fillOpacity: 0.55, strokeColor: '#1a1a1a', strokeWeight: 2 };
          for (const ring of a.rings) {
            const poly = new Polygon({ map, paths: ring.map(([lat, lng]: number[]) => ({ lat, lng })), ...base, clickable: !only });
            (poly as any).__fill = base.fillOpacity;
            polys.push({ poly, a });
            if (only) continue;
            poly.addListener('mouseover', () => poly.setOptions({ fillOpacity: Math.min(1, ((poly as any).__fill || 0.55) + 0.12) }));
            poly.addListener('mouseout', () => poly.setOptions({ fillOpacity: (poly as any).__fill || 0.55 }));
            poly.addListener('click', (e: any) => {
              const sp = popupSpec(a, data.name), box = document.createElement('div');
              const h = document.createElement('strong'); h.textContent = sp.title; h.style.display = 'block';
              box.appendChild(h);
              if (shaded && typeSel && metricSel) {
                const f = data.figs?.[a.id]?.[typeSel.value], tl = data.types.find((t: any) => t[0] === typeSel.value)[1].toLowerCase();
                const p = document.createElement('p'); p.style.margin = '.35rem 0';
                p.textContent = f ? `${data.metrics.find((m: any) => m[0] === metricSel.value)[1]}, ${tl}: ${fmt(metricSel.value, f[metricSel.value])} (${f.n} closed sales)` : `Fewer than ${data.minSales} closed sales of ${tl} in the past 12 months.`;
                box.appendChild(p);
              }
              if (sp.href) { const l = document.createElement('a'); l.href = sp.href; l.textContent = sp.linkText; box.appendChild(l); }
              info.setContent(box); info.setPosition(e.latLng); info.open({ map });
            });
          }
          const c = centroid(a.rings);
          if (c && !only) { const lab = new Label(new g.maps.LatLng(c[0], c[1]), a.name, boundsOf([a])); lab.setMap(map); labels.set(a.id, lab); }
        }
        // Declutter: biggest areas win; a name that would overlap one already placed stays hidden until the map is zoomed in.
        const declutter = () => {
          const placed: DOMRect[] = [];
          for (const lab of [...labels.values()].sort((x: any, y: any) => y.size - x.size)) {
            if (!lab.div || !lab.fits) continue;
            const r = lab.div.getBoundingClientRect(), pad = 3;
            const hit = placed.some((q) => r.left < q.right + pad && r.right + pad > q.left && r.top < q.bottom + pad && r.bottom + pad > q.top);
            if (hit) lab.div.style.display = 'none'; else placed.push(r);
          }
        };
        if (!only) g.maps.event.addListener(map, 'idle', () => { for (const lab of labels.values()) lab.draw(); declutter(); });
        relayout = () => { for (const lab of labels.values()) lab.draw(); declutter(); };
        // Hover name for areas whose label is hidden at this zoom.
        const tip = document.createElement('div'); tip.className = 'areamap__tip'; tip.hidden = true; host.appendChild(tip);
        for (const { poly, a } of polys) {
          if (only) continue;
          poly.addListener('mousemove', (e: any) => {
            const lab = labels.get(a.id); if (!lab || (lab.div && lab.div.style.display !== 'none')) { tip.hidden = true; return; }
            tip.textContent = lab.name + (lab.sub ? ' ' + lab.sub : ''); tip.hidden = false;
            const ev = e.domEvent as MouseEvent, hb = host.getBoundingClientRect();
            tip.style.left = (ev.clientX - hb.left + 12) + 'px'; tip.style.top = (ev.clientY - hb.top + 14) + 'px';
          });
          poly.addListener('mouseout', () => { tip.hidden = true; });
        }
        if (shaded && typeSel && metricSel) {
          // Start on the property type with the most shaded areas.
          let best = typeSel.value, bestN = -1;
          for (const [t] of data.types) { const n = data.areas.filter((a: any) => data.figs?.[a.id]?.[t]).length; if (n > bestN) { bestN = n; best = t; } }
          typeSel.value = best;
          ctrl!.hidden = false; legendEl!.hidden = false;
          typeSel.addEventListener('change', recolour); metricSel.addEventListener('change', recolour);
          recolour();
        }
        setupFlyover();
        setupNearby();
      } catch (e) { fail('The map could not load. The areas are listed below.'); }
    };

    // Click-to-load 3D flyover (photorealistic 3D, Maps JavaScript API "maps3d" library). Nothing 3D loads until the button is pressed.
    const setupFlyover = () => {
      const btn = document.getElementById('areamap-fly') as HTMLButtonElement | null;
      if (!btn || !data.flyover) return;
      btn.hidden = false;
      let el: any = null, showing3d = false, mapNodes: Node[] = [];
      btn.addEventListener('click', async () => {
        if (showing3d) { el?.remove(); mapNodes.forEach((n) => host.appendChild(n)); showing3d = false; if (nearEl) nearEl.hidden = false; btn.textContent = 'View 3D flyover'; if (map) g.maps.event.trigger(map, 'resize'); return; }
        btn.disabled = true; btn.textContent = 'Loading 3D…';
        try {
          const { Map3DElement } = await g.maps.importLibrary('maps3d');
          const f = data.flyover;
          el = new Map3DElement({ center: { lat: f.lat, lng: f.lng, altitude: f.altitude || 0 }, range: f.range, tilt: f.tilt ?? 55, heading: f.heading ?? 0, mode: 'HYBRID' });
          el.style.cssText = 'display:block;width:100%;height:100%';
          mapNodes = [...host.childNodes]; mapNodes.forEach((n) => host.removeChild(n)); host.appendChild(el);
          showing3d = true; if (nearEl) nearEl.hidden = true; btn.textContent = 'Back to the map';
        } catch { btn.textContent = 'View 3D flyover'; const p = document.createElement('p'); p.className = 'areamap__fine'; p.textContent = '3D view is not available right now.'; btn.insertAdjacentElement('afterend', p); }
        btn.disabled = false;
      });
    };

    // Opt-in nearby places: nothing is requested until a button is pressed. Each press runs one Nearby Search (name and position only) around the middle of the visible map.
    // Results stay in this page's memory only; pressing a pressed button clears its pins.
    const nearEl = document.getElementById('areamap-near') as HTMLElement | null;
    const setupNearby = () => {
      const noteEl = document.getElementById('areamap-near-note') as HTMLElement | null, listEl = document.getElementById('areamap-near-list') as HTMLElement | null;
      if (!nearEl || !noteEl || !listEl) return;
      nearEl.hidden = false;
      const iw = new g.maps.InfoWindow();
      class Pin extends g.maps.OverlayView {
        pos: any; letter: string; name: string; div: HTMLElement | null = null;
        constructor(pos: any, letter: string, name: string) { super(); this.pos = pos; this.letter = letter; this.name = name; }
        onAdd() {
          this.div = document.createElement('div'); this.div.className = 'areamap__pin'; this.div.textContent = this.letter; this.div.title = this.name;
          this.div.addEventListener('click', (e) => { e.stopPropagation(); const b = document.createElement('strong'); b.textContent = this.name; iw.setContent(b); iw.setPosition(this.pos); iw.open({ map }); });
          this.getPanes().overlayMouseTarget.appendChild(this.div);
        }
        draw() { const p = this.getProjection().fromLatLngToDivPixel(this.pos); if (p && this.div) { this.div.style.left = p.x + 'px'; this.div.style.top = p.y + 'px'; } }
        onRemove() { this.div?.remove(); }
      }
      const shown = new Map<string, { pins: any[]; rows: any[]; radius: number }>();
      const render = () => {
        for (const n of [...listEl.children]) n.remove();
        const all = [...shown.values()].flatMap((v) => v.rows).sort((a, b) => a.m - b.m);
        for (const r of all) { const li = document.createElement('li'); li.textContent = `${r.name} (${r.label}, ${kmLabel(r.m)} from the middle of the map)`; listEl.appendChild(li); }
        listEl.hidden = !all.length;
        const parts = [...shown.entries()].map(([id, v]) => `${NEARBY.find((c) => c.id === id)!.label.toLowerCase()}: ${v.rows.length ? v.rows.length : 'none found'}`);
        const radius = [...shown.values()][0]?.radius;
        noteEl.hidden = !shown.size;
        noteEl.textContent = shown.size ? `Within about ${kmLabel(radius)} of the middle of the map when you pressed (${parts.join('; ')}). Places data from Google Maps, shown live and not stored. Move the map, then press a button off and on to search the new view.` : '';
      };
      const clear = (id: string) => { const v = shown.get(id); if (!v) return; v.pins.forEach((p) => p.setMap(null)); shown.delete(id); };
      nearEl.querySelectorAll<HTMLButtonElement>('.areamap__nb').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const cat = NEARBY.find((c) => c.id === btn.dataset.cat)!;
          if (btn.getAttribute('aria-pressed') === 'true') { clear(cat.id); btn.setAttribute('aria-pressed', 'false'); render(); return; }
          btn.disabled = true;
          try {
            const c = map.getCenter(), bnd = map.getBounds();
            const center = { lat: c.lat(), lng: c.lng() };
            const ne = bnd.getNorthEast(), sw = bnd.getSouthWest();
            const radius = radiusFor(distanceM({ lat: center.lat, lng: sw.lng() }, { lat: center.lat, lng: ne.lng() }), distanceM({ lat: sw.lat(), lng: center.lng }, { lat: ne.lat(), lng: center.lng }));
            const { Place } = await g.maps.importLibrary('places');
            const { places } = await Place.searchNearby(nearbyRequest(cat, center, radius));
            clear(cat.id);
            const rows = describePlaces(places, cat, center);
            const pins = rows.map((r) => { const pin = new Pin(new g.maps.LatLng(r.lat, r.lng), cat.pin, r.name); pin.setMap(map); return pin; });
            shown.set(cat.id, { pins, rows, radius });
            btn.setAttribute('aria-pressed', 'true'); render();
          } catch { noteEl.hidden = false; noteEl.textContent = 'Nearby places are not available right now.'; }
          btn.disabled = false;
        });
      });
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((x) => x.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '300px' });
      io.observe(host);
    } else start();
  }
</script>
<style is:global>
  .areamap{margin:var(--s5) 0}
  .areamap__ctrl{display:flex;flex-wrap:wrap;gap:var(--s4);margin-bottom:var(--s3)}
  .areamap__ctrl>div{display:grid;gap:.3rem}
