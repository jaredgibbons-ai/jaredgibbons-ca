---
// Inline run of archive text fragments and links, re-joined into one sentence.
// Wording is exactly as archived; only spacing around punctuation is normalised.
const { parts = [] } = Astro.props;
const local = (h: string) => h.replace(/^https:\/\/jaredgibbons\.ca(?=\/|$)/, '') || '/';
// archive text often has a stray space before punctuation inside one fragment ("price reduction .", "informative , helpful"); remove it
const clean = (t: string) => String(t).replace(/\s+([,.;:!?])(?=\s|$)/g, '$1');
const gap = (prev: string, cur: string) => (/^[,.;:!?)\]”’]/.test(cur) || /[(\[“‘]$/.test(prev)) ? '' : ' ';
---
{parts.map((p: any, i: number) => (
  <Fragment>{i > 0 ? gap(parts[i - 1].t, p.t) : ''}{p.h ? <a href={local(p.h)}>{clean(p.t)}</a> : p.lead ? <strong>{clean(p.t)}</strong> : clean(p.t)}</Fragment>
))}
