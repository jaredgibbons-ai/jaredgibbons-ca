---
// Inline run of archive text fragments and links, re-joined into one sentence.
// Wording is exactly as archived; only spacing around punctuation is normalised.
import { isHeldHref } from '../lib/launch';
import { sourceInfo } from '../lib/sources';
import SOURCE_REPL from '../data/source-replacements.json';
const { parts: raw = [] } = Astro.props;
// Links to other agents' pages that reach a list outside a "Sources" section still get the D-204 swap (developer or government page,
// or a plain line), so no other agent is named as a source anywhere (site check 2026-11-18, D-359).
const normUrl = (u: string) => String(u).trim().replace(/^https?:\/\/(www\.|embed\.)?/i, '').split('#')[0].replace(/\/+$/, '').toLowerCase();
const REPL = SOURCE_REPL as Record<string, { items?: any[]; text?: string; drop?: boolean }>;
const parts = (raw as any[]).flatMap((p: any) => {
  const r = p?.h ? REPL[normUrl(p.h)] : undefined;
  if (!r) return [p];
  if (r.drop) return [];
  if (r.text) return [{ t: r.text }];
  return (r.items || []).slice(0, 1).map((x: any) => ({ ...x }));
});
const local = (h: string) => h.replace(/^https:\/\/jaredgibbons\.ca(?=\/|$)/, '') || '/';
// archive text often has a stray space before punctuation inside one fragment ("price reduction .", "informative , helpful"); remove it
const clean = (t: string) => String(t).replace(/\s+([,.;:!?])(?=\s|$)/g, '$1');
// Source links whose text is still "host · page slug" (D-221 replaced raw URLs that way) read as "Publisher: Title" (D-230).
const label = (p: any) => {
  if (!p.h || !/^[\w.-]+\.[a-z]{2,}(?::\d+)? · /i.test(p.t)) return clean(p.t);
  const n = /\s*\((\d{1,2})\)\s*$/.exec(p.t); const s = sourceInfo(p.t, p.h);
  return `${s.pub}: ${s.title}${s.kind === 'PDF' ? ' (PDF)' : ''}${n ? ` (${n[1]})` : ''}`;
};
const gap = (prev: string, cur: string) => (/^[,.;:!?)\]”’]/.test(cur) || /[(\[“‘]$/.test(prev)) ? '' : ' ';
---
{parts.map((p: any, i: number) => (
  <Fragment>{i > 0 ? gap(parts[i - 1].t, p.t) : ''}{p.h && !isHeldHref(p.h) ? <a href={local(p.h)}>{label(p)}</a> : p.lead ? <strong>{clean(p.t)}</strong> : clean(p.t)}</Fragment>
))}
