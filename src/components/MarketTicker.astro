---
// Home-page market strip (D-236): the latest month's Fraser Valley Real Estate Board benchmark prices, scrolling.
// Data: the newest src/data/market/YYYY-MM.json (the monthly FVREB statistics package Jared supplies). Each area links to
// its market-stats page. Static list for reduced motion; the moving copy is aria-hidden so screen readers hear it once.
const files = import.meta.glob('../data/market/[0-9][0-9][0-9][0-9]-[0-9][0-9].json', { eager: true }) as Record<string, any>;
const latest = Object.keys(files).sort().pop()!;
const data = (files[latest] as any).default ?? files[latest];
const S = data.fvreb.summary;
const [y, m] = String(data.month).split('-').map(Number);
const monthName = new Date(Date.UTC(y, m - 1, 15)).toLocaleString('en-CA', { month: 'long', timeZone: 'UTC' });
const AREAS: [string, string, string][] = [
  ['White Rock / South Surrey', 'South Surrey & White Rock', '/south-surrey-white-rock-real-estate-market-stats.html'],
  ['Langley', 'Langley', '/langley-real-estate-market-stats.html'],
  ['City of Surrey - Combined', 'Surrey', '/surrey-real-estate-market-stats.html'],
  ['Surrey - Cloverdale', 'Cloverdale', '/cloverdale-real-estate-market-stats.html'],
  ['Abbotsford', 'Abbotsford', '/abbotsford-real-estate-market-stats.html'],
  ['Mission', 'Mission', '/mission-real-estate-market-stats.html'],
  ['Delta - North', 'North Delta', '/delta-real-estate-market-stats.html'],
];
const TYPES: [string, string][] = [['detached', 'Detached'], ['townhouse', 'Townhome'], ['apartment', 'Condo']];
const money = (v: number) => v >= 1e6 ? `$${(v / 1e6).toFixed(2).replace(/0$/, '')}M` : `$${Math.round(v / 1000)}K`;
const items = AREAS.filter(([k]) => S[k]).map(([k, name, href]) => {
  const parts = TYPES.filter(([t]) => S[k][t]?.benchmark?.now).map(([t, label]) => {
    const b = S[k][t].benchmark; const c = Number(b.chg_year);
    return { label, price: money(b.now), chg: isFinite(c) ? c : null };
  });
  const sales = TYPES.reduce((a, [t]) => a + (Number(S[k][t]?.sales?.now) || 0), 0);
  return { name, href, parts, sales };
}).filter((x) => x.parts.length);
---
{items.length > 0 && (
  <section class="mt" aria-label={`${monthName} ${y} benchmark prices, Fraser Valley Real Estate Board`}>
    <div class="mt__inner">
      <a class="mt__label" href="/fraser-valley-market-stats.html">{`${monthName} ${y}`} <span>Benchmark prices</span></a>
      <div class="mt__viewport">
        <ul class="mt__list">
          {[0, 1].map((copy) => items.map((it) => (
            <li class="mt__item" aria-hidden={copy ? 'true' : undefined}>
              <a href={it.href} tabindex={copy ? -1 : undefined}><strong>{it.name}</strong></a>
              {it.parts.map((p) => <span class="mt__p">{`${p.label} ${p.price}`}{p.chg !== null && <em class={p.chg < 0 ? 'dn' : 'up'}><span aria-hidden="true">{p.chg < 0 ? ' ▼' : ' ▲'}</span><span class="sr-only">{p.chg < 0 ? ' down' : ' up'}</span>{Math.abs(p.chg).toFixed(1)}%</em>}</span>)}
              {it.sales > 0 && <span class="mt__p">{`${it.sales} sold`}</span>}
            </li>
          )))}
        </ul>
      </div>
    </div>
    <p class="mt__src">{`Source: Fraser Valley Real Estate Board, ${monthName} ${y}. Change is year over year.`}</p>
  </section>
)}
<style>
  .mt{background:var(--ink);color:#fff;border-block:1px solid #fff}
  .mt__inner{display:flex;align-items:stretch}
  .mt__label{flex:0 0 auto;display:flex;flex-direction:column;justify-content:center;padding:.6rem 1rem;background:#fff;color:var(--ink);text-decoration:none;font:800 .8125rem/1.1 var(--f-head);letter-spacing:.06em;text-transform:uppercase;z-index:1}
  .mt__label span{font-weight:600;font-size:.625rem;letter-spacing:.16em;margin-top:.15rem}
  .mt__viewport{flex:1;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 3%,#000 97%,transparent);mask-image:linear-gradient(90deg,transparent,#000 3%,#000 97%,transparent)}
  .mt__list{display:flex;width:max-content;margin:0;padding:0;list-style:none;animation:mt-scroll 70s linear infinite}
  .mt:hover .mt__list,.mt:focus-within .mt__list{animation-play-state:paused}
  .mt__item{display:flex;align-items:center;gap:.9rem;padding:.7rem 1.6rem;white-space:nowrap;font:600 .8125rem/1.2 var(--f-head);letter-spacing:.03em;border-right:1px solid #444}
  .mt__item a{color:#fff;text-decoration:none}
  .mt__item a:hover strong{text-decoration:underline}
  .mt__item strong{font-weight:800;text-transform:uppercase;letter-spacing:.08em}
  .mt__p em{font-style:normal;margin-left:.15rem;color:#c8c8c8}
  .mt__src{margin:0;padding:.3rem 1rem;font:500 .6875rem/1.3 var(--f-body, inherit);color:#bdbdbd;border-top:1px solid #333}
  @keyframes mt-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.mt__list{animation:none;width:auto;flex-wrap:nowrap}.mt__viewport{overflow-x:auto;-webkit-mask-image:none;mask-image:none}.mt__item[aria-hidden]{display:none}}
  @media (max-width:520px){.mt__label{padding:.5rem .7rem;font-size:.6875rem}.mt__item{padding:.6rem 1.1rem}}
</style>
