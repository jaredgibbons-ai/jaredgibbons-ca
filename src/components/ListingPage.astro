<script>
  // Video: swap the photo for the YouTube player on tap (no YouTube code loads before that).
  document.querySelectorAll<HTMLButtonElement>('.ls__play[data-yt]').forEach((b) => b.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
    f.title = b.getAttribute('aria-label') || 'Video tour'; f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'; f.allowFullscreen = true;
    b.replaceWith(f);
  }));
  // Share row (D-349): copy the page's address, or print the page as a feature sheet (the print layout is at the end of the styles).
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const label = b.textContent;
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Link copied'; }
    catch { window.prompt('Copy this link', b.dataset.copy); }
    setTimeout(() => { b.textContent = label; }, 2500);
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
  // Phones: once the buttons under the price have scrolled away, the same actions stay at the bottom of the screen.
  const stick = document.querySelector<HTMLElement>('[data-stick]'), act = document.querySelector<HTMLElement>('.ls__act');
  if (stick && act && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting && e.boundingClientRect.top < 0;
      stick.hidden = !show; document.documentElement.classList.toggle('has-stick', show);
    }).observe(act);
  }
  // Map: on tap, find the address with Places and show it on a Google map with a pin (same key and loader as the area maps).
  import { loadGoogle } from '../lib/gmaps.js';
  document.querySelectorAll<HTMLElement>('.ls__map[data-map]').forEach((m) => {
    const btn = m.querySelector<HTMLButtonElement>('[data-mapgo]');
    if (!m.dataset.key) { btn?.remove(); return; }
    btn?.addEventListener('click', async () => {
      btn.disabled = true; btn.textContent = 'Loading the map…';
      try {
        const g: any = await loadGoogle(m.dataset.key!);
        const { Place } = await g.maps.importLibrary('places');
        const { places } = await Place.searchByText({ textQuery: m.dataset.map, fields: ['location'], maxResultCount: 1, region: 'ca' });
        if (!places?.length) throw new Error('not found');
        const { Map } = await g.maps.importLibrary('maps');
        const box = document.createElement('div'); box.className = 'ls__gmap'; m.prepend(box);
        const at = places[0].location;
        const map = new Map(box, { center: at, zoom: 15, mapTypeControl: true, streetViewControl: true, fullscreenControl: true, clickableIcons: false });
        new g.maps.Marker({ position: at, map, title: m.dataset.map });
        btn.remove(); m.classList.add('is-on');
      } catch { btn.textContent = 'The map is not available right now'; }
    });
  });
</script>

