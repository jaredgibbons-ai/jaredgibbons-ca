---
import PHOTO_ALTS from '../data/photo-alts.json';
import POSTAL from '../data/listing-postal.json';
import { listingFeatures } from '../lib/listing-features';
import EXPLORE from '../data/explore.json';
import { isPreview } from '../lib/preview';
import ExploreLinks from './ExploreLinks.astro';
// Own-listing detail page. Content comes from src/data/listings/<slug>.json (tools/import_listings.py).
// Photos: web-size derivatives of the owner's photo export (never hotlinked from the vendor CDN).
import Base from '../layouts/Base.astro';
import { titleCaseAddress } from '../lib/seo';
import { parseListingSlug, ownCards } from '../lib/own-listings';
import { capsClass } from '../lib/caps';
import Cta from './Cta.astro';
import ListingGallery from './ListingGallery.astro';
import MortgageCalc from './MortgageCalc.astro';
import MEDIA from '../data/listing-media.json';

// Web-size photo lists written by tools/process_photos.py (Drive folder 10 -> src/data/listing-photos/<slug>.json)
const PHOTO_LISTS = import.meta.glob('../data/listing-photos/*.json', { eager: true, import: 'default' }) as Record<string, any[]>;

const { page } = Astro.props as { page: any };
const seo = page.seo || {};
const blocks: any[] = page.blocks;
const sumBlock = blocks.find((b) => b.t === 'summary');
// price first, then "label: value" pairs, then free values (type, area)
const headN: number = sumBlock?.heading_n ?? 0;
const headLines: string[] = sumBlock ? (headN ? sumBlock.lines.slice(0, headN) : sumBlock.lines) : [];
const tailLines: string[] = sumBlock && headN ? sumBlock.lines.slice(headN) : [];
// price first, then "label: value" pairs, then free values (type, area)
const price = headLines.find((l: string) => l.startsWith('$')) ?? '';
const rest: { k?: string; v: string }[] = [];
{
  const ls: string[] = headLines.filter((l: string) => l !== price);
  for (let i = 0; i < ls.length; i++) {
    if (ls[i].endsWith(':') && i + 1 < ls.length) { rest.push({ k: ls[i], v: ls[i + 1] }); i++; }
    else rest.push({ v: ls[i] });
  }
}
// The old site's account photo (Jared's portrait, shown beside every listing there) was captured as the last "photo" of all 200 listings,
// so each gallery ended with a headshot captioned "Portrait of a real estate agent". It is not a listing photo and is left out (D-260).
const ACCOUNT_PHOTO = 'ae8d7fd2e938b2d2';
const photoList: { p: number; id: string; w: number; h: number }[] = (PHOTO_LISTS[`../data/listing-photos/${page.slug}.json`] ?? []).filter((ph) => ph.id !== ACCOUNT_PHOTO);
// archive alt text per position ("Photo 3: <address> | MLS ...")
const altByPos: Record<number, string> = {};
for (const a of page.photos.alts ?? []) { const m = /^Photo (\d+):/.exec(a); if (m) altByPos[Number(m[1])] = a.replace(/^(Photo \d+: )([^,]+)/, (_x: string, p1: string, p2: string) => p1 + titleCaseAddress(p2)); }
const explore = (EXPLORE as Record<string, any>)['listing:' + page.slug];
const _h1 = (blocks.find((b: any) => b.t === 'h' && b.level === 1) as any)?.text;
const priceNum = /^\$[\d,]+$/.test(price) ? Number(price.replace(/[$,]/g, '')) : 0;
const telHref = (s: string) => 'tel:' + s;

// Search snippet. The archive's meta is often empty ("[SOLD]:" alone) or MLS marketing text, so an empty one is built from the facts on the page.
const factMap: Record<string, string> = {};
for (const b of blocks) if (b.t === 'facts') for (const it of b.items) { const k = String(it.k).replace(/:$/, ''); if (!(k in factMap) && it.v?.[0]) factMap[k] = String(it.v[0]); }
const titleParts = String(page.title || '').replace(/ – MLS .*$/, '').split(', ');
const _slugAddr = parseListingSlug(page.slug);
const cityName = _slugAddr ? _slugAddr.city : (titleParts.length > 2 ? titleParts[titleParts.length - 2] : '');
const addr = _slugAddr ? _slugAddr.street : titleCaseAddress(titleParts[0] || '');
// First-screen actions (D-261): a showing request (email or text, filled in with this listing) and a call button. Plain links, no form.
const where = [addr, cityName].filter(Boolean).join(', ');
const showMail = `mailto:jaredgibbons@royallepage.ca?subject=${encodeURIComponent('Showing request: ' + where)}&body=${encodeURIComponent(`Hi Jared,\n\nI'd like to see ${where}.\n\nTimes that work for me:\n\nMy phone number:\n`)}`;
const showSms = `sms:+16049281361?&body=${encodeURIComponent(`Hi Jared, I'd like to book a showing at ${where}.`)}`;
const similarMail = `mailto:jaredgibbons@royallepage.ca?subject=${encodeURIComponent('Homes like ' + where)}&body=${encodeURIComponent(`Hi Jared,\n\nPlease send me homes like ${where} when they come up.\n`)}`;
const archiveTitle = titleParts.length > 1 ? String(page.title || '').replace(/^[^,]+/, titleCaseAddress(titleParts[0])) : String(page.title || '');
const statusWord = page.status === 'Sold' ? 'Sold' : page.status === 'Leased' ? 'Leased' : 'For sale';
// Search title and snippet (D-249). Title: address, city, what it is and its status, then the name, inside 60 characters.
// "17392 2 Avenue, Surrey BC – Sold House | Jared Gibbons". A title written by hand in the archive (one that does not start with the address) is kept.
const TYPE_WORD: Record<string, string> = { 'Single Family Residence': 'House', 'Apartment/Condo': 'Condo', 'Townhouse': 'Townhouse', 'Half Duplex': 'Half Duplex', 'Manufactured On Land': 'Manufactured Home', 'Manufactured Home': 'Manufactured Home', 'Land': 'Land', 'Commercial': 'Commercial Property', 'Industrial': 'Industrial Property', 'Industrial, Retail': 'Commercial Property', 'Residential Income': 'Income Property' };
const typeWord = TYPE_WORD[factMap['Dwelling Type'] || ''] || TYPE_WORD[factMap['Property Type'] || factMap['Prop. Type'] || factMap['Prop Type'] || ''] || 'Home';
// the MLS® sub-area sits between the street and the city in the archive H1 ("17392 2 AVENUE Pacific Douglas Surrey")
const subArea = (() => {
  if (!_slugAddr || !_h1) return '';
  const norm = (x: string) => x.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  let h = norm(String(_h1)).replace(/\s[a-z]\d[a-z]\s?\d[a-z]\d$/, '');
  const st = norm(_slugAddr.street), ci = norm(_slugAddr.city);
  if (!h.startsWith(st)) return '';
  h = h.slice(st.length).trim();
  if (ci && h.endsWith(ci)) h = h.slice(0, -ci.length).trim();
  // "grandview surrey" in Surrey is "Grandview"; board short forms are spelled out; a name that still carries a two-letter board code ("downtown vw") is left out
  if (ci && h.endsWith(' ' + ci) && !/^(fort|central|north|south|east|west|port|new|mount|city of)$/.test(h.slice(0, -ci.length).trim())) h = h.slice(0, -ci.length).trim();
  if (/\b(univer|pt)\b/.test(h) || h === 'south surrey' || h === 'white rock') return '';
  h = h.replace(/\bbch\b/g, 'beach').replace(/\bpk\b/g, 'park').replace(/\bhts\b/g, 'heights').replace(/\bmtn\b/g, 'mountain');
  if (!h || h.length > 30 || /\d/.test(h) || h === ci || /(^|\s)[a-z]{2}$/.test(h)) return '';
  return h.replace(/\b[a-z]/g, (c) => c.toUpperCase());
})();
const _dupTitle = (() => { const k = (x: string) => { const q = parseListingSlug(x); return q ? `${q.street}|${q.city}`.toLowerCase() : ''; }; const me = k(page.slug); return !!me && Object.keys(import.meta.glob('../data/listings/*.json')).filter((f) => k(f.split('/').pop()!.replace(/\.json$/, '')) === me).length > 1; })();
const seoTitle = (() => {
  if (!cityName || !addr || !/^(for sale:|sold\s*-|lease\s*–)?\s*(\d|[a-z]?\d|(unit|lot|ph|th)\b)/i.test(String(page.title || ''))) return archiveTitle;
  const what = page.status === 'Sold' ? `Sold ${typeWord}` : page.status === 'Leased' ? `Leased ${typeWord}` : `${typeWord} for Sale`;
  const base = `${addr}, ${cityName} BC`;
  // the same address listed more than once: the MLS® number keeps the titles apart
  const again = _dupTitle && factMap['MLS® Num'] ? ` (MLS® ${factMap['MLS® Num']})` : '';
  for (const t of [`${base} – ${what}${again} | Jared Gibbons`, `${base} – ${what}${again}`, `${base}${again} | Jared Gibbons`, `${base}${again}`]) if (t.length <= 60) return t;
  return `${base}${again}`;
})();
const crumbs = _h1 ? [{ name: 'Home', href: '/' }, { name: 'My Listings', href: '/our-listings.html' }, { name: _slugAddr ? `${addr}, ${cityName}` : String(_h1), href: page.path }] : []; // the last crumb is this listing's own address (D-247)
function builtMeta(): string {
  // D-251 (Jared: "address, MLS and the postal ... and sold", "within the characters"): status and the full address with postal code and MLS® number lead,
  // then what the home is and what stands out in its photos, then the sale; parts drop from the end of the list until it fits 155 characters.
  const postal = (POSTAL as Record<string, string>)[page.slug] || '';
  const mlsNo = factMap['MLS® Num'] || factMap['MLS® Number'] || '';
  const lead = page.status === 'Active' ? 'For sale' : page.status === 'Leased' ? 'Leased' : 'Sold';
  const place = `${addr}${cityName ? `, ${cityName} BC` : ''}${postal ? ` ${postal}` : ''}`;
  const beds = factMap['Bedrooms'] ? `${factMap['Bedrooms']}-bed ` : '';
  const strata = /condo|townhouse/i.test(typeWord);
  const feats = listingFeatures(photoList.map((ph) => (PHOTO_ALTS as Record<string, string>)[ph.id] || ''), strata);
  const sold = factMap['Sold Date'] ? factMap['Sold Date'].replace(/^(\w+) \d+, (\d{4})$/, '$1 $2') : '';
  const deal = page.status === 'Active' ? `${price ? `${price}. ` : ''}Call Jared 604-928-1361.` : `${lead}${sold ? ` ${sold}` : ''}${price ? ` for ${price}` : ''}.`;
  const join = (xs: string[]) => (xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
  const area = String(factMap['Floor Area'] || factMap['Living Area'] || '').replace(/\s*sq\.?\s*ft\.?$/i, '');
  const yr = factMap['Year Built'] || '';
  const make = (o: { sub: boolean; nf: number; beds: boolean; mlsWord: boolean; deal: boolean; sz?: boolean; yr?: boolean }) => {
    const extra = [o.sz && area ? `${area} sq ft` : '', o.yr && yr ? `built ${yr}` : ''].filter(Boolean).join(', ');
    const what = `${o.beds ? beds : ''}${typeWord.toLowerCase()}${o.sub && subArea ? ` in ${subArea}` : ''}${o.nf ? ` with ${join(feats.slice(0, o.nf))}` : ''}${extra ? `, ${extra}` : ''}`;
    const head = `${lead}: ${place}${mlsNo ? `, ${o.mlsWord ? 'MLS® ' : ''}${mlsNo}` : ''}.`;
    return [head, what.charAt(0).toUpperCase() + what.slice(1) + '.', o.deal ? deal : ''].filter(Boolean).join(' ');
  };
  const tries = [] as string[];
  for (const nf of [Math.min(3, feats.length), Math.min(2, feats.length), Math.min(1, feats.length)])
    for (const sub of [true, false]) for (const b of [true, false]) for (const [sz, y] of [[true, true], [false, true], [true, false], [false, false]]) tries.push(make({ sub, nf, beds: b, mlsWord: true, deal: true, sz, yr: y }));
  for (const sub of [true, false]) for (const [sz, y] of [[true, true], [false, true], [true, false]]) tries.push(make({ sub, nf: 0, beds: true, mlsWord: true, deal: true, sz, yr: y }));
  tries.push(make({ sub: true, nf: 0, beds: true, mlsWord: true, deal: true }), make({ sub: false, nf: 0, beds: true, mlsWord: true, deal: true }), make({ sub: false, nf: 0, beds: false, mlsWord: true, deal: true }), make({ sub: false, nf: 0, beds: false, mlsWord: false, deal: true }), make({ sub: false, nf: 0, beds: false, mlsWord: true, deal: false }));
  return tries.find((m) => m.length <= 155) || tries[tries.length - 1].slice(0, 155);
}
// The archive repeats Status / Property type / MLS / Year built / Sold date in two or three fact lists. Show each fact once (first value wins),
// and drop a list's heading when nothing is left under it.
const factKey = (k: string) => String(k).toLowerCase().replace(/[:.]/g, '').replace(/^prop type$/, 'property type').replace(/mls® num$/, 'mls number').trim();
const seenFacts = new Set<string>();
const bodyBlocks: any[] = [];
for (const b of blocks.filter((x) => !(x.t === 'h' && x.level === 1) && x.t !== 'summary' && x.t !== 'credit' && x.t !== 'disclaimer' && x.t !== 'agent')) {
  if (b.t === 'facts') {
    const items = b.items.filter((it: any) => { const k = factKey(it.k); if (seenFacts.has(k)) return false; seenFacts.add(k); return true; });
    if (!items.length) { if (bodyBlocks.at(-1)?.t === 'h') bodyBlocks.pop(); continue; }
    bodyBlocks.push({ ...b, items });
  } else bodyBlocks.push(b);
}
// A heading seen already, or a heading with nothing after it (the archive's second "Area Statistics"), is dropped (D-230).
{
  const seenH = new Set<string>();
  for (let i = bodyBlocks.length - 1; i >= 0; i--) if (bodyBlocks[i].t === 'h' && (i === bodyBlocks.length - 1 || bodyBlocks[i + 1]?.t === 'h')) bodyBlocks.splice(i, 1);
  for (let i = 0; i < bodyBlocks.length; i++) if (bodyBlocks[i].t === 'h') { const k = String(bodyBlocks[i].text).trim().toLowerCase(); if (seenH.has(k)) { bodyBlocks.splice(i, 1); i--; } else seenH.add(k); }
}
// The same address was listed more than once (sold, then relisted): the MLS® number keeps the two H1s apart.
const _addrKey = (s: string) => { const a = parseListingSlug(s); return a ? `${a.street}|${a.city}`.toLowerCase() : ''; };
const _myKey = _addrKey(page.slug);
const _dupAddr = !!_myKey && Object.keys(import.meta.glob('../data/listings/*.json')).filter((p) => _addrKey(p.split('/').pop()!.replace(/\.json$/, '')) === _myKey).length > 1;
const _mls = /^listing\.(r\d+)/i.exec(page.slug)?.[1]?.toUpperCase();
const h1Text = cityName ? `${addr}, ${cityName}${_dupAddr && _mls ? ` (MLS® ${_mls})` : ''}` : '';
// More of Jared's homes in the same city (D-221): the next four in the city's list, newest first, so every listing page is linked from others.
const _cityCards = ownCards().filter((c) => c.status !== 'Expired' && c.city && c.city === cityName).sort((a, z) => z.soldTs - a.soldTs || a.slug.localeCompare(z.slug));
const _me = _cityCards.findIndex((c) => c.slug === page.slug);
const moreHere = _me < 0 ? [] : [1, 2, 3, 4].map((k) => _cityCards[(_me + k) % _cityCards.length]).filter((c) => c.slug !== page.slug).filter((c, i, a) => a.findIndex((x) => x.slug === c.slug) === i);
const rawMeta = String(seo['Meta description'] || '').replace(/^\[SOLD\]:\s*/i, '').trim();
// Every listing gets the factual snippet: the address, what it is, its status and price. The archive's MLS marketing text stays in the page body.
// Video and 3D tour (D-269): src/data/listing-media.json. The video loads only when tapped (a photo and a play button until then).
const media = (MEDIA as Record<string, any>)[page.slug] as { video?: string; tour3d?: string } | undefined;
// Map (D-269): the listing's address on Google Maps, loaded when tapped.
const mapQ = [addr, [cityName ? `${cityName}, BC` : '', (POSTAL as Record<string, string>)[page.slug] || ''].filter(Boolean).join(' ')].filter(Boolean).join(', ');
// Structured data (D-269): the listing as a schema.org RealEstateListing with its offer, address and photos.
const _postal = (POSTAL as Record<string, string>)[page.slug] || '';
const listingLd: any[] = cityName && addr ? [{ '@context': 'https://schema.org', '@type': 'RealEstateListing', name: h1Text || addr, url: page.canonical,
  image: photoList.slice(0, 6).map((ph) => new URL(`${import.meta.env.PUBLIC_PHOTO_BASE ?? '/listing-photos/'}${ph.id}-960.webp`, 'https://jaredgibbons.ca').href),
  ...(factMap['MLS® Num'] ? { identifier: factMap['MLS® Num'] } : {}),
  offers: { '@type': 'Offer', priceCurrency: 'CAD', ...(priceNum ? { price: priceNum } : {}), availability: page.status === 'Active' ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut',
    seller: { '@type': 'RealEstateAgent', '@id': 'https://jaredgibbons.ca/#agent' } },
  about: { '@type': 'Place', address: { '@type': 'PostalAddress', streetAddress: addr, addressLocality: cityName, addressRegion: 'BC', addressCountry: 'CA', ...(_postal ? { postalCode: _postal } : {}) } },
  ...(media?.video ? { subjectOf: { '@type': 'VideoObject', name: `Video tour of ${where}`, embedUrl: `https://www.youtube.com/embed/${media.video}`, thumbnailUrl: `https://i.ytimg.com/vi/${media.video}/hqdefault.jpg`, contentUrl: `https://www.youtube.com/watch?v=${media.video}` } } : {}) }] : [];
const metaDesc = cityName && addr ? builtMeta() : (rawMeta.length >= 70 ? rawMeta : builtMeta());
---
<Base
  title={seoTitle}
  canonical={page.canonical}
  description={metaDesc}
  ogTitle={seoTitle}
  ogDescription={metaDesc}
  ogImage={seo['OG image'] || undefined}
  jsonld={listingLd}
  robots={page.status === 'Expired' ? 'noindex, follow' : (seo['Meta robots'] || 'index, follow')}
  footerTagline="South Surrey Realtor | Homes for Sale, Condos & MLS Listings"
  footerCell={true}
  brandHref="/"
  crumbs={crumbs}
>
<main id="main">
  <section class="section">
    <div class="wrap ls">
      {blocks.map((b) => {
        if (b.t === 'h' && b.level === 1) return <h1 class={`ls__h1${capsClass(h1Text || b.text)}`}>{h1Text || b.text}</h1>;
        if (b.t === 'summary') {
          const inner = (
            <>
              <span class="ls__price">{price}</span>
              {rest.map((r) => <span class="ls__chip">{r.k ? <><span class="ls__k">{r.k}</span> {r.v}</> : r.v}</span>)}
            </>
          );
          return <>{headN ? <h2 class="ls__sum">{inner}</h2> : <p class="ls__sum">{inner}</p>}{tailLines.map((l: string) => <p class="ls__flag">{l}</p>)}
            <p class="ls__act">{page.status === 'Active'
              ? <><a class="btn" href={showMail} data-ev="book_showing">Book a showing</a><a class="btn btn--ghost" href={showSms} data-ev="text_jared">Text Jared</a><a class="btn btn--ghost" href="tel:604-928-1361" data-ev="call_jared">Call 604-928-1361</a>{media?.video && <a class="btn btn--ghost" href="#ls-media">▶ Watch the video</a>}{media?.tour3d && <a class="btn btn--ghost" href={media.tour3d} target="_blank" rel="noopener">3D tour</a>}</>
              : <><a class="btn" href={similarMail}>Ask about homes like this</a><a class="btn btn--ghost" href="tel:604-928-1361" data-ev="call_jared">Call 604-928-1361</a></>}</p>
          </>;
        }
        return null;
      })}
      {photoList.length > 0
        ? <ListingGallery photos={photoList} alts={altByPos} title={page.title} place={cityName ? `${addr}, ${cityName} BC` : ''} />
        : (
          <div class="ls__photos" role="note">
            <p class="ls__photos-t">Listing photos</p>
            <p>No photos are on file for this listing yet.</p>
          </div>
        )}
      {(media?.video || media?.tour3d) && (
        <div class="ls__media" id="ls-media">
          {media.video && (
            <figure class="ls__vid">
              <button type="button" class="ls__play" data-yt={media.video} aria-label={`Play the video tour of ${where}`}>
                <img src={`https://i.ytimg.com/vi/${media.video}/hqdefault.jpg`} alt={`Video tour of ${where}`} width="480" height="360" loading="lazy" decoding="async" />
                <span class="ls__playi" aria-hidden="true"><svg viewBox="0 0 68 48" width="68" height="48"><rect width="68" height="48" rx="10" fill="#0a0a0a" fill-opacity=".85"/><path d="M27 15l18 9-18 9z" fill="#fff"/></svg></span>
              </button>
              <figcaption>Video tour · <a href={`https://www.youtube.com/watch?v=${media.video}`} target="_blank" rel="noopener">Watch on YouTube</a></figcaption>
            </figure>
          )}
          {media.tour3d && <p class="ls__tour"><a class="btn" href={media.tour3d} target="_blank" rel="noopener">Open the 3D tour <span aria-hidden="true">↗</span></a></p>}
        </div>
      )}
      {isPreview && page.status === 'Active' && (
        <p class="notice">Status is shown as captured in the archive on 2026-10-31. Live status needs the listing feed, which is not connected in the preview.</p>
      )}
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap ls">
      {bodyBlocks.map((b) => {
        if (b.t === 'h') return <h2 class="ls__h">{b.text}</h2>;
        if (b.t === 'p') return <p class="ls__p">{b.parts.map((x: any) => x.h ? <a href={x.h}>{x.t}</a> : x.t).reduce((a: any[], x: any, i: number) => (a.length ? [...a, /^[.,;:!?)]/.test(String(b.parts[i].t || '')) ? '' : ' ', x] : [x]), [])}</p>;
        if (b.t === 'list') return <ul class="ls__list">{b.items.map((it: any) => <li>{it.map((x: any) => x.t).join(' ')}</li>)}</ul>;
        if (b.t === 'facts') return (
          <dl class="ls__facts">
            {b.items.map((it: any) => (
              <div class="ls__row">
                <dt>{it.k}</dt>
                <dd>{it.v.length ? it.v.map((v: string, i: number) => <>{i > 0 && <br />}{v}</>) : ''}</dd>
              </div>
            ))}
          </dl>
        );
        if (b.t === 'table') return (
          <div class="ls__tablewrap" tabindex="0" role="region" aria-label={b.caption}>
            <table class="ls__table">
              <caption>{b.caption}</caption>
              <thead><tr>{b.head.map((h: string) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{b.rows.map((r: string[]) => <tr>{b.head.map((_: string, i: number) => <td>{r[i] ?? ''}</td>)}</tr>)}</tbody>
            </table>
          </div>
        );
        return null;
      })}
    </div>
  </section>

  {mapQ && cityName && (
    <section class="section" aria-labelledby="ls-map-h">
      <div class="wrap ls">
        <h2 class="ls__h" id="ls-map-h">Location</h2>
        <div class="ls__map" data-map={`https://www.google.com/maps?q=${encodeURIComponent(mapQ)}&z=15&output=embed`}>
          <button type="button" class="btn btn--ghost" data-mapgo>Show the map</button>
          <p><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQ)}`} target="_blank" rel="noopener">{mapQ} <span aria-hidden="true">↗</span></a></p>
        </div>
      </div>
    </section>
  )}

  {priceNum > 0 && (
    <section class="section" aria-labelledby="ls-mc-h">
      <div class="wrap ls">
        <h2 class="ls__h" id="ls-mc-h">{page.status === 'Sold' ? 'Estimate a payment at this price' : 'Estimate the monthly payment'}</h2>
        <MortgageCalc price={priceNum} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap ls">
      {blocks.filter((b) => b.t === 'agent').slice(0, 1).map((b) => (
        <div class="ls__agent">
          <p class="ls__agent-n">{b.lines[0]}</p>
          <p>{b.lines[1]}</p>
          <p><a href={telHref(b.lines[2])}>{b.lines[2]}</a></p>
          <p><a href={`mailto:${b.lines[3]}`}>{b.lines[3]}</a></p>
        </div>
      ))}
      {blocks.filter((b) => b.t === 'credit').map((b) => <p class="ls__credit">{b.text}</p>)}
      {blocks.filter((b) => b.t === 'disclaimer').map((b) => <p class="ls__disc">{b.text}</p>)}
    </div>
  </section>
  {moreHere.length > 0 && (
    <section class="section" aria-labelledby="ls-more"><div class="wrap ls ls__more">
      <h2 id="ls-more" class="h2">More homes Jared has sold or listed in {cityName}</h2>
      <ul>{moreHere.map((c) => <li><a href={c.href}>{c.street}</a>{c.status === 'Active' ? ' (for sale)' : c.year ? ` (${c.status === 'Leased' ? 'leased' : 'sold'} ${c.year})` : ''}</li>)}</ul>
      <p><a href="/sold-properties.html">All of Jared's sold homes</a></p>
    </div></section>
  )}
  <Cta />
  {explore && <ExploreLinks data={explore} />}
</main>
</Base>

<script>
  // Video: swap the photo for the YouTube player on tap (no YouTube code loads before that).
  document.querySelectorAll<HTMLButtonElement>('.ls__play[data-yt]').forEach((b) => b.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
    f.title = b.getAttribute('aria-label') || 'Video tour'; f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'; f.allowFullscreen = true;
    b.replaceWith(f);
  }));
  // Map: load Google Maps on tap.
  document.querySelectorAll<HTMLElement>('.ls__map[data-map]').forEach((m) => m.querySelector('[data-mapgo]')?.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = m.dataset.map!; f.title = 'Map'; f.loading = 'lazy'; f.referrerPolicy = 'no-referrer-when-downgrade';
    m.prepend(f); m.querySelector('[data-mapgo]')?.remove(); m.classList.add('is-on');
  }));
</script>

