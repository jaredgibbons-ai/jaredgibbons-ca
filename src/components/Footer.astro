---
const social = [
  ['Blog','https://jaredgibbons.ca/blog.html'],
  ['Facebook','https://www.facebook.com/jaredgibbonsrealestate/'],
  ['Instagram','https://www.instagram.com/jaredgibbonsrealestate/'],
  ['YouTube','https://www.youtube.com/@JaredGibbonsRealtor'],
  ['TikTok','https://www.tiktok.com/@jaredgibbonsrealtor'],
  ['LinkedIn','https://www.linkedin.com/in/jared-gibbons-96814591/'],
  ['Rate My Agent','https://www.rate-my-agent.com/jared-gibbons-ratings-surrey-15968'],
  ['Google Maps','https://maps.app.goo.gl/zvYBAj6rf2cKyjsZ9'],
  ['Pinterest','https://www.pinterest.com/jaredgibbonsrealtor/'],
  ['Yelp','https://www.yelp.ca/biz/jared-gibbons-surrey'],
];
const { tagline, cell = false } = Astro.props;
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <h2>Jared Gibbons – South Surrey Realtor</h2>
        {tagline ? <h4>{tagline}</h4> : null}
        <h4>Top 1% of All Realtors in the Fraser Valley</h4>
      </div>
      <div>
        <p class="footer__label">Office</p>
        <p>Office: <a href="tel:604-928-1361">604-928-1361</a><br />
        {cell && <>Cell: <a href="tel:604-928-1361">604-928-1361</a><br /></>}
        <a href="/contact.html">Contact Me</a></p>
        <p class="footer__label">Office Address:</p>
        <p>#201, 15272 Croydon Drive<br />Surrey, BC, V3Z 0Z5</p>
      </div>
      <div>
        <p class="footer__label">Follow</p>
        <ul class="footer__social">
          {social.map(([n, h]) => <li><a href={h}>{n}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="footer__legal">
      <p>© 2026 Jared Gibbons – South Surrey Realtor. All rights reserved. | <a href="/privacy.html">Privacy Policy</a> | <a href="https://myrealpage.com/">Real Estate Websites by myRealPage</a></p>
      <p class="footer__recip"><img src="/img/icon-gv-recip-standard.gif" width="106" height="43" alt="Reciprocity Logo" loading="lazy" /></p>
      <p>The data relating to real estate on this website comes in part from the MLS® Reciprocity program of either the Greater Vancouver REALTORS® (GVR), the Fraser Valley Real Estate Board (FVREB) or the Chilliwack and District Real Estate Board (CADREB). Real estate listings held by participating real estate firms are marked with the MLS® logo and detailed information about the listing includes the name of the listing agent. This representation is based in whole or part on data generated by either the GVR, the FVREB or the CADREB which assumes no responsibility for its accuracy. The materials contained on this page may not be reproduced without the express written consent of either the GVR, the FVREB or the CADREB.</p>
    </div>
  </div>
</footer>
