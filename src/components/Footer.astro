---
const social = [
  ['Blog','/blog.html'],
  ['Facebook','https://www.facebook.com/jaredgibbonsrealestate/'],
  ['Instagram','https://www.instagram.com/jaredgibbonsrealestate/'],
  ['YouTube','https://www.youtube.com/@JaredGibbonsRealtor'],
  ['Vimeo','https://vimeo.com/user84468535'],
  ['TikTok','https://www.tiktok.com/@jaredgibbonsrealtor'],
  ['LinkedIn','https://www.linkedin.com/in/jared-gibbons-96814591/'],
  ['Rate My Agent','https://www.rate-my-agent.com/jared-gibbons-ratings-surrey-15968'],
  ['Google Maps','https://maps.app.goo.gl/zvYBAj6rf2cKyjsZ9'],
  ['Pinterest','https://www.pinterest.com/jaredgibbonsrealtor/'],
  ['Yelp','https://www.yelp.ca/biz/jared-gibbons-surrey'],
];
// Popular searches: one link to each of the pages that carry the most searching, grouped so a visitor (and a crawler) can reach them from every page.
const popular = [
  ['Homes by city', [
    ['South Surrey homes','/south-surrey-homes-for-sale.html'],['White Rock homes','/white-rock.html'],['Langley homes','/langley-homes-for-sale.html'],['Surrey homes','/surrey-homes-for-sale.html'],
    ['Abbotsford homes','/abbotsford-homes-for-sale.html'],['Chilliwack homes','/chilliwack-homes-for-sale.html'],['Delta homes','/delta-homes-for-sale.html'],['Mission homes','/mission-homes-for-sale.html'],
    ['Maple Ridge homes','/maple-ridge-homes-for-sale.html'],['Coquitlam homes','/coquitlam-homes-for-sale.html'],
  ]],
  ['Condos and townhomes', [
    ['South Surrey condos','/south-surrey-condos-for-sale.html'],['Langley condos','/langley-condos-for-sale.html'],['Surrey condos','/surrey-condos-for-sale.html'],
    ['South Surrey townhomes','/south-surrey-townhomes-for-sale.html'],['Langley townhomes','/langley-townhomes-for-sale.html'],['Surrey townhomes','/surrey-townhomes-for-sale.html'],
  ]],
  ['By price', [
    ['Homes under $1.5 million','/homes-under-1500000.html'],['South Surrey homes under $1.8M','/south-surrey-homes-under-1-8m.html'],['Langley homes under $1.8M','/langley-homes-under-1-8m.html'],
    ['Surrey townhomes under $1.2M','/surrey-townhomes-under-1-2m.html'],['South Surrey townhomes under $1.2M','/south-surrey-townhomes-under-1-2m.html'],['Langley townhomes under $1.2M','/langley-townhomes-under-1-2m.html'],
  ]],
  ['Lifestyle and new homes', [
    ['South Surrey luxury homes','/south-surrey-luxury-homes.html'],['Waterfront homes in White Rock and South Surrey','/south-surrey-white-rock-waterfront-homes-for-sale.html'],
    ['Langley acreages','/langley-acreages-for-sale.html'],['Fraser Valley acreages','/fraser-valley-acreages-for-sale.html'],['55+ condos in South Surrey and White Rock','/south-surrey-white-rock-55-plus-condos-for-sale.html'],
    ['Golf course homes in South Surrey and White Rock','/south-surrey-white-rock-golf-course-homes-for-sale.html'],['South Surrey presales','/south-surrey-new-construction-presales.html'],
    ['Presale projects across the Fraser Valley','/presale-projects-fraser-valley-and-metro-vancouver.html'],
  ]],
  ['Buyer and seller tools', [
    ['Open houses','/open-houses.html'],['Sold properties','/sold-properties.html'],['What is my home worth?','/home-evaluation.html'],['First-time buyer programs in BC','/first-time-home-buyer-program.html'],
    ['Mortgage calculator','/mortgage-calculator.html'],['GST rebate in BC','/gst-rebate-in-bc.html'],
  ]],
];
const { tagline, cell = false } = Astro.props;
import { isHeldHref } from '../lib/launch';
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <h2>Jared Gibbons – South Surrey Realtor</h2>
        {tagline ? <p class="footer__tag">{tagline}</p> : null}
        <p class="footer__tag">#1 REALTOR® in South Surrey / White Rock by FVREB Medallion Club points (2025 and 2026 YTD). #1 of the Top 25 individuals at Royal LePage Little Oak Realty (2025). Top 1% of Fraser Valley REALTORS®.</p>
        <p class="footer__brokerage">REALTOR® with Royal LePage Little Oak Realty</p>
      </div>
      <div>
        <p class="footer__label">Office</p>
        <p>Office: <a href="tel:604-928-1361">604-928-1361</a><br />
        {cell && <>Cell: <a href="tel:604-928-1361">604-928-1361</a><br /></>}
        <a href="/contact.html">Contact Me</a></p>
        <p class="footer__label">Office Address:</p>
        <p>#201, 15272 Croydon Drive<br />Surrey, BC, V3Z 0Z5</p>
      </div>
      <div>
        <p class="footer__label">Follow</p>
        <ul class="footer__social">
          {social.map(([n, h]) => <li><a href={h}>{n}</a></li>)}
        </ul>
      </div>
    </div>
    <nav class="footer__popular" aria-label="Popular searches">
      <h2 class="footer__popular-h">Popular searches</h2>
      <div class="footer__popular-grid">
        {popular.map(([h, links]) => [h, links.filter(([, href]) => !isHeldHref(href))] as const).filter(([, links]) => links.length).map(([h, links]) => (
          <div>
            <p class="footer__label">{h}</p>
            <ul>{links.map(([n, href]) => <li><a href={href}>{n}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </nav>
    <div class="footer__legal">
      <p>© 2026 Jared Gibbons – South Surrey Realtor. All rights reserved. | <a href="/privacy.html">Privacy Policy</a> | <a href="/data-and-methodology.html">Data &amp; Methodology</a> | <a href="/photo-credits.html">Photo Credits</a> | <a href="https://myrealpage.com/">Real Estate Websites by myRealPage</a></p>
      <p class="footer__recip"><img src="/img/icon-gv-recip-standard.gif" width="106" height="43" alt="Reciprocity Logo" loading="lazy" /></p>
      <p>The data relating to real estate on this website comes in part from the MLS® Reciprocity program of either the Greater Vancouver REALTORS® (GVR), the Fraser Valley Real Estate Board (FVREB) or the Chilliwack and District Real Estate Board (CADREB). Real estate listings held by participating real estate firms are marked with the MLS® logo and detailed information about the listing includes the name of the listing agent. This representation is based in whole or part on data generated by either the GVR, the FVREB or the CADREB which assumes no responsibility for its accuracy. The materials contained on this page may not be reproduced without the express written consent of either the GVR, the FVREB or the CADREB.</p>
    </div>
  </div>
</footer>
