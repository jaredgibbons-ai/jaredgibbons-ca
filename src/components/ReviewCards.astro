---
import Stars from './Stars.astro';
const { heading, intro, items = [], id = 'reviews' } = Astro.props;
---
<section class="section section--cream" aria-labelledby={`h-${id}`} id={id}>
  <div class="wrap">
    <h2 id={`h-${id}`} class="h2">{heading}</h2>
    {intro && <p class="prose muted">{intro}</p>}
    <ul class="rv">
      {items.map((r: any) => (
        <li class="rv__c">
          <Stars rating={r.stars} />
          <blockquote class="rv__q">{r.quote}</blockquote>
          <p class="rv__w"><span>{r.who}</span> <span class="muted">{r.when}</span></p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .rv{list-style:none;margin:var(--s6) 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,19rem),1fr));gap:var(--s5)}
  .rv__c{background:#fff;border:1px solid var(--ink);padding:1.5rem;display:flex;flex-direction:column;gap:.5rem}
  .rv__q{margin:0;font-size:1rem;line-height:1.6}
  .rv__w{margin:auto 0 0;padding-top:.75rem;font:600 .8125rem var(--f-head);display:flex;flex-wrap:wrap;gap:.25rem .75rem}
  .rv__w .muted{font-weight:400}
</style>
