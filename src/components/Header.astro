---
import Icon from './Icon.astro';
import NavLinks from './NavLinks.astro';
import nav from '../data/nav.json';
const { current = '', brandHref = '/' } = Astro.props;
// Grouped mega panels (D-149): each top-level menu with sub-pages opens as labelled columns plus one call-to-action, instead of one long list.
// `items` name child labels exactly as in nav.json; `expand` lists that child's own sub-pages as the column. Anything not named here still appears (last column), so no menu page can be dropped silently.
type Col = { title: string; href?: string; items?: string[]; expand?: string; max?: number; after?: string[] };
const MENUS: Record<string, { cols: Col[]; cta: { title: string; text: string; label: string; href: string } }> = {
  'MLS Listings': {
    cols: [
      { title: 'Search', items: ['Search Listings', 'Map Search', 'Foreclosures', 'South Surrey Homes for Sale', 'Langley Homes for Sale'] },
      { title: 'Open houses', href: '/open-houses.html', expand: 'Open Houses' },
      { title: 'Price searches', expand: 'Price Searches' },
      { title: 'Farms, land & commercial', href: '/farms.html', expand: 'Farms', max: 6, after: ['Land', 'Commercial'] },
    ],
    cta: { title: 'Not sure where to start?', text: 'Tell Jared what you want and he will set up a search for you.', label: 'Talk to Jared', href: '/contact.html' },
  },
  'Buy a Home': {
    cols: [
      { title: 'Start here', items: ['Home Buying Process', 'First Time Home Buyer Program', 'First-Time Home Buyer GST Rebate in BC | Save Up to $50,000', 'Mortgage Calculator'] },
      { title: 'Questions', items: ['FAQ for Home Buyers in BC | Jared Gibbons, REALTOR®', 'How to Buy a Mobile Home in BC'] },
    ],
    cta: { title: 'Ready to look?', text: 'Search every MLS® listing in the Fraser Valley and Metro Vancouver.', label: 'Search listings', href: '/recip.html' },
  },
  'Sell Your Home': {
    cols: [
      { title: 'Get started', items: ['Home Evaluation', 'Marketing Plan', 'Selling Resources'] },
      { title: 'More', items: ['Sell My House Fast in Langley BC | Jared Gibbons Realtor', 'FAQ for Home Sellers in BC | Jared Gibbons, REALTOR®'] },
    ],
    cta: { title: 'What is your home worth?', text: 'A free, no-pressure evaluation from Jared.', label: 'Free home evaluation', href: '/home-evaluation.html' },
  },
  'About Us': {
    cols: [{ title: 'About Jared', items: ['Meet Jared', 'Reviews', 'Contact', 'South Surrey Real Estate Agent | Jared Gibbons Realtor'] }],
    cta: { title: 'Call or text', text: '604-928-1361', label: 'Call Jared', href: 'tel:604-928-1361' },
  },
  'Resources': {
    cols: [
      { title: 'Tools and numbers', items: ['Mortgage Calculator', 'First-Time Buyer Calculator BC | PTT, GST Rebate & FHSA', 'Fraser Valley Market Stats', 'Zonings'] },
      { title: 'Land use plans', href: '/land-use-plans.html', expand: 'Land use plans' },
      { title: 'Learn and stay in touch', items: ['Resources for Buyers and Sellers', 'Schools', 'Subscribe to our Newsletter', 'Privacy Policy'] },
    ],
    cta: { title: 'Market numbers', text: 'Benchmark prices, sales and listings for each area, updated monthly.', label: 'See the latest stats', href: '/fraser-valley-market-stats.html' },
  },
};
// Every land-use-plan entry reads "<Place> Land Use Plans" (the archive labels only said "Surrey", "Delta" and so on); the GIS entry keeps its name.
const luLabel = (t: string) => /land use plan|geographic information/i.test(t) ? t : /\bplans$/i.test(t) ? t.replace(/\bplans$/i, 'Land Use Plans') : `${t} Land Use Plans`;
const short = (l: string) => { const a = l.split(' | ')[0]; return a.length > 52 ? a.split(':')[0] : a; };
const wide = new Set(['Communities', ...Object.keys(MENUS)]);
function megaCols(item: any) {
  const m = MENUS[item.label]; if (!m) return null;
  const kids: any[] = item.children, used = new Set<string>(), find = (l: string) => kids.find((c) => c.label === l);
  const cols = m.cols.map((c) => {
    const links: { label: string; href: string }[] = []; const seen = new Set<string>();
    const add = (k: any) => { const t = c.expand === 'Land use plans' ? luLabel(short(k.label)) : short(k.label); if (!k.href || seen.has(t)) return; seen.add(t); links.push({ label: t, href: k.href }); };
    if (c.expand) { const p = find(c.expand); if (p) { used.add(p.label); (p.children || []).slice(0, c.max ?? 99).forEach(add); } }
    for (const l of [...(c.items || []), ...(c.after || [])]) { const k = find(l); if (k) { used.add(l); add(k); } }
    return { title: c.title, href: c.href, links };
  });
  const rest = kids.filter((k) => !used.has(k.label));
  if (rest.length) cols.push({ title: 'More', href: undefined, links: rest.filter((k) => k.href).map((k) => ({ label: short(k.label), href: k.href })) });
  return { cols, cta: m.cta };
}
// Communities menu: one list of places on the left, the chosen place's links on the right (no sideways scrolling); on phones each place opens in place.
const REGIONS: [string, string[]][] = [
  ['Core markets', ['South Surrey', 'Surrey', 'Langley', 'Cloverdale', 'Delta']],
  ['Fraser Valley', ['Abbotsford', 'Chilliwack', 'Mission', 'Maple Ridge', 'Pitt Meadows']],
  ['Metro Vancouver', ['Richmond', 'Vancouver', 'Burnaby', 'New Westminster', 'Coquitlam']],
];
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<aside class="topbar" aria-label="Contact and social links">
  <div class="wrap">
    <div class="topbar__left">
      <a href="tel:604-928-1361">604-928-1361</a>
      <a href="mailto:jaredgibbons@royallepage.ca">jaredgibbons@royallepage.ca</a>
    </div>
    <div class="topbar__right">
      <a href="https://www.facebook.com/jaredgibbonsrealestate/">Facebook</a>
      <a href="https://www.instagram.com/jaredgibbonsrealestate/">Instagram</a>
      <a href="https://www.tiktok.com/@jaredgibbonsrealtor">TikTok</a>
      <a href="https://www.youtube.com/@JaredGibbonsRealtor">YouTube</a>
      <a href="https://vimeo.com/user84468535" rel="noopener">Vimeo</a>
      <a href="/blog.html">Blog</a>
    </div>
  </div>
</aside>
<header class="site-header" id="site-header">
  <div class="wrap">
    <a class="brand brand--logo" href={brandHref}><img src="/img/site-logo.webp" width="370" height="166" alt="Jared Gibbons – South Surrey Realtor" loading="eager" decoding="async" /></a>
    <button class="btn btn--ghost menu-btn" type="button" aria-expanded="false" aria-controls="primary-nav" id="menu-btn">
      <span data-label>Menu</span>
    </button>
    <nav class="nav" id="primary-nav" aria-label="Primary">
      {nav.map((item, i) => {
        const hasKids = !!item.children;
        const isWide = wide.has(item.label);
        const id = `np-${i}`;
        return (
          <div class:list={['nav__item', isWide && 'nav__item--wide']}>
            {item.href
              ? <a class="nav__link" href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
              : <span class="nav__link">{item.label}</span>}
            {hasKids && (
              <>
                <button class="nav__toggle" type="button" aria-expanded="false" aria-controls={id} aria-label={`${item.label} submenu`}><Icon name="chevron" /></button>
                <div class:list={['nav__panel', isWide && !MENUS[item.label] && 'nav__panel--wide', !!MENUS[item.label] && 'nav__panel--mega']} id={id} hidden>
                  {MENUS[item.label] ? (() => { const mm = megaCols(item)!; return (
                    <div class="mm">
                      <div class="mm__cols">
                        {mm.cols.map((c) => (
                          <div class="mm__col">
                            <p class="mm__h">{c.href ? <a href={c.href}>{c.title}</a> : c.title}</p>
                            <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
                          </div>
                        ))}
                      </div>
                      <aside class="mm__cta" aria-label={mm.cta.title}>
                        <p class="mm__ctah">{mm.cta.title}</p>
                        <p class="mm__ctat">{mm.cta.text}</p>
                        <a class="btn" href={mm.cta.href}>{mm.cta.label}</a>
                      </aside>
                    </div>); })() : isWide ? (
                    <div class="mega">
                      {REGIONS.map(([region, names]) => (
                        <>
                          <p class="mega__region">{region}</p>
                          {names.map((n) => {
                            const g = item.children.find((c: any) => c.label === n);
                            if (!g) return null;
                            const first = region === 'Core markets' && n === 'South Surrey';
                            return (
                              <div class="mega__city">
                                <button class="mega__tab" type="button" aria-expanded={first ? 'true' : 'false'} aria-controls={`mp-${slug(n)}`}>{n}</button>
                                <div class="mega__pane" id={`mp-${slug(n)}`} hidden={!first}>
                                  <p class="mega__title">{n}</p>
                                  <ul>{g.children.map((l: any) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
                                </div>
                              </div>
                            );
                          })}
                        </>
                      ))}
                    </div>
                  ) : <NavLinks items={item.children} />}
                </div>
              </>
            )}
          </div>
        );
      })}
    </nav>
  </div>
</header>
<script>
  const nav = document.getElementById('primary-nav');
  const btn = document.getElementById('menu-btn');
  const label = btn?.querySelector('[data-label]');
  const toggles = [...document.querySelectorAll('.nav__toggle')];
  const mq = window.matchMedia('(max-width:1300px)');
  const header = document.getElementById('site-header');
  // Offset the mobile overlay from the header's actual bottom edge (banner/topbar may or may not be scrolled away).
  const setTop = () => document.documentElement.style.setProperty('--nav-top', Math.max(header.getBoundingClientRect().bottom, 0) + 'px');

  function closeAll(except) {
    toggles.forEach((t) => {
      if (t === except) return;
      t.setAttribute('aria-expanded', 'false');
      document.getElementById(t.getAttribute('aria-controls')).hidden = true;
    });
  }
  toggles.forEach((t) => {
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') === 'true';
      closeAll(t);
      t.setAttribute('aria-expanded', String(!open));
      document.getElementById(t.getAttribute('aria-controls')).hidden = open;
    });
    // desktop: open on hover/focus-in of the item
    const item = t.closest('.nav__item');
    // The panel stays open for a moment after the pointer leaves, so you can cross to a neighbouring item or reach a link without it vanishing.
    let timer = 0;
    item.addEventListener('mouseenter', () => { clearTimeout(timer); if (!mq.matches) { closeAll(t); t.setAttribute('aria-expanded','true'); document.getElementById(t.getAttribute('aria-controls')).hidden = false; } });
    item.addEventListener('mouseleave', () => { if (!mq.matches) { clearTimeout(timer); timer = window.setTimeout(() => { if (!item.matches(':hover') && !item.contains(document.activeElement)) closeAll(); }, 450); } });
  });
  // Communities: pick a place, see its links. Desktop shows one pane at a time (hover or focus); phones open and close each place.
  const tabs = [...document.querySelectorAll('.mega__tab')];
  const show = (tab, on) => { tab.setAttribute('aria-expanded', String(on)); document.getElementById(tab.getAttribute('aria-controls')).hidden = !on; };
  tabs.forEach((tab) => {
    const pick = () => { if (mq.matches) return; tabs.forEach((t) => show(t, t === tab)); };
    tab.addEventListener('mouseenter', pick);
    tab.addEventListener('focus', pick);
    tab.addEventListener('click', () => { if (mq.matches) show(tab, tab.getAttribute('aria-expanded') !== 'true'); else pick(); });
  });
  mq.addEventListener('change', () => tabs.forEach((t, i) => show(t, !mq.matches && i === 0)));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = toggles.find((t) => t.getAttribute('aria-expanded') === 'true');
    closeAll();
    if (nav.classList.contains('is-open')) setMenu(false);
    (open || btn)?.focus();
  });
  document.addEventListener('click', (e) => { if (!mq.matches && !e.target.closest('.nav')) closeAll(); });
  function setMenu(on) {
    nav.classList.toggle('is-open', on);
    btn.setAttribute('aria-expanded', String(on));
    label.textContent = on ? 'Close menu' : 'Menu';
    document.body.style.overflow = on ? 'hidden' : '';
    setTop();
  }
  btn?.addEventListener('click', () => setMenu(!nav.classList.contains('is-open')));
  mq.addEventListener('change', () => { setMenu(false); closeAll(); });
  setTop();
</script>
