---
// Archive-driven page body: renders one imported page/post JSON (tools/import_pages.py).
// Generic archive-driven page. Content comes from src/data/pages/<slug>.json, produced by
// tools/import_pages.py from the folder-09 page records. Bespoke pages (index, fort-langley,
// reviews) are explicit files and take precedence over this route.
import Base from '../layouts/Base.astro';
import Rich from './Rich.astro';
import { capsClass } from '../lib/caps';
import { upgradeBlocks, dropOrphans, cleanArchive } from '../lib/upgrade';
import Cta from './Cta.astro';
import ReviewCards from './ReviewCards.astro';
import FormStub from './FormStub.astro';
import NetProceedsCalc from './NetProceedsCalc.astro';
import MortgageCalc from './MortgageCalc.astro';
import CommuteTime from '../components/CommuteTime.astro';
import AreaMap from './AreaMap.astro';
import SourceList from './SourceList.astro';
import { isSourcesHeading } from '../lib/sources';
import { isGated } from '../lib/inventory';
import { pickReviews } from '../lib/reviews';
import { isPreview, isDraftNote } from '../lib/preview';
import { holdReason, visibleItems, isHeldHref } from '../lib/launch';
import REVIEW_EXCERPTS from '../data/review-excerpts.json';
import AREA_PHOTOS from '../data/area-photos.json';
import PhotoCredit from './PhotoCredit.astro';
import IdxEmbed from './IdxEmbed.astro';
import ListingAlert from './ListingAlert.astro';
import Newsletter from './Newsletter.astro';
import SearchQuiz from './SearchQuiz.astro';
import HomeValue from './HomeValue.astro';
import PropertyCard from './PropertyCard.astro';
import { ownCards } from '../lib/own-listings';
import IDX from '../data/idx-embeds.json';
import BREADCRUMBS from '../data/breadcrumbs.json';
import EXPLORE from '../data/explore.json';
import EXPLORE_EXTRA from '../data/explore-extra.json';
import ExploreLinks from './ExploreLinks.astro';
import AwardsMarquee from './AwardsMarquee.astro';

const { page } = Astro.props as { page: any };
const awRev = [...page.slug].reduce((n: number, c: string) => n + c.charCodeAt(0), 0) % 2 === 1;
const seo = page.seo || {};
const idx = IDX as { account: string; pages: Record<string, string>; special?: Record<string, string> };
const idxId = idx.pages[page.slug];
const idxPath = idx.special?.[page.slug];
// A page whose main content is a live listing search: the heading is compact and the search starts right below it (D-143).
const isSearch = !!(idxId || idxPath);
// Name of the search, sent with an "Email me new listings" signup so Jared knows which one to set up.
const alertName = String((page.blocks || []).find((b: any) => b.t === 'h' && b.level === 1)?.text || String(page.title || '').split('|')[0]).replace(/\s+/g, ' ').trim().slice(0, 150);

// Local-knowledge layer (src/data/local/<slug>.json): original sourced sections inserted before the first
// level-2 heading, plus FAQ + breadcrumb structured data. Only used where present; archive blocks are untouched.
const LOCAL = import.meta.glob('../data/local/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const local = LOCAL[`../data/local/${page.slug}.json`];
// FAQ clean-up at render time (data files are untouched): a question repeated on one page shows once, and entries written as notes about the page itself
// ("owner-approved set", "Flagged:", "in this file", "What is the jared.html page?") are held back, since they read as internal review notes to a visitor.
const INTERNAL_FAQ = /(owner-approved|\bflagged\b|\bin this file\b|\bthe archive\b|stated position|as its own statement|the page body|\.html page|\bunverified\b|^what is the [\w\- ]+ page\?|\bthe page (says|states|names|lists|shows|carries|quotes|gives|tells|describes|advises|covers|uses|itself)\b|\bdoes the [\w\- ]+ page (say|state|name|list|show|carry|quote|give|tell|describe|advise|cover)|what does the page|which of those claims)/i;
if (local?.faq?.length) {
  const seenQ = new Set<string>();
  // The two plain questions were generated with the page name inserted ("Can Jared show me homes in Open?", "… in Our?", "… in Sold Properties?"); the unnamed wording reads right on every page.
  local.faq = local.faq.map((f: any) => /^Can Jared show me homes in .+\?$/.test(f.q) ? { ...f, q: 'Can I book a private showing with Jared?' } : /^How do I find out what my home in .+ is worth\?$/.test(f.q) ? { ...f, q: 'How do I find out what my home is worth?' } : f);
  local.faq = local.faq.filter((f: any) => { const k = String(f.q).trim().toLowerCase(); if (seenQ.has(k)) return false; seenQ.add(k); return !INTERNAL_FAQ.test(f.q + ' ' + f.a); });
}
// Three archive pages (About, Zonings, Buying) kept a contact form as plain text under an "... Form" heading (label lines, an option list, then "SUBMIT"). Those become the same
// inert form block the other pages use; the "I agree to be contacted" line is not a field and is dropped (the consent checkbox comes with the live form at launch).
// "Buying Form" was a second H1 on its page, so it drops to an H2.
{
  const B = page.blocks; const out: any[] = [];
  const h1First = B.findIndex((b: any) => b.t === 'h' && b.level === 1);
  for (let i = 0; i < B.length; i++) {
    const b0 = B[i];
    if (b0.t === 'h' && b0.level <= 2 && /\bform$/i.test(String(b0.text).trim()) && (B[i + 1]?.t === 'p')) {
      let j = i + 1; const labels: string[] = []; let last = i;
      while (j < B.length && (B[j].t === 'p' || B[j].t === 'list') && j - i < 12) {
        const txt = (B[j].parts ?? []).map((x: any) => x.t).join('|');
        if (B[j].t === 'p' && /^submit$/i.test(txt.trim())) { last = j; break; }
        if (B[j].t === 'p' && !/^yes, i agree/i.test(txt) && (B[j].parts ?? []).every((x: any) => /:$/.test(String(x.t).trim()))) for (const x of B[j].parts) labels.push(String(x.t).trim());
        else if (B[j].t === 'p' && !/^yes, i agree/i.test(txt)) break;
        last = j; j++;
      }
      if (labels.length >= 3) {
        out.push(b0.level === 1 && i !== h1First ? { ...b0, level: 2 } : b0);
        out.push({ t: 'form', labels: labels.map((l) => (/\?:$/.test(l) ? l.slice(0, -1) : l)), submit: 'Submit' });
        i = last; continue;
      }
    }
    out.push(b0);
  }
  page.blocks = out;
}
let endCount = 0;
const origin = 'https://jaredgibbons.ca';
const jsonld: any[] = [];
// Breadcrumbs: the local layer's own trail, else the generated one (tools/build_breadcrumbs.py), else Home > Blog > post for blog posts.
const postName = String(page.title || '').split('|')[0].trim();
const crumbs: any[] = page.slug === 'index' || page.slug === '404' ? [] : local?.breadcrumbs?.length ? local.breadcrumbs
  : String(page.path || '').startsWith('/blog.html/') ? [{ name: 'Home', href: '/index.html' }, { name: 'Blog', href: '/blog.html' }, { name: postName, href: page.path }]
  : (BREADCRUMBS as Record<string, any[]>)[page.slug] ?? [];
if (local?.faq?.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: local.faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
// The old MLS search form leaked into six farm pages as text (form labels, a 34-item and a 275-item list of dropdown options, "Save search", "Reset", "Filters"). It is not content: drop it from "Price: Property Type / Subtype:" through "Filters".
{
  const ptxt = (b: any) => b.text ?? b.parts?.map((x: any) => x.t).join('') ?? '';
  const from = page.blocks.findIndex((b: any) => b.t === 'p' && /^Price:\s*Property Type \/ Subtype/.test(ptxt(b)));
  if (from >= 0) { const to = page.blocks.findIndex((b: any, i: number) => i > from && b.t === 'p' && ptxt(b).trim() === 'Filters'); if (to > from) page.blocks = [...page.blocks.slice(0, from), ...page.blocks.slice(to + 1)]; }
}
if (local) {
  // `hide`: archive paragraphs/headings (matched by their opening words) that move to another page; the archive record is untouched.
  if (local.hide?.length) page.blocks = page.blocks.filter((b: any) => { const tx = b.text ?? b.parts?.map((x: any) => x.t).join('') ?? ''; return !((b.t === 'p' || b.t === 'h') && local.hide.some((x: string) => tx.startsWith(x))); });
  // `replace_body`: the local layer rewrites the whole page body (a bare address list, say); only the archive H1 is kept.
  if (local.replace_body) { const h1i = page.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1); page.blocks = page.blocks.slice(0, h1i + 1); }
  // `suppress`: level-2 headings whose whole section is replaced by the local layer (duplicated sibling-page text).
  if (local.suppress?.length) {
    let drop = false;
    page.blocks = page.blocks.filter((b: any) => { if (b.t === 'h' && b.level <= 2) drop = b.level === 2 && local.suppress.includes(b.text); return !drop || b.t === 'reviews' || b.t === 'grid' || b.t === 'form'; });
  }
  // The first level-2 heading AFTER the H1: 38 archive pages open with an H2 above the H1, which used to put the local sections above the H1.
  const h1At = page.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1);
  const at = page.blocks.findIndex((b: any, i: number) => i > h1At && b.t === 'h' && b.level === 2);
  const faqBlocks = (local.faq ?? []).length ? [{ t: 'h', level: 2, text: local.faq_heading || 'Common questions' }, ...local.faq.flatMap((f: any) => [{ t: 'h', level: 3, text: f.q }, { t: 'p', parts: [{ t: f.a }] }])] : [];
  const cut = at < 0 ? page.blocks.length : at;
  const asPart = (b: any) => b.t === 'p' && !b.parts ? { t: 'p', parts: [{ t: b.text, ...(b.h ? { h: b.h } : {}) }] } : b;
  // pos:'end' blocks (related-link lists) go after the archive content, so the top of the page stays as it was.
  const endBlocks = local.blocks.filter((b: any) => b.pos === 'end').map(asPart);
  endCount = endBlocks.length;
  // pos:'before-form' blocks go above the heading that introduces the page's contact form (About: awards), instead of after the form.
  const formAt = page.blocks.findIndex((b: any) => b.t === 'form');
  const beforeForm = local.blocks.filter((b: any) => b.pos === 'before-form').map(asPart);
  const formCut = beforeForm.length && formAt > 0 ? (page.blocks[formAt - 1]?.t === 'h' ? formAt - 1 : formAt) : -1;
  const plain = local.blocks.filter((b: any) => b.pos !== 'end' && b.pos !== 'before-form').map(asPart);
  // The FAQ closes the page content (before the contact form's heading, if the page has one) instead of sitting between the H1 and the page's own text.
  const arr = [...page.blocks.slice(0, cut), ...plain, ...page.blocks.slice(cut)];
  if (faqBlocks.length) {
    const fIdx = arr.findIndex((b: any) => b.t === 'form');
    const fAt = fIdx < 0 ? arr.length : (arr[fIdx - 1]?.t === 'h' ? fIdx - 1 : fIdx);
    arr.splice(Math.max(fAt, 0), 0, ...faqBlocks);
  }
  if (formCut >= 0) { const at2 = arr.indexOf(page.blocks[formCut]); arr.splice(at2, 0, ...beforeForm); } else arr.push(...beforeForm);
  page.blocks = [...arr, ...endBlocks];
}

// Contact fix (D-73): 148 archive pages print jared@jaredgibbons.ca, which is not Jared's address; shown as jaredgibbons@royallepage.ca. The archive record is untouched.
page.blocks = JSON.parse(JSON.stringify(page.blocks).replaceAll('jared@jaredgibbons.ca', 'jaredgibbons@royallepage.ca'));

// Area photos (D-89, src/data/area-photos.json, tools/build_area_photos.py): public-licence photos with the credit shown under each one.
// An H2 that repeats the page H1 word for word (guide pages carried both) is dropped; the H1 already says it.
{
  const nh = (x: unknown) => String(x ?? '').replace(/\s+/g, ' ').trim().toLowerCase();
  const h1t = nh(page.blocks.find((b: any) => b.t === 'h' && b.level === 1)?.text);
  if (h1t) page.blocks = page.blocks.filter((b: any) => !(b.t === 'h' && b.level === 2 && nh(b.text) === h1t));
}

// The main photo goes after the first paragraph under the H1; any others form a gallery section before the closing link lists.
const isHub = page.blocks.some((b: any) => b.t === 'areamap' && b.mode === 'hub');
const photos: any[] = isHub ? [] : ((AREA_PHOTOS as Record<string, any[]>)[page.slug] ?? []);
if (photos.length) {
  const h1 = page.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1);
  const p1 = page.blocks.findIndex((b: any, i: number) => i > h1 && b.t === 'p');
  const first = p1 >= 0 ? p1 + 1 : Math.max(h1 + 1, 0);
  page.blocks.splice(first, 0, { t: 'photo', photo: photos[0] });
  if (photos.length > 1) page.blocks.splice(page.blocks.length - endCount, 0, { t: 'photos', photos: photos.slice(1) });
}

// Every content page shows three Google review excerpts (assigned per page in src/data/review-assign.json, no two pages share the same three).
// Archive pages that had no review block, and pages built from the local layer alone, get one, placed before the end-of-page link lists.
const NO_REVIEWS = new Set(['404', 'privacy', 'subscribe-to-our-newsletter', 'contact', 'reviews', 'photo-credits']);
// Presale and new-construction pages: a "VIP floorplans & pricing" request (name, email, phone, project) after the opening section.
// Project cards that link to #vip-floorplans fill in the project name (script at the end of this file).
if (/presale|new-construction/.test(page.slug) && !page.blocks.some((b: any) => b.t === 'vipform')) {
  const h1i = page.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1);
  const at = page.blocks.findIndex((b: any, i: number) => i > h1i && b.t === 'h' && b.level === 2);
  page.blocks.splice(at > 0 ? at : page.blocks.length - endCount, 0, { t: 'vipform' });
}
if (!NO_REVIEWS.has(page.slug) && !page.blocks.some((b: any) => b.t === 'reviews')) page.blocks.splice(page.blocks.length - endCount, 0, { t: 'reviews', heading: REVIEW_EXCERPTS.heading, intro: REVIEW_EXCERPTS.intro, items: REVIEW_EXCERPTS.items });

// A page with two source lists (for example condo notes and townhome notes) must not show the same source card twice: later lists keep only what earlier ones did not show.
{
  const shown = new Set<string>(); const drop = new Set<number>();
  page.blocks.forEach((b: any, i: number) => {
    const prev = page.blocks[i - 1];
    if (b.t !== 'list' || prev?.t !== 'h' || !isSourcesHeading(prev.text)) return;
    const keep = b.items.filter((it: any[]) => { const a = it.find((p: any) => p.h); const k = a ? String(a.h).replace(/#.*$/, '') : ''; if (!k) return true; if (shown.has(k)) return false; shown.add(k); return true; });
    if (!keep.length) { drop.add(i); drop.add(i - 1); } else b.items = keep;
  });
  if (drop.size) page.blocks = page.blocks.filter((_: any, i: number) => !drop.has(i));
}

// Newsletter page: the archive captured only the form's labels (Name, Email, a consent line, Subscribe). Swap them for the working sign-up.
if (page.slug === 'subscribe-to-our-newsletter') {
  const at = page.blocks.findIndex((b: any) => b.t === 'h' && /^Subscribe to our newsletter$/i.test(b.text || ''));
  if (at >= 0) page.blocks.splice(at, page.blocks.length - at, { t: 'newsletter' });
}

// Testimonials page: the archive captured a review form's labels and a star list that nothing can receive. Reviews are left on Google, so the section becomes one button.
if (page.slug === 'testimonials') {
  const at = page.blocks.findIndex((b: any) => b.t === 'h' && /^Leave a review$/i.test(b.text || ''));
  if (at >= 0) {
    let end = at + 1;
    while (end < page.blocks.length && page.blocks[end].t !== 'h' && page.blocks[end].t !== 'reviews') end++;
    page.blocks.splice(at, end - at,
      { t: 'p', parts: [{ t: 'Reviews are posted on Google, where anyone can read them. It takes a minute: pick your star rating, add a few lines about working with me and press Post.' }] },
      { t: 'btnlink', label: 'Leave a Google review', href: 'https://maps.app.goo.gl/zvYBAj6rf2cKyjsZ9' });
  }
}

// Neighbourhood-guide hubs: the map sits straight under the H1 (no photo, no "map" heading), so the page opens on the thing readers came for.
if (isHub) {
  const h1i = page.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1);
  const mi = page.blocks.findIndex((b: any) => b.t === 'areamap' && b.mode === 'hub');
  if (h1i >= 0 && mi >= 0) {
    const [m] = page.blocks.splice(mi, 1);
    const hi = mi - 1;
    if (page.blocks[hi]?.t === 'h' && page.blocks[hi].level === 2 && /map$/i.test(page.blocks[hi].text || '')) page.blocks.splice(hi, 1);
    page.blocks.splice(h1i + 1, 0, m);
  }
  // The "Neighbourhood guides · City of X" line (above or below the H1 on some hubs) says nothing the H1 and breadcrumb do not; every hub opens the same way.
  page.blocks = page.blocks.filter((b: any) => !(b.t === 'p' && (b.parts || [{ t: b.text }]).map((x: any) => x.t).join('').trim().startsWith('Neighbourhood guides ·')));
}
// Long pages (twenty or more H2 sections) get an "On this page" jump list right after the H1, so a reader can reach a section without scrolling thousands of pixels.
{
  const h2s = page.blocks.filter((b: any) => b.t === 'h' && b.level === 2 && !b.href && String(b.text || '').trim());
  const h1i = page.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1);
  if (h2s.length >= 20 && h1i >= 0 && page.slug !== 'blog') {
    const used = new Set(page.blocks.filter((b: any) => b.id).map((b: any) => b.id));
    const items = h2s.slice(0, 60).map((b: any) => {
      if (!b.id) { let id = String(b.text).toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 48) || 'section'; let n = 2; const base = id; while (used.has(id)) id = `${base}-${n++}`; used.add(id); b.id = id; }
      return { text: b.text, id: b.id };
    });
    page.blocks.splice(h1i + 1 + (page.blocks[h1i + 1]?.t === 'areamap' ? 1 : 0), 0, { t: 'toc', items });
  }
}
// Archive pages open with an H2 above the H1 ("Fraser Valley Acreages for Sale" over the longer H1): show that line as a small label above the H1, not a second giant heading.
{
  const b0 = page.blocks[0]; const h1i = page.blocks.findIndex((b: any) => b.t === 'h' && b.level === 1);
  if (b0?.t === 'h' && (b0.level === 2 || b0.level === 3) && h1i > 0 && h1i <= 2) page.blocks[0] = { t: 'p', cls: 'eyebrow', parts: [{ t: b0.text }] };
  // Leftover widget label from the archive, right above the ALR heading.
  page.blocks = page.blocks.filter((b: any) => !(b.t === 'p' && (b.parts || []).map((x: any) => x.t).join('').trim() === 'ALR property search'));
}

// Archive "Related · Area / Explore More / 01 title / Nearby View →" runs of plain paragraphs become one 'related' block (a card grid).
{
  const txt = (b: any) => (b?.t === 'p' ? (b.parts || []).map((x: any) => x.t).join(' ').replace(/\s+/g, ' ').trim() : '');
  const out: any[] = []; const bl = page.blocks;
  for (let i = 0; i < bl.length; i++) {
    const b = bl[i];
    if (b.t === 'h' && b.text === 'Explore More') {
      const items: any[] = []; let j = i + 1;
      while (j + 2 < bl.length && /^\d{1,2}$/.test(txt(bl[j])) && bl[j + 1]?.t === 'p' && bl[j + 2]?.t === 'p' && (bl[j + 2].parts || []).some((x: any) => x.h)) {
        const link = bl[j + 2].parts.find((x: any) => x.h);
        items.push({ n: txt(bl[j]), title: txt(bl[j + 1]), label: txt({ t: 'p', parts: bl[j + 2].parts.filter((x: any) => !x.h) }), href: link.h });
        j += 3;
      }
      if (items.length >= 2) {
        const prev = out[out.length - 1];
        const eyebrow = prev && /^Related\s*·/.test(txt(prev)) ? (out.pop(), txt(prev)) : '';
        out.push({ t: 'related', eyebrow, title: 'Explore More', items });
        i = j - 1; continue;
      }
    }
    out.push(b);
  }
  page.blocks = out;
}

page.blocks = cleanArchive(page.blocks);

// Split into render sections at each level-2 heading; reviews and grid get their own sections.
type Sec = { kind: 'text' | 'reviews' | 'grid' | 'photos'; blocks: any[]; block?: any };
const sections: Sec[] = [];
let cur: Sec = { kind: 'text', blocks: [] };
const push = () => { if (cur.blocks.length) sections.push(cur); cur = { kind: 'text', blocks: [] }; };
for (const b of page.blocks) {
  if (b.t === 'reviews') { push(); sections.push({ kind: 'reviews', blocks: [], block: b }); continue; }
  if (b.t === 'grid') { push(); sections.push({ kind: 'grid', blocks: [] }); continue; }
  if (b.t === 'photos') { push(); sections.push({ kind: 'photos', blocks: [], block: b }); continue; }
  if (b.t === 'h' && b.level === 2) push();
  cur.blocks.push(b);
}
push();
// Text sections: questions become an accordion, "Label." paragraphs followed by text become cards, and short text-only sections use a two-column layout (heading left, text right).
{
  const pt = (b: any) => (b?.t === 'p' ? (b.parts || []).map((x: any) => x.t).join(' ').replace(/\s+/g, ' ').trim() : '');
  const isLabel = (b: any) => b?.t === 'p' && !b.cls && (b.parts || []).length === 1 && !b.parts[0].h && /^[A-Z0-9][^.!?:;]{1,46}\.$/.test(pt(b)) && pt(b).split(' ').length <= 7;
  const simple = (b: any) => b.t === 'p' || b.t === 'list';
  for (const [sx, sec] of sections.entries()) {
    if (sec.kind !== 'text') continue;
    sec.blocks = dropOrphans(sec.blocks, (sections[sx + 1]?.kind === 'reviews' ? 'reviews clients' : sections.slice(sx + 1).find((x) => x.kind === 'text')?.blocks.find((b: any) => b.t === 'h' && b.level === 2)?.text || ''));
    sec.blocks = upgradeBlocks(sec.blocks);
    for (const b of sec.blocks) if (b.t === 'p' && !b.cls && /:$/.test(pt(b)) && pt(b).split(' ').length <= 4) b.cls = 'pg__label';
    // questions: a level-3 heading or a one-line paragraph ending in "?", followed by its answer
    const isQ = (b: any) => (b?.t === 'h' && b.level === 3 && /\?\s*$/.test(b.text) && !b.href) || (b?.t === 'p' && !b.cls && (b.parts || []).length === 1 && !b.parts[0].h && /\?$/.test(pt(b)) && pt(b).split(' ').length <= 22);
    const qText = (b: any) => (b.t === 'h' ? b.text : pt(b));
    const out: any[] = []; const bl = sec.blocks;
    for (let i = 0; i < bl.length; i++) {
      const b = bl[i];
      if (isQ(b)) {
        let j = i + 1; const a: any[] = [];
        while (j < bl.length && bl[j].t !== 'h' && simple(bl[j]) && !isQ(bl[j])) a.push(bl[j++]);
        if (a.length) { const prev = out[out.length - 1]; const it = { q: qText(b), id: b.id, h3: b.t === 'h', a }; if (prev?.t === 'faq') prev.items.push(it); else out.push({ t: 'faq', items: [it] }); i = j - 1; continue; }
      }
      out.push(b);
    }
    sec.blocks = out.map((b) => (b.t === 'faq' && b.items.length < 2 ? [{ t: b.items[0].h3 ? 'h' : 'p', ...(b.items[0].h3 ? { level: 3, text: b.items[0].q, id: b.items[0].id } : { parts: [{ t: b.items[0].q }] }) }, ...b.items[0].a] : [b])).flat();
    // label cards
    const labels = sec.blocks.map((b: any, i: number) => (isLabel(b) && simple(sec.blocks[i + 1] || {}) && !isLabel(sec.blocks[i + 1]) ? i : -1)).filter((i: number) => i >= 0);
    if (labels.length >= 2) {
      const first = labels[0]; const items: any[] = []; let i = first; let ok = true;
      while (i < sec.blocks.length && isLabel(sec.blocks[i])) {
        const a: any[] = []; let j = i + 1;
        while (j < sec.blocks.length && !isLabel(sec.blocks[j]) && simple(sec.blocks[j])) a.push(sec.blocks[j++]);
        if (!a.length) { ok = false; break; }
        items.push({ h: pt(sec.blocks[i]).replace(/\.$/, ''), a }); i = j;
      }
      if (ok && items.length >= 2) sec.blocks = [...sec.blocks.slice(0, first), { t: 'subs', items }, ...sec.blocks.slice(i)];
    }
    const first = sec.blocks[0];
    (sec as any).split = first?.t === 'h' && first.level === 2 && !first.href && sec.blocks.length > 1 && sec.blocks.slice(1).every((b: any) => ['p', 'list', 'faq', 'subs', 'notice', 'kvgrid', 'gcards', 'stats'].includes(b.t) || (b.t === 'h' && b.level >= 3));
  }
}
const linkOnly = (items: any[]) => items.every((it) => it.length === 1 && it[0].h);
let fid = 0;
const exploreBase = (EXPLORE as Record<string, any>)[String(page.path || '').startsWith('/blog.html/') ? 'post:' + page.slug : page.slug];
const _extra: string[][] = (EXPLORE_EXTRA as Record<string, any>)[page.slug] ?? [];
const explore = !_extra.length ? exploreBase
  : exploreBase ? { ...exploreBase, cols: exploreBase.cols.map((c: any, i: number) => i === 0 ? { ...c, links: [...c.links, ..._extra.filter((l) => !c.links.some((x: string[]) => x[1] === l[1]))] } : c) }
  : { cols: [{ h: 'Related guides', links: _extra, more: [] }] };
---
<Base
  title={page.title}
  canonical={page.canonical}
  description={seo['Meta description'] || undefined}
  ogTitle={seo['OG title'] || undefined}
  ogDescription={seo['OG description'] || undefined}
  ogImage={seo['OG image'] || undefined}
  jsonld={jsonld}
  crumbs={crumbs}
  robots={isGated(page.slug) ? 'noindex, follow' : (seo['Meta robots'] || 'index, follow')}
  footerTagline="South Surrey Realtor | Homes for Sale, Condos & MLS Listings"
  footerCell={true}
  brandHref="/index.html"
>
<main id="main">
  {isPreview && holdReason(page.slug) && <p class="notice wrap">Held at launch: {holdReason(page.slug)}. This page is built and linked in the preview, but the launch build keeps it out of the index, the sitemap and the footer until this is fixed.</p>}
  {sections.map((sec, si) => {
    if (sec.kind === 'reviews') return <><AwardsMarquee seed={page.slug} reverse={awRev} size={64} flush /><ReviewCards heading={sec.block.heading} intro={sec.block.intro} items={pickReviews(page.slug, REVIEW_EXCERPTS.items)} id={`reviews-${si}`} /></>;
    if (sec.kind === 'photos') return (
      <section class="section section--tight" aria-labelledby={`photos-${si}`}>
        <div class="wrap">
          <h2 class="h2 caps" id={`photos-${si}`}>Photos from the area</h2>
          <ul class="phgrid">
            {sec.block.photos.map((ph: any) => <li class={ph.wide ? 'phgrid__wide' : undefined}><PhotoCredit photo={ph} sizes={ph.wide ? '(min-width:64rem) 72rem, 100vw' : '(min-width:64rem) 24rem, (min-width:40rem) 45vw, 100vw'} /></li>)}
          </ul>
        </div>
      </section>
    );
    if (sec.kind === 'grid' && idxPath) return <IdxEmbed path={idxPath} account={idx.account} />;
    // Search pages (a saved search id) get the "Email me new listings" box right above the results; the open map search and "my listings" widgets do not.
    if (sec.kind === 'grid' && idxId) return <IdxEmbed id={idxId} account={idx.account}><ListingAlert search={alertName} searchId={idxId} /></IdxEmbed>;
    if (sec.kind === 'grid') return (
      <section class="section section--tight" aria-label="Listings">
        <div class="wrap">
          {isPreview && <p class="notice">Live MLS® listings for this search are not connected in the preview. <a href="/recip.html">Search Listings</a></p>}
        </div>
      </section>
    );
    return (
      <section class:list={['section', { 'section--cream': si % 2 === 1, 'section--tight': (!sec.blocks.some((x) => x.t === 'h') && sec.blocks.length <= 3) || (isSearch && si === 0), 'section--search': isSearch && si === 0 }]}>
        <div class="wrap">
          <div class:list={['pg', { 'pg--hub': isHub,  'pg--wide': sec.blocks.some((x) => x.t === 'lcards'), 'pg--search': isSearch && si === 0, 'pg--split': (sec as any).split && !(isSearch && si === 0) }]}>
            {sec.blocks.map((b, bi) => {
              if (b.t === 'h') {
                const Tag = `h${Math.min(b.level, 5)}`;
                return <Tag id={b.id} class={(b.level === 1 ? 'pg__h1' : b.level === 2 ? 'h2' : 'pg__h') + (b.level <= 2 ? (isHub && b.level === 1 ? ' caps' : capsClass(b.text)) : '')}>{b.href ? <Rich parts={[{ t: b.text, h: b.href }]} /> : b.text}</Tag>;
              }
              if (b.t === 'toc') return (
                <details class="toc"><summary>On this page ({b.items.length} sections)</summary>
                  <ul>{b.items.map((it: any) => <li><a href={`#${it.id}`}>{it.text}</a></li>)}</ul>
                </details>
              );
              if (b.t === 'newsletter') return <Newsletter />;
              if (b.t === 'p') return <p class={b.cls}><Rich parts={b.parts} /></p>;
              if (b.t === 'photo') return <PhotoCredit photo={b.photo} hero sizes="(min-width:48rem) 40rem, 100vw" />;
              if (b.t === 'list' && sec.blocks[bi - 1]?.t === 'h' && isSourcesHeading(sec.blocks[bi - 1].text) && b.items.some((it: any[]) => it.some((p: any) => p.h))) return <SourceList items={b.items} />;
              if (b.t === 'list') {
                const shown = visibleItems(b.items);
                if (!shown.length) return null;
                return (
                  <ul class:list={['lines', { 'lines--links': linkOnly(shown) }]}>
                    {shown.map((it: any) => <li><Rich parts={it} /></li>)}
                  </ul>
                );
              }
              if (b.t === 'card') return (
                <a class:list={['cardlink', { 'cardlink--arrow': b.lines.length === 2 && b.lines[1].text?.trim() === '→' }]} href={b.href.replace(/^https:\/\/jaredgibbons\.ca(?=\/|$)/, '') || '/'}>
                  {b.lines.map((l: any, k: number) => {
                    if (l.level) { const T = `h${Math.min(l.level, 5)}`; return <T class="cardlink__h">{l.text}</T>; }
                    return <span class={k === 0 ? 'cardlink__h' : 'cardlink__t'}>{l.text}</span>;
                  })}
                </a>
              );
              if (b.t === 'related') return (
                <div class="related">
                  {b.eyebrow && <p class="eyebrow">{b.eyebrow}</p>}
                  <h2 class="related__h">{b.title}</h2>
                  <ul class="related__grid">
                    {b.items.filter((it: any) => !isHeldHref(it.href)).map((it: any) => (
                      <li><a class="related__card" href={it.href.replace(/^https:\/\/jaredgibbons\.ca(?=\/|$)/, '') || '/'}>
                        <span class="related__n" aria-hidden="true">{it.n}</span>
                        <span class="related__t">{it.title}</span>
                        <span class="related__a">{it.label && !String(it.title || '').toLowerCase().trimEnd().endsWith(String(it.label).toLowerCase().trim()) ? `${it.label} ` : ''}view →</span>
                      </a></li>
                    ))}
                  </ul>
                </div>
              );
              if (b.t === 'lcards') {
                const all = ownCards();
                const mon = (c: any) => { const m = /^(\w{3}) \d+, (\d{4})$/.exec(c.soldDate || ''); return m ? `Sold ${m[1]} ${m[2]}` : 'Sold'; };
                const card = (c: any) => <PropertyCard href={c.href} photoSlug={c.slug} street={c.street} city={c.city} price={c.price} beds={c.beds} baths={c.baths}
                  floorArea={c.sqft ? (/sq/i.test(c.sqft) ? c.sqft : `${c.sqft} sqft`) : undefined} status={c.status === 'Active' ? 'Active' : c.status} type={c.type} tags={c.status === 'Active' ? [] : [mon(c)]} mls={c.mls} moreLabel="More Info" />;
                const active = all.filter((c) => c.status === 'Active').sort((a, b) => b.priceNum - a.priceNum);
                const done = all.filter((c) => c.status !== 'Active').sort((a, b) => b.soldTs - a.soldTs);
                if (b.mode === 'active') return (
                  <>
                    {active.length > 0 && <><h2 class="h2">Active listings ({active.length})</h2>
                      {isPreview && <p class="notice">Status is shown as captured in the archive on 2026-10-31. Live status needs the listing feed, which is not connected in the preview.</p>}
                      <ul class="cards">{active.map(card)}</ul></>}
                    <h2 class="h2">Recently sold</h2>
                    <ul class="cards">{done.slice(0, 12).map(card)}</ul>
                    <p><a class="btn" href="/sold-properties.html">See all {done.length} sold homes</a></p>
                  </>
                );
                const shown = done.slice(0, 24);
                return (
                  <>
                    <p>The {shown.length} most recent of the {done.length} homes Jared has sold or leased, newest first. <a href="/our-listings.html">See Jared's active listings</a>.</p>
                    <ul class="cards">{shown.map(card)}</ul>
                  </>
                );
              }
              if (b.t === 'notice') { if (isDraftNote(b.text) && !isPreview) return null; return <p class="notice">{b.text}</p>; }
              if (b.t === 'faq') return (
                <div class="faqlist">
                  {b.items.map((it: any, k: number) => (
                    <details class="faq" open={k === 0} id={it.id}>
                      <summary><span class="faq__q">{it.q}</span><span class="faq__i" aria-hidden="true"></span></summary>
                      <div class="faq__a">{it.a.map((x: any) => x.t === 'list' ? <ul class="lines">{x.items.map((li: any) => <li><Rich parts={li} /></li>)}</ul> : <p class={x.cls}><Rich parts={x.parts} /></p>)}</div>
                    </details>
                  ))}
                </div>
              );
              if (b.t === 'subs') return (
                <ul class="subs">
                  {b.items.map((it: any) => (
                    <li class="sub">
                      <h3 class="sub__h">{it.h}</h3>
                      {it.a.map((x: any) => x.t === 'list' ? <ul class="lines">{x.items.map((li: any) => <li><Rich parts={li} /></li>)}</ul> : <p class={x.cls}><Rich parts={x.parts} /></p>)}
                    </li>
                  ))}
                </ul>
              );
              if (b.t === 'gcards') return (
                <ul class="gcards">
                  {b.items.map((c: any) => (
                    <li class="gcard">
                      <h3 class="gcard__h">{c.title}</h3>
                      <dl class="gcard__facts">{c.facts.map((r: any) => <div><dt>{r.l}</dt><dd>{r.v}</dd></div>)}</dl>
                      <p class="gcard__b"><Rich parts={c.blurb} /></p>
                      <ul class="gcard__links">{c.links.map((k: any) => <li><a href={k.h.replace(/^https:\/\/jaredgibbons\.ca(?=\/|$)/, '') || '/'}>{k.t}</a></li>)}</ul>
                    </li>
                  ))}
                </ul>
              );
              if (b.t === 'kvgrid') return (
                <ul class:list={['kvgrid', { 'kvgrid--wide': b.wide }]}>
                  {b.items.map((c: any) => (
                    <li class="kv">
                      {c.kicker && <p class="kv__k">{c.kicker}</p>}
                      {c.title && <h3 class="kv__h">{c.href ? <a href={c.href}>{c.title}</a> : c.title}</h3>}
                      <dl class="kv__rows">{c.rows.map((r: any) => <div class="kv__row"><dt>{r.l}</dt><dd><Rich parts={r.v} /></dd></div>)}</dl>
                      {c.links?.length > 0 && <ul class="kv__links">{c.links.map((k: any) => <li><a href={k.h.replace(/^https:\/\/jaredgibbons\.ca(?=\/|$)/, '') || '/'}>{k.t}</a></li>)}</ul>}
                    </li>
                  ))}
                </ul>
              );
              if (b.t === 'stats') return (
                <ul class:list={['statcards', { 'statcards--sm': b.small, 'statcards--six': b.items.length === 6 }]}>
                  {b.items.map((it: any) => <li class="statcard"><span class="statcard__l">{it.label}</span><strong class="statcard__v">{it.value}</strong>{it.sub && <span class="statcard__s">{it.delta ? <span class={['statcard__d', /^\s*[-\u2212]/.test(it.delta) ? 'is-down' : /^\s*\+/.test(it.delta) ? 'is-up' : ''].join(' ')} aria-hidden="true">{/^\s*[-\u2212]/.test(it.delta) ? '▼' : '▲'}</span> : null}{it.delta ? [(/^\s*[-\u2212]/.test(it.delta) ? 'Down' : 'Up'), String(it.delta).replace(/^\s*[-+\u2212]/, ''), String(it.sub).replace(/^\s*[-+\u2212]?[\d.]+%\s*/, '')].filter(Boolean).join(' ') : it.sub}</span>}</li>)}
                </ul>
              );
              if (b.t === 'chips') return (
                <nav class="chips" aria-label={b.label}>
                  {b.label && <span class="chips__l">{b.label}</span>}
                  <ul>{b.items.map((c: any) => <li><a class:list={['chip', { 'is-now': c.now }]} href={c.h.replace(/^https:\/\/jaredgibbons\.ca(?=\/|$)/, '') || '/'} aria-current={c.now ? 'true' : undefined}>{c.t}</a></li>)}</ul>
                </nav>
              );
              if (b.t === 'table') return (<>
                {(() => {
                  const bi = b.head.findIndex((h: string) => /^benchmark( price)?$/i.test(h)), yi = b.head.findIndex((h: string) => /^1 year$/i.test(h));
                  if (bi < 1 || yi < 1 || b.rows.length > 6 || b.head.length < 4) return null;
                  return <ul class="statcards statcards--sm">{b.rows.map((r: any[]) => { const dv = String(r[yi]); return <li class="statcard"><span class="statcard__l">{typeof r[0] === 'object' ? r[0].t : r[0]}</span><strong class="statcard__v">{typeof r[bi] === 'object' ? r[bi].t : r[bi]}</strong><span class="statcard__s"><span class={'statcard__d ' + (/^\s*[-\u2212]/.test(dv) ? 'is-down' : 'is-up')} aria-hidden="true">{/^\s*[-\u2212]/.test(dv) ? '▼' : '▲'}</span>{/^\s*[-\u2212]/.test(dv) ? 'Down ' : /^\s*\+/.test(dv) ? 'Up ' : ''}{dv.replace(/^\s*[-+\u2212]/, '')} over 1 year</span></li>; })}</ul>;
                })()}
                <div class:list={['tblwrap', { 'tblwrap--narrow': b.head.length <= 3 && b.rows.length <= 12 }]} tabindex="0" role="region" aria-label={b.caption}>
                  <table class="tbl">{b.caption && <caption>{b.caption}</caption>}
                    <thead><tr>{b.head.map((h: string) => <th scope="col">{h}</th>)}</tr></thead>
                    <tbody>{b.rows.map((r: any[]) => <tr>{r.map((c, ci) => { const v = c && typeof c === 'object' ? (isHeldHref(c.h) ? c.t : <a href={c.h}>{c.t}</a>) : c; return ci === 0 ? <th scope="row">{v}</th> : <td>{v}</td>; })}</tr>)}</tbody>
                  </table>
                  {b.source && <p class="tbl__src">{b.source} {/^Source:/.test(b.source) && page.slug !== 'data-and-methodology' && <a href="/data-and-methodology.html">How these figures are defined and sourced</a>}</p>}
                </div>
              </>);
              if (b.t === 'calc') return b.which === 'mortgage' ? <MortgageCalc price={b.price} exemption={b.exemption} /> : <NetProceedsCalc />;
              if (b.t === 'areamap') return <AreaMap region={b.region} mode={b.mode} current={b.current} />;
              if (b.t === 'btnlink') return <p><a class="btn" href={b.href} rel="noopener" target="_blank">{b.label}<span class="sr-only"> (opens in a new tab)</span></a></p>;
              if (b.t === 'commute') return <CommuteTime region={b.region} current={b.current} />;
              if (b.t === 'vipform') return (
                <div class="vip on-dark" id="vip-floorplans">
                  <div class="vip__copy">
                    <p class="eyebrow">VIP access</p>
                    <h2 class="h2">Get VIP floorplans and pricing</h2>
                    <p>Developers send floorplans, price lists and incentives to registered buyers first. Tell me the project and I’ll send the package, then call to walk you through it.</p>
                    <ul class="vip__list">
                      <li>Floorplans and the current price list</li>
                      <li>Deposit structure, incentives and completion dates</li>
                      <li>Straight answers on GST rebates, assignments and strata fees</li>
                    </ul>
                    <p class="vip__call">Prefer to talk? <a href="tel:6049281361">Call or text 604-928-1361</a></p>
                  </div>
                  <FormStub kind="presale-vip" submit="Send me floorplans and pricing" uid={`vip${fid++}`}
                    fields={[{ label: 'Your name', type: 'text' }, { label: 'Your email', type: 'email' }, { label: 'Your phone number', type: 'tel' }, { label: 'Project (optional)', type: 'text' }]}
                    fine="Jared replies by email or phone. No newsletter sign-up." />
                </div>
              );
              if (b.t === 'form') return <FormStub labels={b.labels} submit={b.submit} fields={b.fields} title={b.title} fine={b.fine} uid={`f${fid++}`} />;
              return null;
            })}
          </div>
        </div>
      </section>
    );
  })}
  {local?.lead === 'quiz' && <SearchQuiz heading={local.lead_heading} />}
  {local?.lead === 'homevalue' && <HomeValue place={local.lead_place} />}
  <Cta />
  {explore && <ExploreLinks data={explore} />}
</main>
</Base>

<script>
  // Project cards that link to #vip-floorplans put the project name into the request form, then move focus to the name field.
  document.querySelectorAll<HTMLAnchorElement>('a[href="#vip-floorplans"]').forEach((a) => a.addEventListener('click', () => {
    const lines = [...a.querySelectorAll<HTMLElement>('.cardlink__t')].map((e) => (e.textContent || '').trim()).filter((x) => x && !/^request\b/i.test(x));
    const project = document.querySelector<HTMLInputElement>('#vip-floorplans input[name="project"]');
    if (project && lines[0]) project.value = lines[0];
    setTimeout(() => document.querySelector<HTMLInputElement>('#vip-floorplans input[name="name"]')?.focus({ preventScroll: true }), 350);
  }));
</script>

<style>
  /* VIP floorplans box: a black band with the form on a white card (copy left, form right on wide screens). */
  .vip{background:var(--ink);color:#fff;padding:clamp(1.5rem,4vw,3rem);margin:2rem 0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(1.5rem,4vw,3.5rem);align-items:center;scroll-margin-top:calc(var(--header-h,4.25rem) + 1rem)}
  .vip .h2{margin-top:0;color:#fff}
  .vip .h2::before{background:#fff}
  .vip .eyebrow{color:#fff;opacity:.8}
  .vip__copy > p{max-width:var(--measure)}
  .vip__list{list-style:none;margin:1.25rem 0;padding:0;display:grid;gap:.6rem}
  .vip__list li{position:relative;padding-left:1.6rem;line-height:1.45}
  .vip__list li::before{content:'';position:absolute;left:0;top:.5em;width:.9rem;height:2px;background:#fff}
  .vip__call{margin:1.25rem 0 0;font-size:.9375rem;opacity:.9}
  .vip__call a{color:#fff;font-weight:700;text-decoration:underline;text-underline-offset:3px}
  .vip :global(.fstub){margin:0;max-width:none;background:#fff;color:var(--ink);border:0;padding:clamp(1.25rem,3vw,2rem)}
  .vip :global(.fstub .btn){justify-self:stretch;justify-content:center;min-height:3rem}
  .vip :global(.fstub__fine){color:var(--grey)}
  @media (max-width:60rem){.vip{grid-template-columns:1fr}}
  .section--tight{padding-block:clamp(1.25rem,3vw,2rem)}
  /* Content runs the full width of the page column (same left edge as the header); only running text is held to a readable line length. */
  .pg{max-width:none;margin-inline:0;--prose:62rem}
  .pg > :where(p,ul.lines,.toc,details,.cardlink,.notice,h3,h4,h5,.pg__h,.byline){max-width:var(--prose)}
  .pg > :where(p,ul.lines){font-size:1.125rem;line-height:1.7}
  .pg--wide{max-width:none}
  .pg--search{max-width:none}
  .pg--search .pg__h1,.pg--search .pg__h1.caps{font-size:clamp(1.75rem,3.4vw,2.5rem);max-width:none;margin-bottom:.75rem}
  .pg--search p{max-width:56rem;margin-bottom:0}
  .section--search{padding-bottom:0}
  .pg :global(p){margin:0 0 1em}
  .pg__h1{font-size:clamp(2rem,4.6vw,3.5rem);line-height:1.05;letter-spacing:-.025em;margin:0 0 1.25rem;text-wrap:balance;max-width:40ch}
  .pg__h1.caps{max-width:48ch}
  .pg--hub .pg__h1,.pg--hub .pg__h1.caps{font-size:clamp(1.75rem,3.2vw,2.5rem);max-width:none;margin-bottom:1rem}
  .toc{margin:0 0 var(--s5);border:1px solid var(--ink);background:#fff}
  .toc summary{cursor:pointer;font:700 .9375rem var(--f-head);min-height:2.75rem;display:flex;align-items:center;padding:0 .85rem}
  .toc ul{margin:0;padding:.25rem .85rem .85rem 2rem;columns:2 16rem;column-gap:var(--s6)}
  .toc li{break-inside:avoid;padding:.2rem 0}
  .toc a{display:inline-block;min-height:1.5rem}
  .pg__h{font-size:1.25rem;margin:2rem 0 .75rem}
  .pg p,.pg li,.pg a{overflow-wrap:anywhere}
  .byline{font:600 .8125rem var(--f-head);letter-spacing:.04em}
  .pg .h2,.pg .h2.caps{margin-top:0;margin-bottom:var(--s5)}
  .pg .h2::before{content:'';display:block;width:2.5rem;height:3px;background:var(--ink);margin-bottom:.9rem}
  .pg__h{font-size:1.125rem;margin:1.75rem 0 .6rem;letter-spacing:-.01em}
  .pg .pg__label{font:700 .75rem/1.3 var(--f-head);letter-spacing:.14em;text-transform:uppercase;color:var(--grey);margin:1.75rem 0 .5rem}
  /* Two-column text sections: the heading stays left while you read, the text runs on the right. */
  @media (min-width:64rem){
    .pg--split{display:grid;grid-template-columns:minmax(14rem,20rem) minmax(0,1fr);column-gap:clamp(2.5rem,6vw,5rem);align-items:start}
