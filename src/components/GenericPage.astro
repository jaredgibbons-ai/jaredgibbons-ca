---
// Archive-driven page body: renders one imported page/post JSON (tools/import_pages.py).
// Generic archive-driven page. Content comes from src/data/pages/<slug>.json, produced by
// tools/import_pages.py from the folder-09 page records. Bespoke pages (index, fort-langley,
// reviews) are explicit files and take precedence over this route.
import Base from '../layouts/Base.astro';
import Rich from './Rich.astro';
import Cta from './Cta.astro';
import ReviewCards from './ReviewCards.astro';
import FormStub from './FormStub.astro';
import NetProceedsCalc from './NetProceedsCalc.astro';
import { isGated } from '../lib/inventory';
import { pickReviews } from '../lib/reviews';
import REVIEW_EXCERPTS from '../data/review-excerpts.json';

const { page } = Astro.props as { page: any };
const seo = page.seo || {};

// Local-knowledge layer (src/data/local/<slug>.json): original sourced sections inserted before the first
// level-2 heading, plus FAQ + breadcrumb structured data. Only used where present; archive blocks are untouched.
const LOCAL = import.meta.glob('../data/local/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const local = LOCAL[`../data/local/${page.slug}.json`];
let endCount = 0;
const origin = 'https://jaredgibbons.ca';
const jsonld: any[] = [];
if (local?.faq?.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: local.faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
if (local?.breadcrumbs?.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: local.breadcrumbs.map((c: any, i: number) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: origin + c.href })) });
if (local) {
  // `hide`: archive paragraphs/headings (matched by their opening words) that move to another page; the archive record is untouched.
  if (local.hide?.length) page.blocks = page.blocks.filter((b: any) => { const tx = b.text ?? b.parts?.map((x: any) => x.t).join('') ?? ''; return !((b.t === 'p' || b.t === 'h') && local.hide.some((x: string) => tx.startsWith(x))); });
  // `suppress`: level-2 headings whose whole section is replaced by the local layer (duplicated sibling-page text).
  if (local.suppress?.length) {
    let drop = false;
    page.blocks = page.blocks.filter((b: any) => { if (b.t === 'h' && b.level <= 2) drop = b.level === 2 && local.suppress.includes(b.text); return !drop || b.t === 'reviews' || b.t === 'grid' || b.t === 'form'; });
  }
  const at = page.blocks.findIndex((b: any) => b.t === 'h' && b.level === 2);
  const faqBlocks = (local.faq ?? []).length ? [{ t: 'h', level: 2, text: local.faq_heading || 'Common questions' }, ...local.faq.flatMap((f: any) => [{ t: 'h', level: 3, text: f.q }, { t: 'p', parts: [{ t: f.a }] }])] : [];
  const cut = at < 0 ? page.blocks.length : at;
  const asPart = (b: any) => b.t === 'p' && !b.parts ? { t: 'p', parts: [{ t: b.text, ...(b.h ? { h: b.h } : {}) }] } : b;
  // pos:'end' blocks (related-link lists) go after the archive content, so the top of the page stays as it was.
  const endBlocks = local.blocks.filter((b: any) => b.pos === 'end').map(asPart);
  endCount = endBlocks.length;
  page.blocks = [...page.blocks.slice(0, cut), ...local.blocks.filter((b: any) => b.pos !== 'end').map(asPart), ...faqBlocks, ...page.blocks.slice(cut), ...endBlocks];
}

// Contact fix (D-73): 148 archive pages print jared@jaredgibbons.ca, which is not Jared's address; shown as jaredgibbons@royallepage.ca. The archive record is untouched.
page.blocks = JSON.parse(JSON.stringify(page.blocks).replaceAll('jared@jaredgibbons.ca', 'jaredgibbons@royallepage.ca'));

// Every content page shows three Google review excerpts (assigned per page in src/data/review-assign.json, no two pages share the same three).
// Archive pages that had no review block, and pages built from the local layer alone, get one, placed before the end-of-page link lists.
const NO_REVIEWS = new Set(['404', 'privacy', 'subscribe-to-our-newsletter', 'contact', 'reviews', 'data-and-methodology']);
if (!NO_REVIEWS.has(page.slug) && !page.blocks.some((b: any) => b.t === 'reviews')) page.blocks.splice(page.blocks.length - endCount, 0, { t: 'reviews', heading: REVIEW_EXCERPTS.heading, intro: REVIEW_EXCERPTS.intro, items: REVIEW_EXCERPTS.items });

// Split into render sections at each level-2 heading; reviews and grid get their own sections.
type Sec = { kind: 'text' | 'reviews' | 'grid'; blocks: any[]; block?: any };
const sections: Sec[] = [];
let cur: Sec = { kind: 'text', blocks: [] };
const push = () => { if (cur.blocks.length) sections.push(cur); cur = { kind: 'text', blocks: [] }; };
for (const b of page.blocks) {
  if (b.t === 'reviews') { push(); sections.push({ kind: 'reviews', blocks: [], block: b }); continue; }
  if (b.t === 'grid') { push(); sections.push({ kind: 'grid', blocks: [] }); continue; }
  if (b.t === 'h' && b.level === 2) push();
  cur.blocks.push(b);
}
push();
const linkOnly = (items: any[]) => items.every((it) => it.length === 1 && it[0].h);
let fid = 0;
---
<Base
  title={page.title}
  canonical={page.canonical}
  description={seo['Meta description'] || undefined}
  ogTitle={seo['OG title'] || undefined}
  ogDescription={seo['OG description'] || undefined}
  ogImage={seo['OG image'] || undefined}
  jsonld={jsonld}
  robots={isGated(page.slug) ? 'noindex, follow' : (seo['Meta robots'] || 'index, follow')}
  footerTagline="South Surrey Realtor | Homes for Sale, Condos & MLS Listings"
  footerCell={true}
  brandHref="/index.html"
>
<main id="main">
  {sections.map((sec, si) => {
    if (sec.kind === 'reviews') return <ReviewCards heading={sec.block.heading} intro={sec.block.intro} items={pickReviews(page.slug, REVIEW_EXCERPTS.items)} id={`reviews-${si}`} />;
    if (sec.kind === 'grid') return (
      <section class="section section--cream section--tight" aria-label="Listings">
        <div class="wrap">
          <p class="notice">Live MLS® listings for this search are not connected in the preview. <a href="/recip.html">Search Listings</a></p>
        </div>
      </section>
    );
    return (
      <section class:list={['section', { 'section--cream': si % 2 === 1, 'section--tight': !sec.blocks.some((x) => x.t === 'h') && sec.blocks.length <= 3 }]}>
        <div class="wrap">
          <div class="pg">
            {sec.blocks.map((b) => {
              if (b.t === 'h') {
                const Tag = `h${Math.min(b.level, 5)}`;
                return <Tag id={b.id} class={b.level === 1 ? 'pg__h1' : b.level === 2 ? 'h2' : 'pg__h'}>{b.href ? <Rich parts={[{ t: b.text, h: b.href }]} /> : b.text}</Tag>;
              }
              if (b.t === 'p') return <p class={b.cls}><Rich parts={b.parts} /></p>;
              if (b.t === 'list') return (
                <ul class:list={['lines', { 'lines--links': linkOnly(b.items) }]}>
                  {b.items.map((it: any) => <li><Rich parts={it} /></li>)}
                </ul>
              );
              if (b.t === 'card') return (
                <a class="cardlink" href={b.href.replace(/^https:\/\/jaredgibbons\.ca(?=\/|$)/, '') || '/'}>
                  {b.lines.map((l: any, k: number) => {
                    if (l.level) { const T = `h${Math.min(l.level, 5)}`; return <T class="cardlink__h">{l.text}</T>; }
                    return <span class={k === 0 ? 'cardlink__h' : 'cardlink__t'}>{l.text}</span>;
                  })}
                </a>
              );
              if (b.t === 'notice') return <p class="notice">{b.text}</p>;
              if (b.t === 'table') return (
                <div class="tblwrap" tabindex="0" role="region" aria-label={b.caption}>
                  <table class="tbl"><caption>{b.caption}</caption>
                    <thead><tr>{b.head.map((h: string) => <th scope="col">{h}</th>)}</tr></thead>
                    <tbody>{b.rows.map((r: string[]) => <tr>{r.map((c, ci) => ci === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
                  </table>
                  {b.source && <p class="tbl__src">{b.source} {/^Source:/.test(b.source) && page.slug !== 'data-and-methodology' && <a href="/data-and-methodology.html">How these figures are defined and sourced</a>}</p>}
                </div>
              );
              if (b.t === 'calc') return <NetProceedsCalc />;
              if (b.t === 'form') return <FormStub labels={b.labels} submit={b.submit} uid={`f${fid++}`} />;
              return null;
            })}
          </div>
        </div>
      </section>
    );
  })}
  <Cta />
</main>
</Base>

<style>
  .section--tight{padding-block:clamp(1.25rem,3vw,2rem)}
  .pg{max-width:var(--measure)}
  .pg :global(p){margin:0 0 1em}
  .pg__h1{font-size:clamp(2rem,4.6vw,3.5rem);line-height:1.05;letter-spacing:-.025em;margin:0 0 1.25rem;text-wrap:balance;max-width:24ch}
  .pg__h{font-size:1.25rem;margin:2rem 0 .75rem}
  .pg p,.pg li,.pg a{overflow-wrap:anywhere}
  .byline{font:600 .8125rem var(--f-head);letter-spacing:.04em}
  .pg .h2{margin-top:0}
  .lines{list-style:none;margin:0 0 1.25em;padding:0;border-top:1px solid var(--ink)}
  .lines li{padding:.55rem 0;border-bottom:1px solid var(--rule)}
  .lines--links{columns:2 16rem;column-gap:var(--s6)}
  .lines--links li{break-inside:avoid}
  .pg:has(.lines--links){max-width:none}
  .tblwrap{overflow-x:auto;border:1px solid var(--ink);background:#fff;margin:0 0 1.25rem}
  .tbl{border-collapse:collapse;width:100%;font-size:.9375rem}
  .tbl caption{text-align:left;font:700 .8125rem var(--f-head);padding:.6rem .85rem;border-bottom:1px solid var(--ink)}
  .tbl th,.tbl td{text-align:left;padding:.5rem .85rem;border-bottom:1px solid var(--rule)}
  .tbl thead th{font:700 .75rem var(--f-head);text-transform:uppercase;letter-spacing:.05em}
  .tbl__src{font-size:.8125rem;margin:0;padding:.5rem .85rem}
  .cardlink{display:grid;gap:.35rem;border:1px solid var(--ink);background:#fff;padding:1.1rem 1.25rem;margin:0 0 var(--s4);text-decoration:none}
  .cardlink:hover,.cardlink:focus-visible{background:var(--ink);color:#fff}
  .cardlink__h{font:700 1.0625rem/1.3 var(--f-head);margin:0}
  .cardlink__t{font-size:.9375rem}
</style>
