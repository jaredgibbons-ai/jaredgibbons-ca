---
// "Where Jared has sold" on the sell pages (D-292). Street names only, from his own deal records (src/data/sold-streets.js):
// no house numbers, no counts (Jared: "let's not use them per area but yes saying I sold in the area or building, or street").
import S from '../data/sold-streets.js';
const { slug } = Astro.props as { slug: string };
const PAGES: Record<string, string[]> = {
  'sell-my-house-in-langley': ['Langley'],
  'sell-my-house-in-surrey': ['Surrey', 'South Surrey'],
  'sell-my-house-in-south-surrey-white-rock': ['South Surrey', 'White Rock'],
};
const areas = (PAGES[slug] || []).map((a) => ({ a, streets: ((S as any).areas[a] || []) as string[], buildings: ((S as any).buildings as any[]).filter((b) => b.area === a && b.side.includes('S') && !/Commerce Centre|Business Centre|Plaza|Shopping Centre|Trailer Park/i.test(b.name)).map((b) => b.name as string) })).filter((x) => x.streets.length);
const list = (xs: string[]) => xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}` : xs[0];
---
{areas.length > 0 && (
<section class="section section--tight sp" aria-labelledby="sp-h">
  <div class="wrap">
    <h2 class="h2" id="sp-h">Where Jared has sold in {list(areas.map((x) => x.a))}</h2>
    <p class="sp__lead">Jared has sold homes on these streets since 2017 (closed MLS® sales). If yours is one of them, he already knows what buyers there pay for.</p>
    {areas.map((x) => (
      <div class="sp__area">
        {areas.length > 1 && <h3 class="sp__h">{x.a}</h3>}
        <p class="sp__streets">{x.streets.join(' · ')}</p>
        {x.buildings.length > 0 && <p class="sp__bld"><strong>Buildings and complexes:</strong>{' '}{x.buildings.join(', ')}.</p>}
      </div>
    ))}
    <p class="sp__cta"><a class="btn" href="/home-evaluation.html">What is my home worth?</a> <a class="btn btn--ghost" href="tel:+16049281361">Call or text 604-928-1361</a></p>
  </div>
  <style is:inline>
    .sp__lead{max-width:44rem;line-height:1.6;margin:0 0 var(--s4)}
    .sp__h{font-size:1.125rem;margin:var(--s4) 0 .5rem}
    .sp__streets{margin:0 0 .75rem;line-height:1.9;max-width:64rem}
    .sp__bld{margin:0 0 .75rem;line-height:1.6;max-width:64rem}
    .sp__cta{display:flex;flex-wrap:wrap;gap:.5rem;margin:var(--s4) 0 0}
  </style>
</section>
)}
