{
  // Cloudflare Workers with static assets. Confirm Workers vs Pages at setup (docs/02).
  // Not deployed: no account/token connected yet (BL-07). `run_worker_first` sends every request
  // through src/worker/index.js so archive redirects, nested paths and the real 404 apply.
  "name": "jaredgibbons-ca",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // Outbound lead email (Cloudflare Email Service). Needs a sending domain onboarded first (needs approval).
  // Secrets LEAD_EMAIL_TO, LEAD_EMAIL_FROM, TURNSTILE_SECRET are set with `wrangler secret put`, never committed.
  "send_email": [{ "name": "EMAIL" }],
  // Google reviews feed: the jg-reviews Worker (workers/reviews) holds the Google secrets; the site only reads its stored copy.
  "services": [{ "binding": "REVIEWS", "service": "jg-reviews" }],
  // Listing photos (3,338 files x 3 sizes). Upload: tools/upload_photos_r2.sh. Served by src/worker/photos.js.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "jg-listing-photos" }],
  // Fail safe: pages are noindex unless INDEXABLE is exactly "true". Set to "true" at launch, Nov 12 2026, with Jared's approval (D-241), together with PUBLIC_PREVIEW=false in .env.production.
  "vars": { "INDEXABLE": "true" },
  // No source maps in the deploy (they embed internal notes).
  "upload_source_maps": false
}
